@model WarrantyFormViewModel
@{ var editing = Model.Id != Guid.Empty; ViewData["Title"] = editing ? "Editar garantia" : "Nova garantia"; }
<link rel="stylesheet" href="~/css/data-forms.css" asp-append-version="true" />
<div class="page-header"><div><p class="eyebrow">Documentos</p><h1>@ViewData["Title"]</h1><p class="page-subtitle">Registe os dados da garantia e configure o aviso de expiração.</p></div></div>
<section class="panel"><form asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="form-stack">
<input asp-for="Id" type="hidden" /><input asp-for="ExistingDocumentFileName" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div>
<div><label asp-for="Name"></label><input asp-for="Name" /><span asp-validation-for="Name" class="field-error"></span></div>
<div><label asp-for="Supplier"></label><input asp-for="Supplier" /><span asp-validation-for="Supplier" class="field-error"></span></div>
<div class="form-grid two"><div><label asp-for="PurchaseDate"></label><input asp-for="PurchaseDate" type="date" /><span asp-validation-for="PurchaseDate" class="field-error"></span></div><div><label asp-for="ExpiryDate"></label><input asp-for="ExpiryDate" type="date" /><span asp-validation-for="ExpiryDate" class="field-error"></span></div></div>
<div><label asp-for="NoticeDays"></label><input asp-for="NoticeDays" type="number" min="0" max="3650" /><span asp-validation-for="NoticeDays" class="field-error"></span><p class="form-help">O lembrete associado é atualizado automaticamente quando alterar a garantia.</p></div>
<div><label asp-for="Notes"></label><textarea asp-for="Notes" rows="4"></textarea><span asp-validation-for="Notes" class="field-error"></span></div>
<div><label asp-for="Document"></label><input asp-for="Document" type="file" accept="application/pdf,.pdf" /><span asp-validation-for="Document" class="field-error"></span>@if(editing){<p class="form-help">Documento atual: <strong>@(Model.ExistingDocumentFileName ?? "Sem documento")</strong>. Selecione um PDF para o adicionar ou substituir.</p>}else{<p class="form-help">Opcional. Apenas PDF, até 10 MB; pode adicioná-lo mais tarde.</p>}</div>
<div class="form-actions"><button class="button" type="submit">@(editing ? "Guardar alterações" : "Criar garantia")</button><a class="button secondary" asp-action="Index">Cancelar</a></div></form></section>

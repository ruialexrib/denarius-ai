@model WarrantyFormViewModel
@{ var editing = Model.Id != Guid.Empty; ViewData["Title"] = editing ? "Editar garantia" : "Nova garantia"; }
<link rel="stylesheet" href="~/css/data-forms.css" asp-append-version="true" />
<div class="page-header"><div><p class="eyebrow">Documentos</p><h1>@ViewData["Title"]</h1><p class="page-subtitle">Registe os dados da garantia e configure o aviso de expiração.</p></div></div>
<section class="data-editor"><div class="data-editor-grid"><div class="data-editor-main"><form asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="form-stack"><input asp-for="Id" type="hidden" /><input asp-for="ExistingDocumentFileName" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div><label asp-for="Name"></label><input asp-for="Name" /><span asp-validation-for="Name" class="field-error"></span></div><div><label asp-for="Supplier"></label><input asp-for="Supplier" /><span asp-validation-for="Supplier" class="field-error"></span></div><div class="form-grid two"><div><label asp-for="PurchaseDate"></label><input asp-for="PurchaseDate" type="date" /><span asp-validation-for="PurchaseDate" class="field-error"></span></div><div><label asp-for="ExpiryDate"></label><input asp-for="ExpiryDate" type="date" /><span asp-validation-for="ExpiryDate" class="field-error"></span></div></div><div><label asp-for="NoticeDays"></label><input asp-for="NoticeDays" type="number" min="0" max="3650" /><span asp-validation-for="NoticeDays" class="field-error"></span><p class="form-help">O lembrete associado é atualizado automaticamente quando alterar a garantia.</p></div><div><label asp-for="Notes"></label><textarea asp-for="Notes" rows="4"></textarea><span asp-validation-for="Notes" class="field-error"></span></div><div><label for="Document">Documento PDF</label><label class="file-picker@(editing && Model.ExistingDocumentFileName is not null ? " has-file" : "")" for="Document" id="documentFilePicker"><span class="file-picker-icon" aria-hidden="true">+</span><span class="file-picker-copy"><strong id="documentFileTitle">@(editing && Model.ExistingDocumentFileName is not null ? Model.ExistingDocumentFileName : "Selecionar documento PDF")</strong><span id="documentFileMeta">@(editing && Model.ExistingDocumentFileName is not null ? "Documento atual · selecione outro PDF para substituir" : "Ficheiro PDF até 10 MB")</span></span><span class="file-picker-change" id="documentFileChange" @(editing && Model.ExistingDocumentFileName is not null ? "" : "hidden")>Alterar</span><input asp-for="Document" type="file" accept="application/pdf,.pdf" /></label><span asp-validation-for="Document" class="field-error"></span></div><div class="form-actions"><button class="button" type="submit">@(editing ? "Guardar alterações":"Criar garantia")</button><a class="button secondary" asp-action="Index">Cancelar</a></div></form></div><aside class="data-editor-context"><p class="eyebrow">Contexto</p><h2>Acompanhar a garantia</h2><p>As datas e a antecedência permitem ao Denarius AI alertar antes de terminar o período de garantia.</p><ul class="data-editor-context-list"><li><strong>Fornecedor</strong>Ajuda a identificar onde foi adquirido o bem ou serviço.</li><li><strong>Validade</strong>A data de compra e a expiração definem o período coberto.</li><li><strong>Aviso</strong>O lembrete associado acompanha automaticamente as alterações da garantia.</li><li><strong>Documento</strong>Pode guardar o comprovativo ou certificado em PDF.</li></ul></aside></div></section>
@section Scripts {<script>(()=>{const input=document.getElementById('Document');const picker=document.getElementById('documentFilePicker');const title=document.getElementById('documentFileTitle');const meta=document.getElementById('documentFileMeta');const change=document.getElementById('documentFileChange');const maxSize=10*1024*1024;input?.addEventListener('change',async()=>{const file=input.files?.[0];if(!file)return;title.textContent=file.name;if(!file.name.toLowerCase().endsWith('.pdf')){showInvalid('Ficheiro inválido · a extensão tem de ser .pdf');return;}if(file.size>maxSize){showInvalid(`${formatFileSize(file.size)} · excede o limite de 10 MB`);return;}let isPdf=false;try{const header=new Uint8Array(await file.slice(0,5).arrayBuffer());isPdf=header.length===5&&header[0]===0x25&&header[1]===0x50&&header[2]===0x44&&header[3]===0x46&&header[4]===0x2d;}catch{showInvalid('Não foi possível validar o ficheiro · selecione outro PDF');return;}if(!isPdf){showInvalid('Ficheiro inválido · selecione um PDF válido');return;}picker?.classList.add('has-file');meta.textContent=`${formatFileSize(file.size)} · PDF selecionado`;change.hidden=false;});function showInvalid(message){picker?.classList.remove('has-file');meta.textContent=message;change.hidden=true;}function formatFileSize(bytes){if(bytes<1024)return`${bytes} B`;if(bytes<1024*1024)return`${(bytes/1024).toFixed(1)} KB`;return`${(bytes/(1024*1024)).toFixed(1)} MB`;}})();</script>}

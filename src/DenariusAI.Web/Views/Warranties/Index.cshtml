@model WarrantyIndexViewModel
@{ ViewData["Title"] = "Garantias"; var today = DateOnly.FromDateTime(DateTime.Today); }
<link rel="stylesheet" href="~/css/documents.css" asp-append-version="true" />
<div class="page-header"><div><p class="eyebrow">Documentos</p><h1>Garantias</h1><p class="page-subtitle">Centralize comprovativos e acompanhe a validade das suas garantias.</p></div><a class="button" asp-action="Create">Nova garantia</a></div>
<section class="panel document-list-panel"><form method="get" class="filterbar document-filters"><input type="search" name="search" value="@Model.Search" placeholder="Pesquisar por designação ou fornecedor..." /><button class="button secondary" type="submit">Pesquisar</button>@if(!string.IsNullOrWhiteSpace(Model.Search)){<a class="text-link" asp-action="Index">Limpar</a>}</form><div class="table-wrap"><table class="document-table"><thead><tr><th>Garantia</th><th>Compra</th><th>Fim</th><th>Estado</th><th>Documento</th><th class="actions">Ações</th></tr></thead><tbody>
@foreach(var item in Model.Items){var expired=item.ExpiryDate<today; var near=!expired&&item.ExpiryDate<=today.AddDays(60);<tr><td><strong>@item.Name</strong><small>@(item.Supplier ?? "Fornecedor não indicado")</small></td><td class="nowrap">@item.PurchaseDate.ToString("dd/MM/yyyy")</td><td class="nowrap">@item.ExpiryDate.ToString("dd/MM/yyyy")</td><td><span class="status @(expired ? "inactive" : near ? "pending" : "active")">@(expired ? "Expirada" : near ? "A terminar" : "Ativa")</span></td><td>@if(item.DocumentFileName is not null){<a class="document-link" asp-action="Document" asp-route-id="@item.Id" target="_blank" rel="noopener">Ver PDF</a><small>@item.DocumentFileName</small>}else{<span class="status inactive">Sem documento</span>}</td><td class="actions"><a class="text-link" asp-action="Edit" asp-route-id="@item.Id">Editar</a><form asp-action="Delete" method="post" onsubmit="return confirm('Remover esta garantia e o respetivo PDF?')"><input type="hidden" name="id" value="@item.Id" /><button class="text-link danger-link" type="submit">Remover</button></form>@await Html.PartialAsync("_AuditLink", new AuditLinkViewModel("Warranty", item.Id.ToString()))</td></tr>}
@if(Model.Items.Count==0){<tr><td colspan="6" class="empty-row">Não foram encontradas garantias.</td></tr>}
</tbody></table></div></section>

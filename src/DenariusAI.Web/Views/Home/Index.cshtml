@model DashboardViewModel
@using System.Globalization
@using System.Text.Json
<link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/dashboard-charts.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/financial-enhancements.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/reminders.css" asp-append-version="true" />
@{
    ViewData["Title"] = "Dashboard";
    var dashboard = Model.Dashboard;
    var culture = CultureInfo.GetCultureInfo("pt-PT");
    var periodName = new DateTime(dashboard.Year, dashboard.Month, 1).ToString("MMMM yyyy", culture);
    var budgetProgress = Math.Clamp(dashboard.BudgetExecution ?? 0m, 0m, 100m);
    var chartData = JsonSerializer.Serialize(new
    {
        budget = dashboard.Categories.Take(8).Select(item => new
        {
            label = item.Name,
            budgeted = item.Budgeted,
            actual = item.Actual
        }),
        annual = dashboard.Evolution.Select(item => new
        {
            label = item.Label,
            axisLabel = new DateTime(item.Year, item.Month, 1).ToString("MMM", culture),
            income = item.Income,
            expenses = item.Expenses
        })
    });
}
<script src="~/js/dashboard-charts.js" asp-append-version="true" defer></script>
<script id="dashboard-chart-data" type="application/json">@Html.Raw(chartData)</script>
<div class="page-header"><div><p class="eyebrow">Visão geral</p><h1>Dashboard</h1><p class="page-subtitle">Acompanhe o desempenho financeiro, os saldos e a execução do orçamento do período.</p></div><form method="get" class="dashboard-period"><select name="year" asp-items="Model.Years" aria-label="Ano"></select><select name="month" asp-items="Model.Months" aria-label="Mês"></select><button class="button secondary" type="submit">Aplicar</button></form></div>
<section class="dashboard-kpis" aria-label="Indicadores principais">
<article class="kpi-featured"><span>Resultado do orçamento</span><strong class="@(dashboard.MonthlyResult < 0 ? "negative" : "positive")">@dashboard.MonthlyResult.ToString("N2") €</strong><small>@periodName</small></article>
<article class="kpi-balance"><span>Saldo disponível</span><strong>@dashboard.LiquidBalance.ToString("N2") €</strong><small>Contas à ordem e dinheiro</small></article>
<article><span>Rendimentos</span><strong class="positive">@dashboard.Income.ToString("N2") €</strong><small>Movimentos associados ao orçamento</small></article>
<article><span>Despesas</span><strong class="negative">@dashboard.Expenses.ToString("N2") €</strong><small>Movimentos associados ao orçamento</small></article>
</section>
@if (Model.ShowDemonstrationDataNotice)
{
<section class="demo-data-notice" role="status"><span class="demo-data-notice-icon" aria-hidden="true">i</span><div><strong>Está a consultar dados de demonstração</strong><p>Estes dados servem para explorar o DenariusAI. Quando estiver pronto, pode eliminá-los em <a asp-controller="Settings" asp-action="ResetFinancialData">Definições</a> e começar com os seus próprios dados.</p></div><form asp-action="AcknowledgeDemonstrationData" method="post"><button class="button" type="submit">Tomei conhecimento</button></form></section>
}
<section class="dashboard-welcome"><span class="dashboard-welcome-icon" aria-hidden="true">✦</span><div><p class="eyebrow">A sua visão financeira</p><h2>Bem-vindo ao DenariusAI</h2><p>@Model.WelcomeMessage</p><small>@(Model.WelcomeGeneratedByAi ? "Resumo contextual gerado por IA" : "Orientação geral do DenariusAI")</small></div></section>
<section class="dashboard-overview">
<article class="panel budget-overview">
<div class="panel-title"><div><p class="eyebrow">Orçamento mensal</p><h2>@(dashboard.BudgetExecution.HasValue ? $"{dashboard.BudgetExecution:N1}% executado" : "Sem orçamento definido")</h2></div><a class="text-link" asp-controller="Budget" asp-action="Index" asp-route-year="@dashboard.Year" asp-route-month="@dashboard.Month">Ver orçamento</a></div>
<div class="budget-progress" role="progressbar" aria-valuenow="@budgetProgress" aria-valuemin="0" aria-valuemax="100"><i style="width:@budgetProgress.ToString(CultureInfo.InvariantCulture)%"></i></div>
<div class="overview-metrics"><span>Orçamentado<strong>@dashboard.Budgeted.ToString("N2") €</strong></span><span>Realizado<strong>@dashboard.BudgetActual.ToString("N2") €</strong></span><span>Disponível<strong class="@(dashboard.BudgetAvailable < 0 ? "negative" : "positive")">@dashboard.BudgetAvailable.ToString("N2") €</strong></span></div>
</article>
<article class="panel wealth-overview">
<div class="panel-title"><div><p class="eyebrow">Património</p><h2>@dashboard.TotalAssets.ToString("N2") €</h2></div><a class="text-link" asp-controller="SavingsCertificates" asp-action="Index">Ver poupanças</a></div>
<div class="wealth-details"><span>Poupança e investimentos<strong>@dashboard.SavingsAndInvestments.ToString("N2") €</strong></span><span>Certificados de Aforro<strong>@dashboard.SavingsCertificatesValue.ToString("N2") €</strong><small>+@dashboard.SavingsCertificatesYield.ToString("N2") € acumulados</small></span><span>Próximo juro líquido<strong class="positive">@dashboard.SavingsCertificatesFutureNetInterest.ToString("N2") €</strong></span></div>
</article>
</section>
<a class="dashboard-action" asp-controller="Reconciliation" asp-action="Index"><span><b>@dashboard.UnreconciledMovements</b> movimentos por reconciliar</span><span>Rever agora →</span></a>
<section class="dashboard-grid">
<article class="panel dashboard-chart">
<div class="panel-title"><div><p class="eyebrow">Orçamento</p><h2>Orçamentado vs. realizado</h2></div><a class="text-link" asp-controller="Budget" asp-action="Index" asp-route-year="@dashboard.Year" asp-route-month="@dashboard.Month">Consultar</a></div>
@if (dashboard.Categories.Count == 0)
{
    <p class="dashboard-empty">Ainda não existem valores para este orçamento.</p>
}
else
{
    <div class="dashboard-line-chart" data-dashboard-chart="budget" role="img" aria-label="Gráfico do orçamento e valor realizado por categoria">
        <div class="dashboard-chart-stage">
            <svg viewBox="0 0 900 280" preserveAspectRatio="none" aria-hidden="true">
                <line class="dashboard-chart-grid-line" x1="28" y1="30" x2="872" y2="30"></line>
                <line class="dashboard-chart-grid-line" x1="28" y1="133" x2="872" y2="133"></line>
                <line class="dashboard-chart-grid-line" x1="28" y1="236" x2="872" y2="236"></line>
                <polyline class="dashboard-chart-series budgeted-series" data-chart-series="budgeted" points=""></polyline>
                <polyline class="dashboard-chart-series actual-series" data-chart-series="actual" points=""></polyline>
            </svg>
        </div>
        <div class="dashboard-chart-axis" data-chart-axis></div>
        <div class="chart-legend dashboard-line-legend"><span class="budgeted">Orçamentado</span><span class="actual">Realizado</span></div>
    </div>
}
</article>
<article class="panel dashboard-chart dashboard-annual-chart">
<div class="panel-title"><div><p class="eyebrow">Comparação anual por orçamento</p><h2>Rendimentos vs. despesas</h2></div><span class="muted">Ano @dashboard.Year</span></div>
<div class="dashboard-line-chart" data-dashboard-chart="annual" role="img" aria-label="Gráfico anual de rendimentos e despesas">
    <div class="dashboard-chart-stage">
        <svg viewBox="0 0 900 280" preserveAspectRatio="none" aria-hidden="true">
            <line class="dashboard-chart-grid-line" x1="28" y1="30" x2="872" y2="30"></line>
            <line class="dashboard-chart-grid-line" x1="28" y1="133" x2="872" y2="133"></line>
            <line class="dashboard-chart-grid-line" x1="28" y1="236" x2="872" y2="236"></line>
            <polyline class="dashboard-chart-series income-series" data-chart-series="income" points=""></polyline>
            <polyline class="dashboard-chart-series expenses-series" data-chart-series="expenses" points=""></polyline>
        </svg>
    </div>
    <div class="dashboard-chart-axis dashboard-chart-axis-months" data-chart-axis></div>
    <div class="chart-legend dashboard-line-legend"><span class="income">Rendimentos</span><span class="expenses">Despesas</span></div>
</div>
</article>
</section>

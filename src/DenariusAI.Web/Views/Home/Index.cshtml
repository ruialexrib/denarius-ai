@model DashboardViewModel
@using System.Globalization
<link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/financial-enhancements.css" asp-append-version="true" />
@{ ViewData["Title"] = "Dashboard"; var dashboard = Model.Dashboard; var culture = CultureInfo.GetCultureInfo("pt-PT"); var periodName = new DateTime(dashboard.Year, dashboard.Month, 1).ToString("MMMM yyyy", culture); var categoryMax = Math.Max(dashboard.Categories.Select(item => Math.Max(item.Actual, item.Budgeted)).DefaultIfEmpty(0m).Max(), 1m); var evolutionMax = Math.Max(dashboard.Evolution.Select(item => Math.Max(item.Income, item.Expenses)).DefaultIfEmpty(0m).Max(), 1m); var budgetProgress = Math.Clamp(dashboard.BudgetExecution ?? 0m, 0m, 100m); }
<div class="page-header"><div><p class="eyebrow">Visão geral</p><h1>Dashboard</h1><p class="page-subtitle">Acompanhe o desempenho financeiro, os saldos e a execução do orçamento do período.</p></div><form method="get" class="dashboard-period"><select name="year" asp-items="Model.Years" aria-label="Ano"></select><select name="month" asp-items="Model.Months" aria-label="Mês"></select><button class="button secondary" type="submit">Aplicar</button></form></div>
<section class="dashboard-kpis" aria-label="Indicadores principais">
<article class="kpi-featured"><span>Resultado do mês</span><strong class="@(dashboard.MonthlyResult < 0 ? "negative" : "positive")">@dashboard.MonthlyResult.ToString("N2") €</strong><small>@periodName</small></article>
<article><span>Saldo disponível</span><strong>@dashboard.LiquidBalance.ToString("N2") €</strong><small>Contas à ordem e dinheiro</small></article>
<article><span>Rendimentos</span><strong class="positive">@dashboard.Income.ToString("N2") €</strong><small>Entradas no período</small></article>
<article><span>Despesas</span><strong class="negative">@dashboard.Expenses.ToString("N2") €</strong><small>Saídas no período</small></article>
</section>
<section class="dashboard-overview">
<article class="panel budget-overview">
<div class="panel-title"><div><p class="eyebrow">Orçamento mensal</p><h2>@(dashboard.BudgetExecution.HasValue ? $"{dashboard.BudgetExecution:N1}% executado" : "Sem orçamento definido")</h2></div><a class="text-link" asp-controller="Budget" asp-action="Index" asp-route-year="@dashboard.Year" asp-route-month="@dashboard.Month">Ver orçamento</a></div>
<div class="budget-progress" role="progressbar" aria-valuenow="@budgetProgress" aria-valuemin="0" aria-valuemax="100"><i style="width:@budgetProgress.ToString(CultureInfo.InvariantCulture)%"></i></div>
<div class="overview-metrics"><span>Orçamentado<strong>@dashboard.Budgeted.ToString("N2") €</strong></span><span>Realizado<strong>@dashboard.BudgetActual.ToString("N2") €</strong></span><span>Disponível<strong class="@(dashboard.BudgetAvailable < 0 ? "negative" : "positive")">@dashboard.BudgetAvailable.ToString("N2") €</strong></span></div>
</article>
<article class="panel wealth-overview">
<div class="panel-title"><div><p class="eyebrow">Património</p><h2>@dashboard.TotalAssets.ToString("N2") €</h2></div><a class="text-link" asp-controller="SavingsCertificates" asp-action="Index">Ver poupanças</a></div>
<div class="wealth-details"><span>Poupança e investimentos<strong>@dashboard.SavingsAndInvestments.ToString("N2") €</strong></span><span>Certificados de Aforro<strong>@dashboard.SavingsCertificatesValue.ToString("N2") €</strong><small>+@dashboard.SavingsCertificatesYield.ToString("N2") € acumulados</small></span><span>Próximo juro líquido<strong class="positive">@dashboard.SavingsCertificatesFutureNetInterest.ToString("N2") €</strong></span></div>
</article>
</section>
<a class="dashboard-action" asp-controller="Reconciliation" asp-action="Index"><span><b>@dashboard.UnreconciledMovements</b> movimentos por reconciliar</span><span>Rever agora →</span></a>
<section class="dashboard-grid"><article class="panel dashboard-chart"><div class="panel-title"><div><p class="eyebrow">Orçamento</p><h2>Orçamentado vs. realizado</h2></div><a class="text-link" asp-controller="Budget" asp-action="Index" asp-route-year="@dashboard.Year" asp-route-month="@dashboard.Month">Consultar</a></div>
@if (dashboard.Categories.Count == 0) { <p class="dashboard-empty">Ainda não existem valores para este orçamento.</p> } else { <div class="category-bars">@foreach (var item in dashboard.Categories.Take(8)) { <div class="bar-row"><div><strong><partial name="_CategoryKindIcon" model="DenariusAI.Domain.Enums.FinancialGroupKind.Expense" /> @item.Name</strong><small>@item.Actual.ToString("N2") € de @item.Budgeted.ToString("N2") €</small></div><div class="bar-track"><i style="width:@((item.Budgeted / categoryMax * 100m).ToString(CultureInfo.InvariantCulture))%"></i><b style="width:@((Math.Max(item.Actual, 0m) / categoryMax * 100m).ToString(CultureInfo.InvariantCulture))%"></b></div></div> }</div><div class="chart-legend"><span class="budgeted">Orçamentado</span><span class="actual">Realizado</span></div> }</article>
<article class="panel dashboard-chart"><div class="panel-title"><div><p class="eyebrow">Comparação anual</p><h2>Rendimentos vs. despesas</h2></div><span class="muted">Ano @dashboard.Year</span></div>
<div class="monthly-chart">@foreach (var item in dashboard.Evolution) { <div class="month-column"><div class="month-bars"><span class="chart-bar"><em>@item.Income.ToString("N0") €</em><i title="@item.Label · Rendimentos: @item.Income.ToString("N2") €" style="height:@((item.Income / evolutionMax * 100m).ToString(CultureInfo.InvariantCulture))%"></i></span><span class="chart-bar"><em>@item.Expenses.ToString("N0") €</em><b title="@item.Label · Despesas: @item.Expenses.ToString("N2") €" style="height:@((item.Expenses / evolutionMax * 100m).ToString(CultureInfo.InvariantCulture))%"></b></span></div><small>@(new DateTime(item.Year, item.Month, 1).ToString("MMM", culture))</small></div> }</div>
<div class="chart-legend"><span class="income">Rendimentos</span><span class="expenses">Despesas</span></div></article>
</section>

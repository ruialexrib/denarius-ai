@model DashboardViewModel
@using System.Globalization
<link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/financial-enhancements.css" asp-append-version="true" />
@{ ViewData["Title"] = "Dashboard"; var dashboard = Model.Dashboard; var culture = CultureInfo.GetCultureInfo("pt-PT"); var periodName = new DateTime(dashboard.Year, dashboard.Month, 1).ToString("MMMM yyyy", culture); var categoryMax = Math.Max(dashboard.Categories.Select(item => Math.Max(item.Actual, item.Budgeted)).DefaultIfEmpty(0m).Max(), 1m); var evolutionMax = Math.Max(dashboard.Evolution.Select(item => Math.Max(item.Income, item.Expenses)).DefaultIfEmpty(0m).Max(), 1m); }
<div class="page-header"><div><p class="eyebrow">Visão geral</p><h1>Dashboard</h1><p class="page-subtitle">Acompanhe o desempenho financeiro, os saldos e a execução do orçamento do período.</p></div><form method="get" class="dashboard-period"><select name="year" asp-items="Model.Years" aria-label="Ano"></select><select name="month" asp-items="Model.Months" aria-label="Mês"></select><button class="button secondary" type="submit">Aplicar</button></form></div>
<section class="dashboard-kpis">
<article><span>Saldo disponível</span><strong>@dashboard.LiquidBalance.ToString("N2") €</strong><small>Contas à ordem e dinheiro</small></article><article><span>Poupança e investimentos</span><strong>@dashboard.SavingsAndInvestments.ToString("N2") €</strong><small>Inclui Certificados de Aforro</small></article><article><span>Património financeiro</span><strong>@dashboard.TotalAssets.ToString("N2") €</strong><small>Total de ativos financeiros</small></article><article><span>Resultado do mês</span><strong class="@(dashboard.MonthlyResult < 0 ? "negative" : "positive")">@dashboard.MonthlyResult.ToString("N2") €</strong><small>@periodName</small></article>
<article><span>Rendimentos</span><strong class="positive">@dashboard.Income.ToString("N2") €</strong><small>@periodName</small></article><article><span>Despesas</span><strong class="negative">@dashboard.Expenses.ToString("N2") €</strong><small>@periodName</small></article><article><span>Disponível no orçamento</span><strong class="@(dashboard.BudgetAvailable < 0 ? "negative" : "positive")">@dashboard.BudgetAvailable.ToString("N2") €</strong><small>@(dashboard.BudgetExecution.HasValue ? $"Execução: {dashboard.BudgetExecution:N1}%" : "Sem orçamento definido")</small></article><article><span>Por reconciliar</span><strong>@dashboard.UnreconciledMovements</strong><small>Movimentos bancários</small></article>
</section>
<section class="dashboard-certificate-kpis" aria-label="Resumo dos Certificados de Aforro">
<article><span>Certificados · valor atual</span><strong>@dashboard.SavingsCertificatesValue.ToString("N2") €</strong><small>Rendimento acumulado: @dashboard.SavingsCertificatesYield.ToString("N2") €</small></article>
<article><span>Certificados vencidos</span><strong>@dashboard.MaturedSavingsCertificatesValue.ToString("N2") €</strong><small>@dashboard.MaturedSavingsCertificates certificado(s) com capitalização atingida</small></article>
<article><span>Certificados · juro futuro</span><strong class="positive">@dashboard.SavingsCertificatesFutureNetInterest.ToString("N2") €</strong><small>Juro líquido projetado</small></article>
<article><span>Certificados · valor futuro</span><strong>@dashboard.SavingsCertificatesFutureValue.ToString("N2") €</strong><small>Valor atual acrescido do próximo juro</small></article>
</section>
<section class="panel dashboard-summary"><div class="panel-title"><div><p class="eyebrow">Execução</p><h2>Resumo do orçamento</h2></div></div><div><span>Orçamentado<strong>@dashboard.Budgeted.ToString("N2") €</strong></span><span>Realizado<strong>@dashboard.BudgetActual.ToString("N2") €</strong></span><span>Disponível<strong class="@(dashboard.BudgetAvailable < 0 ? "negative" : "positive")">@dashboard.BudgetAvailable.ToString("N2") €</strong></span><span>Execução<strong>@(dashboard.BudgetExecution.HasValue ? $"{dashboard.BudgetExecution:N1}%" : "—")</strong></span></div></section>
<section class="dashboard-grid"><article class="panel dashboard-chart"><div class="panel-title"><div><p class="eyebrow">Orçamento</p><h2>Orçamentado vs. realizado</h2></div><a class="text-link" asp-controller="Budget" asp-action="Index" asp-route-year="@dashboard.Year" asp-route-month="@dashboard.Month">Consultar</a></div>
@if (dashboard.Categories.Count == 0) { <p class="dashboard-empty">Ainda não existem valores para este orçamento.</p> } else { <div class="category-bars">@foreach (var item in dashboard.Categories.Take(8)) { <div class="bar-row"><div><strong>@item.Name</strong><small>@item.Actual.ToString("N2") € de @item.Budgeted.ToString("N2") €</small></div><div class="bar-track"><i style="width:@((item.Budgeted / categoryMax * 100m).ToString(CultureInfo.InvariantCulture))%"></i><b style="width:@((Math.Max(item.Actual, 0m) / categoryMax * 100m).ToString(CultureInfo.InvariantCulture))%"></b></div></div> }</div><div class="chart-legend"><span class="budgeted">Orçamentado</span><span class="actual">Realizado</span></div> }</article>
<article class="panel dashboard-chart"><div class="panel-title"><div><p class="eyebrow">Tendência</p><h2>Rendimentos vs. despesas</h2></div><span class="muted">Últimos 6 meses</span></div><div class="monthly-chart">@foreach (var item in dashboard.Evolution) { <div class="month-column"><div class="month-bars"><span class="chart-bar"><em>@item.Income.ToString("N0") €</em><i title="Rendimentos: @item.Income.ToString("N2") €" style="height:@((item.Income / evolutionMax * 100m).ToString(CultureInfo.InvariantCulture))%"></i></span><span class="chart-bar"><em>@item.Expenses.ToString("N0") €</em><b title="Despesas: @item.Expenses.ToString("N2") €" style="height:@((item.Expenses / evolutionMax * 100m).ToString(CultureInfo.InvariantCulture))%"></b></span></div><small>@item.Label</small></div> }</div><div class="chart-legend"><span class="income">Rendimentos</span><span class="expenses">Despesas</span></div></article></section>

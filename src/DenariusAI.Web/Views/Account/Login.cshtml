@model LoginViewModel
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Iniciar sessão"; }
<div class="auth-card"><p class="eyebrow">Bem-vindo</p><h2>Iniciar sessão</h2><p class="muted">Utilize as credenciais fornecidas pelo administrador.</p><form asp-action="Login" method="post" class="form-stack"><input asp-for="ReturnUrl" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><label asp-for="Email"></label><input asp-for="Email" autocomplete="username" autofocus /><span asp-validation-for="Email" class="field-error"></span><label asp-for="Password"></label><input asp-for="Password" autocomplete="current-password" /><span asp-validation-for="Password" class="field-error"></span><label class="check-row"><input asp-for="RememberMe" /> Manter sessão iniciada</label><button class="button" type="submit">Entrar</button></form></div>

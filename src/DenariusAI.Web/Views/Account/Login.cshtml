@model LoginViewModel
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Iniciar sessão"; }
<div class="auth-card">
    <p class="eyebrow">Bem-vindo</p>
    <h2>Iniciar sessão</h2>
    <p class="muted">Utilize uma conta previamente criada pelo administrador.</p>
    @if (Model.DemoModeEnabled)
    {
        <aside class="demo-login-notice" role="note">
            <strong>Instalação de demonstração</strong>
            @if (!string.IsNullOrWhiteSpace(Model.DemoEmail) && !string.IsNullOrWhiteSpace(Model.DemoPassword))
            {
                <p>Utilize estas credenciais para explorar o DenariusAI:</p>
                <dl><div><dt>Email</dt><dd><code>@Model.DemoEmail</code></dd></div><div><dt>Palavra-passe</dt><dd><code>@Model.DemoPassword</code></dd></div></dl>
            }
            else
            {
                <p>Esta instalação está em modo de demonstração. As credenciais públicas ainda não foram configuradas.</p>
            }
        </aside>
    }
    <form asp-action="Login" method="post" class="form-stack">
        <input asp-for="ReturnUrl" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <label asp-for="Email"></label><input asp-for="Email" autocomplete="username" autofocus /><span asp-validation-for="Email" class="field-error"></span>
        <label asp-for="Password"></label><input asp-for="Password" autocomplete="current-password" /><span asp-validation-for="Password" class="field-error"></span>
        <label class="check-row"><input asp-for="RememberMe" /> Manter sessão iniciada</label>
        <button class="button" type="submit">Entrar</button>
    </form>
    @if(Model.GoogleEnabled){<div class="auth-divider"><span>ou</span></div><form asp-action="ExternalLogin" method="post"><input type="hidden" name="provider" value="Google" /><input type="hidden" name="returnUrl" value="@Model.ReturnUrl" /><button class="button google-button" type="submit"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M21.6 12.2c0-.7-.1-1.4-.2-2H12v3.9h5.4a4.6 4.6 0 0 1-2 3v2.5h3.3c1.9-1.8 2.9-4.4 2.9-7.4Z"/><path fill="#34A853" d="M12 22c2.7 0 5-.9 6.7-2.4l-3.3-2.5c-.9.6-2.1 1-3.4 1a5.9 5.9 0 0 1-5.5-4.1H3.1v2.6A10 10 0 0 0 12 22Z"/><path fill="#FBBC05" d="M6.5 14a6 6 0 0 1 0-3.9V7.5H3.1a10 10 0 0 0 0 9.1L6.5 14Z"/><path fill="#EA4335" d="M12 6a5.4 5.4 0 0 1 3.8 1.5l2.9-2.8A9.7 9.7 0 0 0 3.1 7.5l3.4 2.6A5.9 5.9 0 0 1 12 6Z"/></svg>Continuar com Google</button></form><p class="external-login-help">O email Google tem de coincidir com o email registado pelo administrador.</p>}
</div>

@model ProfileViewModel
@{ ViewData["Title"] = "Preferências"; var lisbonTime = TimeZoneInfo.FindSystemTimeZoneById("Europe/Lisbon"); }
<div class="page-header settings-header"><div><p class="eyebrow">Conta pessoal</p><h1>Preferências</h1><p>Informação associada apenas ao utilizador autenticado.</p></div><span class="pill">Âmbito pessoal</span></div>
<div class="settings-layout"><nav class="settings-nav" aria-label="Preferências"><a href="#profile" class="active"><span>◎</span><span><strong>Perfil</strong><small>Nome e identidade</small></span></a><a href="#security"><span>⌾</span><span><strong>Segurança</strong><small>Palavra-passe</small></span></a><a href="#accesses"><span>◷</span><span><strong>Acessos</strong><small>Últimos logins</small></span></a></nav><div class="settings-content">
<section id="profile" class="settings-card profile-card"><div class="settings-card-heading"><span class="settings-icon">◎</span><div><h2>Perfil pessoal</h2><p>Estes dados não alteram o comportamento global da aplicação.</p></div><span class="settings-state">Conta ativa</span></div><form asp-action="Profile" method="post" class="form-stack settings-form"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="field-grid"><div><label asp-for="DisplayName"></label><input asp-for="DisplayName" /><span asp-validation-for="DisplayName" class="field-error"></span></div><div><label asp-for="Email"></label><input asp-for="Email" disabled /><p class="form-help">O email de acesso não pode ser alterado.</p></div></div><div class="settings-actions"><button class="button" type="submit">Guardar preferências</button></div></form></section>
<section id="security" class="settings-card security-card"><div class="settings-card-heading"><span class="settings-icon">⌾</span><div><h2>Segurança da conta</h2><p>Confirme a palavra-passe atual antes de definir uma nova.</p></div><span class="settings-state secure">Protegida</span></div><form asp-action="ChangePassword" method="post" class="form-stack settings-form"><label for="CurrentPassword">Palavra-passe atual</label><input id="CurrentPassword" name="CurrentPassword" type="password" autocomplete="current-password" required /><div class="field-grid"><div><label for="NewPassword">Nova palavra-passe</label><input id="NewPassword" name="NewPassword" type="password" autocomplete="new-password" minlength="12" required /></div><div><label for="ConfirmPassword">Confirmar nova palavra-passe</label><input id="ConfirmPassword" name="ConfirmPassword" type="password" autocomplete="new-password" minlength="12" required /></div></div><p class="form-help">Mínimo de 12 caracteres, com maiúscula, minúscula, número e símbolo.</p><div class="settings-actions"><button class="button" type="submit">Alterar palavra-passe</button></div></form></section>
<section id="accesses" class="settings-card login-history-card"><div class="settings-card-heading"><span class="settings-icon">◷</span><div><h2>Últimos acessos</h2><p>Consulte quando e a partir de que endereço IP a sua conta foi utilizada.</p></div><span class="settings-state">@Model.LoginHistory.Count registos</span></div><div class="login-history-list">@foreach (var login in Model.LoginHistory) { <article><span class="login-history-icon">↗</span><div><strong>@TimeZoneInfo.ConvertTime(login.LoggedInAt, lisbonTime).ToString("dd/MM/yyyy 'às' HH:mm:ss")</strong><small>Endereço IP: @login.IpAddress</small></div></article> }@if (Model.LoginHistory.Count == 0) { <p class="empty-row">Ainda não existem acessos registados.</p> }</div></section>
</div></div>

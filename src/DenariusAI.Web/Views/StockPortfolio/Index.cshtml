@model StockPortfolioIndexViewModel
@{ ViewData["Title"] = "Portfólio de ações"; }
<div class="page-header"><div><p class="eyebrow">Investimentos</p><h1>Portfólio de ações</h1><p class="page-subtitle">Acompanhe posições, valor de mercado e evolução das cotações registadas.</p></div><a class="button" asp-action="Create">Adicionar ação</a></div>
<section class="certificate-totals" aria-label="Resumo do portfólio"><article class="certificate-investment"><span>Capital investido</span><strong>@Model.TotalCost.ToString("N2")</strong><small>Ao custo médio registado</small></article><article class="certificate-current"><span>Valor de mercado</span><strong>@Model.TotalMarketValue.ToString("N2")</strong><small>Com as últimas cotações</small></article><article class="certificate-yield"><span>Ganho / perda</span><strong class="@(Model.TotalGain < 0 ? "negative" : "positive")">@Model.TotalGain.ToString("N2")</strong><small>Não realizado</small></article></section>
<section class="panel certificate-panel"><div class="table-wrap"><table class="entity-table certificate-table"><thead><tr><th>Ação</th><th>Mercado</th><th>Quantidade</th><th>Custo médio</th><th>Última cotação</th><th>Data</th><th>Investido</th><th>Valor atual</th><th>Ganho / perda</th><th class="actions">Ações</th></tr></thead><tbody>
@foreach(var item in Model.Items){<tr><td><strong>@item.Ticker</strong><br /><small>@item.Name</small></td><td>@(item.Exchange ?? "—")<br /><small>@item.Currency</small></td><td class="amount">@item.Quantity.ToString("N4")</td><td class="amount">@item.AverageCost.ToString("N4") @item.Currency</td><td><form asp-action="UpdatePrice" method="post" class="stock-price-form"><input type="hidden" name="Id" value="@item.Id" /><input type="number" name="Price" value="@item.CurrentPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)" min="0" step="0.000001" aria-label="Cotação de @item.Ticker" /><input type="date" name="Date" value="@item.PriceDate.ToString("yyyy-MM-dd")" aria-label="Data da cotação de @item.Ticker" /><button class="button secondary" type="submit">Atualizar</button></form></td><td class="nowrap">@item.PriceDate.ToString("dd/MM/yyyy")</td><td class="amount">@item.CostValue.ToString("N2") @item.Currency</td><td class="amount"><strong>@item.MarketValue.ToString("N2") @item.Currency</strong></td><td class="amount @(item.Gain < 0 ? "negative" : "positive")">@item.Gain.ToString("N2") @item.Currency<br /><small>@item.GainPercent.ToString("N2")%</small></td><td class="actions"><a class="text-link" asp-action="Edit" asp-route-id="@item.Id">Editar</a><form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Remover esta ação e o histórico de cotações?')"><button class="text-link danger-link" type="submit">Remover</button></form>@await Html.PartialAsync("_AuditLink", new AuditLinkViewModel("StockPosition", item.Id.ToString()))</td></tr>}
@if(Model.Items.Count==0){<tr><td colspan="10" class="empty-row">Ainda não existem ações no portfólio.</td></tr>}
</tbody></table></div><p class="certificate-note">Os valores são calculados deterministicamente a partir da quantidade, custo médio e última cotação registada. Portfólios com várias moedas não são convertidos entre si.</p></section>

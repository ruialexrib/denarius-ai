@model StockPortfolioIndexViewModel
@{ ViewData["Title"] = "Portfólio de ações"; }
<link rel="stylesheet" href="~/css/stock-portfolio.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/cards.css" asp-append-version="true" />

<div class="page-header stock-portfolio-header"><div><p class="eyebrow">Investimentos</p><h1>Portfólio de ações</h1><p class="page-subtitle">Acompanhe as suas posições e os instrumentos que mantém sob observação.</p></div><a class="button" asp-action="Create">Adicionar ação</a></div>
<section class="stock-portfolio-summary" aria-label="Resumo do portfólio"><article class="stock-summary-invested"><span>Capital investido</span><strong>@Model.TotalCost.ToString("N2")</strong><small>Ao custo médio registado</small></article><article><span>Valor de mercado</span><strong>@Model.TotalMarketValue.ToString("N2")</strong><small>Com as últimas cotações</small></article><article><span>Ganho / perda</span><strong class="@(Model.TotalGain < 0 ? "negative" : "positive")">@Model.TotalGain.ToString("N2")</strong><small>Resultado não realizado</small></article></section>
<section class="panel stock-section"><header class="stock-section-header"><div><p class="eyebrow">Posições</p><h2>Em carteira</h2><p>Posições com quantidade registada e respetiva valorização.</p></div><span class="stock-section-count">@(Model.PortfolioFilter.Pagination.TotalItems == 1 ? "1 posição" : $"{Model.PortfolioFilter.Pagination.TotalItems} posições")</span></header>
<form id="portfolio-filters" method="get" class="filterbar stock-filterbar stock-section-filterbar">
    <input type="hidden" name="watchlistSearch" value="@Model.WatchlistFilter.Search" /><input type="hidden" name="watchlistExchange" value="@Model.WatchlistFilter.Exchange" /><input type="hidden" name="watchlistCurrency" value="@Model.WatchlistFilter.Currency" /><input type="hidden" name="watchlistPage" value="@Model.WatchlistFilter.Pagination.Page" /><input type="hidden" name="watchlistPageSize" value="@Model.WatchlistFilter.Pagination.PageSize" />
    <input type="search" name="portfolioSearch" value="@Model.PortfolioFilter.Search" placeholder="Pesquisar por ticker ou nome..." aria-label="Pesquisar posições em carteira" />
    <select name="portfolioExchange" aria-label="Mercado da carteira"><option value="">Todos os mercados</option>@foreach(var item in Model.Exchanges){<option value="@item" selected="@(string.Equals(item,Model.PortfolioFilter.Exchange,StringComparison.OrdinalIgnoreCase))">@item</option>}</select>
    <select name="portfolioCurrency" aria-label="Moeda da carteira"><option value="">Todas as moedas</option>@foreach(var item in Model.Currencies){<option value="@item" selected="@(string.Equals(item,Model.PortfolioFilter.Currency,StringComparison.OrdinalIgnoreCase))">@item</option>}</select>
    <label class="page-size">Por página <select name="portfolioPageSize">@foreach(var size in PaginationViewModel.AllowedPageSizes){<option value="@size" selected="@(size==Model.PortfolioFilter.Pagination.PageSize)">@size</option>}</select></label><button class="button secondary" type="submit">Aplicar</button>
</form><div class="stock-position-list">
@foreach(var item in Model.PortfolioItems){<article class="stock-position-card"><div class="stock-position-main"><div class="stock-identity"><div><strong>@item.Ticker</strong><span>@(item.Exchange ?? "—")</span></div><p>@item.Name · @item.Currency</p></div><div class="stock-current-price"><span>Última cotação</span><strong>@item.CurrentPrice.ToString("N4") @item.Currency</strong><small>@item.PriceDate.ToString("dd/MM/yyyy")</small></div><div class="stock-position-value"><span>Valor atual</span><strong>@item.MarketValue.ToString("N2") @item.Currency</strong><small>@item.Quantity.ToString("N4") ações</small></div><div class="stock-position-gain"><span>Ganho / perda</span><strong class="@(item.Gain < 0 ? "negative" : "positive")">@item.Gain.ToString("N2") @item.Currency</strong><small class="@(item.Gain < 0 ? "negative" : "positive")">@item.GainPercent.ToString("N2")%</small></div></div><div class="stock-position-details"><div><span>Preço médio de compra</span><strong>@item.AverageCost.ToString("N4") @item.Currency</strong></div><div><span>Capital investido</span><strong>@item.CostValue.ToString("N2") @item.Currency</strong></div>@if(item.ForecastEnabled){<div><span>Previsão</span><strong>@(item.ForecastModel ?? "Ativa")</strong></div>}</div><div class="stock-position-footer"><form asp-action="UpdatePrice" method="post" class="stock-price-form"><input type="hidden" name="Id" value="@item.Id" /><label><span>Cotação</span><input type="number" name="Price" value="@item.CurrentPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)" min="0" step="0.000001" /></label><label><span>Data</span><input type="date" name="Date" value="@item.PriceDate.ToString("yyyy-MM-dd")" /></label><button class="text-link" type="submit">Atualizar</button></form><div class="stock-card-actions"><a class="text-link" asp-action="History" asp-route-id="@item.Id">Ver evolução</a><a class="text-link" asp-action="Edit" asp-route-id="@item.Id">Editar</a>@await Html.PartialAsync("_AuditLink",new AuditLinkViewModel("StockPosition",item.Id.ToString()))<form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Remover esta ação e o histórico de cotações?')"><button class="text-link danger-link" type="submit">Remover</button></form></div></div></article>}
@if(Model.PortfolioItems.Count==0){<div class="stock-empty-state"><strong>Não foram encontradas posições.</strong><span>Altere os filtros ou adicione uma ação ao portfólio.</span></div>}</div><nav class="pagination stock-pagination" aria-label="Paginação do portfólio"><span>@Model.PortfolioFilter.Pagination.FirstItem–@Model.PortfolioFilter.Pagination.LastItem de @Model.PortfolioFilter.Pagination.TotalItems</span><div><button class="pager-link" type="submit" form="portfolio-filters" name="portfolioPage" value="@(Model.PortfolioFilter.Pagination.Page-1)" disabled="@(!Model.PortfolioFilter.Pagination.HasPreviousPage)">Anterior</button><span>Página @Model.PortfolioFilter.Pagination.Page de @Model.PortfolioFilter.Pagination.TotalPages</span><button class="pager-link" type="submit" form="portfolio-filters" name="portfolioPage" value="@(Model.PortfolioFilter.Pagination.Page+1)" disabled="@(!Model.PortfolioFilter.Pagination.HasNextPage)">Seguinte</button></div></nav><p class="stock-section-note">Os valores são calculados deterministicamente a partir da quantidade, preço médio de compra e última cotação registada. Valores em moedas diferentes não são convertidos entre si.</p></section>
<section class="panel stock-section stock-watchlist-section"><header class="stock-section-header"><div><p class="eyebrow">A acompanhar</p><h2>Watchlist</h2><p>Instrumentos observados, incluindo os que já fazem parte da carteira.</p></div><span class="stock-section-count">@Model.WatchlistFilter.Pagination.TotalItems instrumento@(Model.WatchlistFilter.Pagination.TotalItems == 1 ? "" : "s")</span></header>
<form id="watchlist-filters" method="get" class="filterbar stock-filterbar stock-section-filterbar">
    <input type="hidden" name="portfolioSearch" value="@Model.PortfolioFilter.Search" /><input type="hidden" name="portfolioExchange" value="@Model.PortfolioFilter.Exchange" /><input type="hidden" name="portfolioCurrency" value="@Model.PortfolioFilter.Currency" /><input type="hidden" name="portfolioPage" value="@Model.PortfolioFilter.Pagination.Page" /><input type="hidden" name="portfolioPageSize" value="@Model.PortfolioFilter.Pagination.PageSize" />
    <input type="search" name="watchlistSearch" value="@Model.WatchlistFilter.Search" placeholder="Pesquisar por ticker ou nome..." aria-label="Pesquisar watchlist" />
    <select name="watchlistExchange" aria-label="Mercado da watchlist"><option value="">Todos os mercados</option>@foreach(var item in Model.Exchanges){<option value="@item" selected="@(string.Equals(item,Model.WatchlistFilter.Exchange,StringComparison.OrdinalIgnoreCase))">@item</option>}</select>
    <select name="watchlistCurrency" aria-label="Moeda da watchlist"><option value="">Todas as moedas</option>@foreach(var item in Model.Currencies){<option value="@item" selected="@(string.Equals(item,Model.WatchlistFilter.Currency,StringComparison.OrdinalIgnoreCase))">@item</option>}</select>
    <label class="page-size">Por página <select name="watchlistPageSize">@foreach(var size in PaginationViewModel.AllowedPageSizes){<option value="@size" selected="@(size==Model.WatchlistFilter.Pagination.PageSize)">@size</option>}</select></label><button class="button secondary" type="submit">Aplicar</button>
</form><div class="stock-watchlist-list">
@foreach(var item in Model.WatchlistItems){<article class="stock-watchlist-row"><div class="stock-watchlist-top"><div class="stock-identity"><div><strong>@item.Ticker</strong><span>@(item.Exchange ?? "—")</span></div><p>@item.Name · @item.Currency</p></div><div class="stock-watchlist-price"><span class="stock-label">Última cotação</span><strong>@item.CurrentPrice.ToString("N4") @item.Currency</strong><small>@item.PriceDate.ToString("dd/MM/yyyy")</small></div><span class="status @(item.WatchlistOnly ? "pending" : "active")">@(item.WatchlistOnly ? "Só watchlist" : "Na carteira")</span></div><div class="stock-watchlist-metrics"><div><span>Variação no período</span><strong class="@(item.PeriodChangePercent < 0 ? "negative" : "positive")">@(item.PeriodChangePercent.HasValue ? $"{item.PeriodChangePercent.Value:N2}%" : "—")</strong><small>@(item.PeriodStartDate.HasValue ? $"Desde {item.PeriodStartDate.Value:dd/MM/yyyy}" : "Sem histórico")</small></div><div><span>Mínimo</span><strong>@(item.MinimumPrice.HasValue ? $"{item.MinimumPrice.Value:N4} {item.Currency}" : "—")</strong><small>@(item.MinimumPriceDate.HasValue ? $"Em {item.MinimumPriceDate.Value:dd/MM/yyyy}" : "Sem histórico")</small></div><div><span>Máximo</span><strong>@(item.MaximumPrice.HasValue ? $"{item.MaximumPrice.Value:N4} {item.Currency}" : "—")</strong><small>@(item.MaximumPriceDate.HasValue ? $"Em {item.MaximumPriceDate.Value:dd/MM/yyyy}" : "Sem histórico")</small></div></div><div class="stock-watchlist-footer"><div><span class="stock-label">Histórico desde</span><strong>@item.HistoryStartDate.ToString("dd/MM/yyyy")</strong><span class="status @(item.ForecastEnabled ? "active" : "inactive")">Previsão @(item.ForecastEnabled ? "ativa" : "inativa")</span></div><div class="stock-card-actions"><a class="text-link" asp-action="History" asp-route-id="@item.Id">Evolução</a><form asp-action="ImportHistory" asp-route-id="@item.Id" method="post"><button class="text-link" type="submit">Recolher</button></form><a class="text-link" asp-action="Edit" asp-route-id="@item.Id">Editar</a><form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Remover esta ação da watchlist e o respetivo histórico?')"><button class="text-link danger-link" type="submit">Remover</button></form></div></div></article>}
@if(Model.WatchlistItems.Count==0){<div class="stock-empty-state"><strong>Não foram encontrados instrumentos.</strong><span>Altere os filtros ou adicione instrumentos à watchlist.</span></div>}</div><nav class="pagination stock-pagination" aria-label="Paginação da watchlist"><span>@Model.WatchlistFilter.Pagination.FirstItem–@Model.WatchlistFilter.Pagination.LastItem de @Model.WatchlistFilter.Pagination.TotalItems</span><div><button class="pager-link" type="submit" form="watchlist-filters" name="watchlistPage" value="@(Model.WatchlistFilter.Pagination.Page-1)" disabled="@(!Model.WatchlistFilter.Pagination.HasPreviousPage)">Anterior</button><span>Página @Model.WatchlistFilter.Pagination.Page de @Model.WatchlistFilter.Pagination.TotalPages</span><button class="pager-link" type="submit" form="watchlist-filters" name="watchlistPage" value="@(Model.WatchlistFilter.Pagination.Page+1)" disabled="@(!Model.WatchlistFilter.Pagination.HasNextPage)">Seguinte</button></div></nav><p class="stock-section-note">A recolha usa o Alpha Vantage configurado nas Definições. Para ações Euronext, utilize o símbolo reconhecido pelo fornecedor.</p></section>

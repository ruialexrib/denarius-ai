@model StockPositionFormViewModel
@{ var editing = Model.Id.HasValue; ViewData["Title"] = editing ? "Editar ação" : "Adicionar ação"; }
<link rel="stylesheet" href="~/css/data-forms.css" asp-append-version="true" />
<div class="page-header"><div><p class="eyebrow">Investimentos · Portfólio de ações</p><h1>@ViewData["Title"]</h1><p class="page-subtitle">@(editing ? "Atualize a posição e a cotação associada a este instrumento." : "Identifique a ação, o mercado onde é negociada e os dados atuais da posição.")</p></div><a class="button secondary" asp-action="Index">Voltar</a></div>
<section class="data-editor"><div class="data-editor-grid"><div class="data-editor-main"><form method="post" asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@(editing ? Model.Id : null)" class="form-stack"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div>
<div class="form-grid two"><div><label asp-for="Ticker">Ticker</label><input asp-for="Ticker" placeholder="Ex.: MSFT ou EDP" autocomplete="off" autofocus /><span asp-validation-for="Ticker" class="field-error"></span><p class="form-help">Use o símbolo oficial da ação na bolsa selecionada.</p></div><div><label asp-for="Name">Nome da empresa ou instrumento</label><input asp-for="Name" placeholder="Ex.: Microsoft Corporation" autocomplete="off" /><span asp-validation-for="Name" class="field-error"></span></div></div>
<div class="form-grid two"><div><label asp-for="Exchange">Mercado</label><input asp-for="Exchange" placeholder="Ex.: NASDAQ, NYSE ou Euronext Lisbon" autocomplete="off" /><span asp-validation-for="Exchange" class="field-error"></span></div><div><label asp-for="Currency">Moeda</label><input asp-for="Currency" maxlength="3" placeholder="EUR ou USD" autocomplete="off" /><span asp-validation-for="Currency" class="field-error"></span><p class="form-help">Indique o código ISO de três letras usado na negociação.</p></div></div>
<div class="form-grid two"><div><label asp-for="Quantity">Quantidade</label><input asp-for="Quantity" type="number" min="0" step="0.00000001" inputmode="decimal" /><span asp-validation-for="Quantity" class="field-error"></span></div><div><label asp-for="AverageCost">Custo médio por ação</label><input asp-for="AverageCost" type="number" min="0" step="0.000001" inputmode="decimal" /><span asp-validation-for="AverageCost" class="field-error"></span></div></div>
<div class="form-grid two"><div><label asp-for="CurrentPrice">Cotação atual</label><input asp-for="CurrentPrice" type="number" min="0" step="0.000001" inputmode="decimal" /><span asp-validation-for="CurrentPrice" class="field-error"></span><p class="form-help">Será substituída pela última cotação quando a atualização de mercado estiver configurada.</p></div><div><label asp-for="PriceDate">Data da cotação</label><input asp-for="PriceDate" type="date" /><span asp-validation-for="PriceDate" class="field-error"></span></div></div>
<div class="form-grid two"><div><label asp-for="HistoryStartDate">Recolher histórico desde</label><input asp-for="HistoryStartDate" type="date" max="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" /><span asp-validation-for="HistoryStartDate" class="field-error"></span><p class="form-help">No plano gratuito, a data filtra as 100 sessões mais recentes disponibilizadas pelo fornecedor.</p></div><div><label class="modern-toggle"><input asp-for="WatchlistOnly" type="checkbox" /><span class="modern-toggle-track"><span></span></span><span class="modern-toggle-copy"><strong>Apenas watchlist</strong><small>Ative para acompanhar sem posição. Desativado, fica no portfólio e também na watchlist.</small></span></label><span asp-validation-for="WatchlistOnly" class="field-error"></span></div></div>
<div><label class="modern-toggle"><input asp-for="ForecastEnabled" type="checkbox" /><span class="modern-toggle-track"><span></span></span><span class="modern-toggle-copy"><strong>Ativar previsão de cotações</strong><small>Calcula horizontes de 30, 60 e 90 dias quando existirem pelo menos 60 observações.</small></span></label><span asp-validation-for="ForecastEnabled" class="field-error"></span></div>
<div class="form-actions"><button class="button" type="submit">@(editing ? "Guardar alterações" : "Adicionar ao portfólio")</button><a class="button secondary" asp-action="Index">Cancelar</a></div></form></div>
<aside class="data-editor-context"><p class="eyebrow">Contexto</p><h2>Identificar e analisar a ação</h2><p>O ticker e o mercado formam a identificação usada para obter cotações dos mercados dos EUA e da Euronext.</p><ul class="data-editor-context-list"><li><strong>Ticker</strong>O símbolo pode repetir-se em bolsas diferentes, por isso confirme sempre o mercado.</li><li><strong>Histórico</strong>Escolha desde quando pretende recolher dados; períodos mais longos ajudam a validar o modelo.</li><li><strong>Previsão ARIMA</strong>É opcional e apresenta intervalos de incerteza para 30, 60 e 90 dias.</li><li><strong>Decisão</strong>As previsões são indicativas e nunca alteram automaticamente o seu portfólio.</li></ul></aside></div></section>

@model StockPositionFormViewModel
@{ var editing=Model.Id.HasValue; ViewData["Title"]=editing?"Editar ação":"Adicionar ação"; }
<link rel="stylesheet" href="~/css/data-forms.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/stock-form.css" asp-append-version="true" />
<div class="page-header stock-form-header"><div><p class="eyebrow">Investimentos · Portfólio de ações</p><h1>@ViewData["Title"]</h1><p class="page-subtitle">@(editing?"Atualize a identificação, posição e opções de acompanhamento deste instrumento.":"Identifique a ação e configure a posição e o respetivo acompanhamento.")</p></div><a class="button secondary" asp-action="Index">Voltar</a></div>
<section class="data-editor stock-editor"><div class="data-editor-grid stock-editor-grid"><div class="data-editor-main"><form method="post" asp-action="@(editing?"Edit":"Create")" asp-route-id="@(editing?Model.Id:null)" class="form-stack stock-form"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div>
<section class="stock-form-section"><header class="stock-form-section-header"><span class="stock-form-step">01</span><div><h2>Identificação</h2><p>Dados usados para identificar o instrumento e obter cotações de mercado.</p></div></header><div class="stock-form-section-body"><div class="form-grid two"><div><label asp-for="Ticker">Ticker</label><input asp-for="Ticker" placeholder="Ex.: MSFT ou EDP.LS" autocomplete="off" autofocus /><span asp-validation-for="Ticker" class="field-error"></span><p class="stock-field-help">Use o símbolo reconhecido pelo fornecedor de cotações. Para a EDP, por exemplo, utilize EDP.LS.</p></div><div><label asp-for="Name">Nome da empresa ou instrumento</label><input asp-for="Name" placeholder="Ex.: EDP, S.A." autocomplete="off" /><span asp-validation-for="Name" class="field-error"></span></div></div><div class="form-grid two"><div><label asp-for="Exchange">Mercado</label><input asp-for="Exchange" placeholder="Ex.: Euronext Lisbon" autocomplete="off" /><span asp-validation-for="Exchange" class="field-error"></span></div><div><label asp-for="Currency">Moeda</label><input asp-for="Currency" maxlength="3" placeholder="Ex.: EUR" autocomplete="off" /><span asp-validation-for="Currency" class="field-error"></span><p class="stock-field-help">Código ISO de três letras da moeda de negociação.</p></div></div></div></section>
<section class="stock-form-section"><header class="stock-form-section-header"><span class="stock-form-step">02</span><div><h2>Posição</h2><p>Indique a quantidade detida e o preço médio efetivamente pago.</p></div></header><div class="stock-form-section-body"><div class="form-grid two"><div><label asp-for="Quantity">Quantidade</label><input asp-for="Quantity" type="number" min="0" step="0.00000001" inputmode="decimal" /><span asp-validation-for="Quantity" class="field-error"></span></div><div><label asp-for="AverageCost">Preço médio de compra</label><input asp-for="AverageCost" type="number" min="0" step="0.000001" inputmode="decimal" /><span asp-validation-for="AverageCost" class="field-error"></span><p class="stock-field-help">Preço médio de aquisição por ação.</p></div></div></div></section>
<section class="stock-form-section"><header class="stock-form-section-header"><span class="stock-form-step">03</span><div><h2>Cotação e histórico</h2><p>Defina a referência atual e desde quando pretende acompanhar a evolução.</p></div></header><div class="stock-form-section-body"><div class="form-grid two"><div><label asp-for="CurrentPrice">Cotação atual</label><input asp-for="CurrentPrice" type="number" min="0" step="0.000001" inputmode="decimal" /><span asp-validation-for="CurrentPrice" class="field-error"></span><p class="stock-field-help">Pode ser substituída pela cotação recolhida junto do fornecedor configurado.</p></div><div><label asp-for="PriceDate">Data da cotação</label><input asp-for="PriceDate" type="date" /><span asp-validation-for="PriceDate" class="field-error"></span></div></div><div class="stock-history-field"><label asp-for="HistoryStartDate">Recolher histórico desde</label><input asp-for="HistoryStartDate" type="date" max="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" /><span asp-validation-for="HistoryStartDate" class="field-error"></span><p class="stock-field-help">No plano gratuito, a data filtra as 100 sessões mais recentes disponibilizadas pelo fornecedor.</p></div></div></section>
<section class="stock-form-section stock-options-section"><header class="stock-form-section-header"><span class="stock-form-step">04</span><div><h2>Acompanhamento</h2><p>Escolha como este instrumento deve ser tratado no Denarius AI.</p></div></header><div class="stock-form-options"><label class="modern-toggle stock-option"><input asp-for="WatchlistOnly" type="checkbox" /><span class="modern-toggle-track"><span></span></span><span class="modern-toggle-copy"><strong>Apenas watchlist</strong><small>Acompanhar o instrumento sem o considerar uma posição da carteira.</small></span></label><span asp-validation-for="WatchlistOnly" class="field-error"></span><label class="modern-toggle stock-option"><input asp-for="ForecastEnabled" type="checkbox" /><span class="modern-toggle-track"><span></span></span><span class="modern-toggle-copy"><strong>Ativar previsão de cotações</strong><small>Calcular horizontes de 30, 60 e 90 dias quando existirem pelo menos 60 observações.</small></span></label><span asp-validation-for="ForecastEnabled" class="field-error"></span></div></section>
<div class="form-actions stock-form-actions"><button class="button" type="submit">@(editing?"Guardar alterações":"Adicionar ao portfólio")</button><a class="button secondary" asp-action="Index">Cancelar</a></div></form></div>
<aside class="data-editor-context stock-form-context"><p class="eyebrow">Contexto</p><h2>Acompanhar uma ação</h2><p>Os dados desta ficha identificam o instrumento, a posição detida e o período usado para acompanhar a sua evolução.</p><ul class="data-editor-context-list"><li><strong>Ticker e mercado</strong>Use o símbolo reconhecido pelo fornecedor e confirme a bolsa. Exemplo: EDP.LS na Euronext Lisbon.</li><li><strong>Preço médio de compra</strong>Indique o preço médio efetivamente pago por cada ação. Este valor é usado no cálculo do ganho ou perda da posição.</li><li><strong>Histórico</strong>A data inicial define o período de análise apresentado na evolução e na watchlist, dentro dos dados disponibilizados pelo fornecedor.</li><li><strong>Previsão</strong>Quando ativa e com histórico suficiente, apresenta projeções indicativas a 30, 60 e 90 dias. Não altera automaticamente a carteira.</li></ul></aside></div></section>

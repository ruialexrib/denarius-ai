@model StockPositionFormViewModel
@{ var editing = Model.Id.HasValue; ViewData["Title"] = editing ? "Editar ação" : "Adicionar ação"; }
<div class="page-header"><div><p class="eyebrow">Investimentos</p><h1>@ViewData["Title"]</h1><p class="page-subtitle">Registe a posição e a cotação mais recente. Pode atualizar a cotação posteriormente no portfólio.</p></div></div>
<section class="panel"><form method="post" asp-action="@(editing ? "Edit" : "Create")" class="data-form"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-grid"><label>Ticker<input asp-for="Ticker" placeholder="Ex.: MSFT" /><span asp-validation-for="Ticker"></span></label><label>Nome<input asp-for="Name" placeholder="Ex.: Microsoft Corporation" /><span asp-validation-for="Name"></span></label><label>Mercado<input asp-for="Exchange" placeholder="Ex.: NASDAQ" /><span asp-validation-for="Exchange"></span></label><label>Moeda<input asp-for="Currency" maxlength="3" /><span asp-validation-for="Currency"></span></label><label>Quantidade<input asp-for="Quantity" type="number" min="0" step="0.00000001" /><span asp-validation-for="Quantity"></span></label><label>Custo médio<input asp-for="AverageCost" type="number" min="0" step="0.000001" /><span asp-validation-for="AverageCost"></span></label><label>Cotação atual<input asp-for="CurrentPrice" type="number" min="0" step="0.000001" /><span asp-validation-for="CurrentPrice"></span></label><label>Data da cotação<input asp-for="PriceDate" type="date" /><span asp-validation-for="PriceDate"></span></label></div><div class="form-actions"><button class="button" type="submit">@(editing ? "Guardar alterações" : "Adicionar ao portfólio")</button><a class="button secondary" asp-action="Index">Cancelar</a></div></form></section>

@model AccountFormViewModel
@{ var editing = Model.Id != Guid.Empty; ViewData["Title"] = editing ? "Editar conta" : "Nova conta"; }
<link rel="stylesheet" href="~/css/data-forms.css" asp-append-version="true" />
<div class="page-header"><div><p class="eyebrow">Configuração · Contas</p><h1>@ViewData["Title"]</h1><p class="page-subtitle">@(editing ? "Atualize a identificação, classificação e parâmetros desta conta." : "Registe uma conta e defina a respetiva classificação e saldo inicial.")</p></div></div>
<section class="data-editor"><div class="data-editor-grid"><div class="data-editor-main"><form asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@(editing ? Model.Id : null)" method="post" class="form-stack">
<div asp-validation-summary="ModelOnly" class="validation-summary"></div>@if (editing) { <input asp-for="Id" type="hidden" /> }
<label asp-for="Name"></label><input asp-for="Name" autocomplete="off" /><span asp-validation-for="Name" class="field-error"></span>
<label asp-for="Description"></label><textarea asp-for="Description" rows="3"></textarea><span asp-validation-for="Description" class="field-error"></span>
<div class="form-grid two"><div><label asp-for="AccountType"></label><select asp-for="AccountType" asp-items="Model.AccountTypes"></select><span asp-validation-for="AccountType" class="field-error"></span></div><div><label asp-for="CategoryId"></label><select asp-for="CategoryId" asp-items="Model.Categories" class="searchable-select-control" data-search-placeholder="Pesquisar categoria…" data-search-empty-text="Nenhuma categoria encontrada" data-search-include-empty="true"></select><span asp-validation-for="CategoryId" class="field-error"></span></div></div>
<p class="form-help">Contas patrimoniais aceitam categorias de património; contas de rendimento e despesa aceitam categorias do respetivo tipo.</p>
<div class="form-grid two"><div><label asp-for="InitialBalance"></label><input asp-for="InitialBalance" type="number" step="0.0001" /><span asp-validation-for="InitialBalance" class="field-error"></span></div><div><label asp-for="Currency"></label><input asp-for="Currency" maxlength="3" autocomplete="off" /><span asp-validation-for="Currency" class="field-error"></span></div></div>
<div class="form-actions"><button class="button" type="submit">Guardar</button>@if (editing) { <a class="button secondary" asp-action="Details" asp-route-id="@Model.Id">Cancelar</a> } else { <a class="button secondary" asp-action="Index">Cancelar</a> }</div></form></div>
<aside class="data-editor-context"><p class="eyebrow">Contexto</p><h2>Como esta conta é utilizada</h2><p>A classificação determina onde os movimentos e saldos desta conta são apresentados na análise financeira.</p><ul class="data-editor-context-list"><li><strong>Tipo de conta</strong>Define se representa património, rendimento ou despesa.</li><li><strong>Categoria</strong>Organiza a conta dentro da estrutura financeira correspondente.</li><li><strong>Saldo inicial</strong>Representa o valor existente antes dos movimentos registados no Denarius AI.</li><li><strong>Moeda</strong>Use o código de três letras aplicável, por exemplo EUR.</li></ul></aside></div></section>
@section Scripts { <script src="~/js/searchable-select.js" asp-append-version="true"></script> }

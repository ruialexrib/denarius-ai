@model AccountStatementViewModel
@using DenariusAI.Web.Controllers
@{ ViewData["Title"] = $"Extrato · {Model.Account.Name}"; }
<div class="page-header">
    <div><p class="eyebrow">Configuração · Contas</p><h1>Extrato da conta</h1><p class="page-subtitle">Consulte todos os débitos e créditos de @Model.Account.Name e acompanhe o saldo após cada movimento.</p></div>
    <div class="form-actions"><a class="button secondary" asp-action="Details" asp-route-id="@Model.Account.Id">Voltar à conta</a></div>
</div>
<section class="panel statement-summary">
    <div><span>Conta</span><strong>@Model.Account.Name</strong></div>
    <div><span>Saldo inicial</span><strong>@Model.Account.InitialBalance.ToString("N2") @Model.Account.Currency</strong></div>
    <div><span>Saldo atual</span><strong>@Model.Account.Balance.ToString("N2") @Model.Account.Currency</strong></div>
</section>
<section class="panel">
    <form id="statement-filters" method="get" class="filterbar account-statement-filters"><input type="hidden" name="id" value="@Model.Account.Id" /><label>De <input type="date" name="from" value="@(Model.From?.ToString("yyyy-MM-dd"))" /></label><label>Até <input type="date" name="to" value="@(Model.To?.ToString("yyyy-MM-dd"))" /></label><input type="search" name="search" value="@Model.Search" placeholder="Descrição, referência ou categoria..." /><label class="page-size">Por página <select name="pageSize">@foreach (var size in PaginationViewModel.AllowedPageSizes) { <option value="@size" selected="@(size == Model.Pagination.PageSize)">@size</option> }</select></label><button class="button secondary" type="submit">Aplicar</button></form>
    <div class="table-wrap"><table><thead><tr><th>Data</th><th>Movimento</th><th>Categoria</th><th>Débito</th><th>Crédito</th><th>Saldo</th><th>Reconciliação</th><th class="actions">Ações</th></tr></thead><tbody>
    @foreach (var item in Model.Items) {
        <tr><td class="nowrap">@item.Date.ToString("dd/MM/yyyy")</td><td><strong>@item.Description</strong>@if (!string.IsNullOrWhiteSpace(item.Reference)) { <small>Ref. @item.Reference</small> }@if (!string.IsNullOrWhiteSpace(item.LineDescription) && item.LineDescription != item.Description) { <small>@item.LineDescription</small> }</td><td>@if (item.CategoryName is not null) { var kind = item.Debit > 0 ? DenariusAI.Domain.Enums.FinancialGroupKind.Expense : DenariusAI.Domain.Enums.FinancialGroupKind.Income; <partial name="_CategoryKindIcon" model="kind" /> @item.CategoryName } else { <text>Sem categoria</text> }</td><td class="amount">@(item.Debit == 0 ? "—" : item.Debit.ToString("N2"))</td><td class="amount">@(item.Credit == 0 ? "—" : item.Credit.ToString("N2"))</td><td class="amount statement-balance"><strong>@item.Balance.ToString("N2") @Model.Account.Currency</strong></td><td>@JournalEntriesController.ReconciliationName(item.ReconciliationStatus)</td><td class="actions"><a class="text-link" asp-controller="JournalEntries" asp-action="Details" asp-route-id="@item.JournalEntryId">Consultar</a></td></tr>
    }
    @if (Model.Items.Count == 0) { <tr><td colspan="8" class="empty-row">Não foram encontrados movimentos nesta conta.</td></tr> }
    </tbody></table></div>
    <nav class="pagination" aria-label="Paginação"><span>@Model.Pagination.FirstItem–@Model.Pagination.LastItem de @Model.Pagination.TotalItems</span><div><button class="pager-link" type="submit" form="statement-filters" name="page" value="@(Model.Pagination.Page - 1)" disabled="@(!Model.Pagination.HasPreviousPage)">Anterior</button><span>Página @Model.Pagination.Page de @Model.Pagination.TotalPages</span><button class="pager-link" type="submit" form="statement-filters" name="page" value="@(Model.Pagination.Page + 1)" disabled="@(!Model.Pagination.HasNextPage)">Seguinte</button></div></nav>
</section>

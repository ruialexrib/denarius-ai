@model AccountStatementViewModel
@using DenariusAI.Web.Controllers
@{ ViewData["Title"] = $"Extrato · {Model.Account.Name}"; }
<div class="page-header account-statement-header">
    <div><p class="eyebrow">Finanças · Extrato</p><h1>@Model.Account.Name</h1><p class="page-subtitle">Acompanhe os movimentos, a evolução do saldo e o estado de reconciliação desta conta.</p></div>
    <div class="form-actions"><a class="button secondary" asp-action="Details" asp-route-id="@Model.Account.Id">← Voltar à conta</a></div>
</div>
<section class="statement-summary">
    <article class="statement-account-card"><span class="statement-card-icon" aria-hidden="true">$</span><div><span>Conta</span><strong>@Model.Account.Name</strong><small>@AccountsController.AccountTypeName(Model.Account.AccountType) · @Model.Account.Currency</small></div></article>
    <article><span>Saldo inicial</span><strong>@Model.Account.InitialBalance.ToString("N2") @Model.Account.Currency</strong><small>Ponto de partida da conta</small></article>
    <article class="statement-current-balance"><span>Saldo atual</span><strong>@Model.Account.Balance.ToString("N2") @Model.Account.Currency</strong><small>Variação de @((Model.Account.Balance - Model.Account.InitialBalance).ToString("N2")) @Model.Account.Currency</small></article>
    <article><span>Movimentos</span><strong>@Model.Pagination.TotalItems</strong><small>No intervalo selecionado</small></article>
</section>
<section class="panel entity-panel account-statement-panel">
    <div class="statement-filter-heading"><div><span>Movimentos da conta</span><small>Filtre por período, descrição ou categoria</small></div></div>
    <form id="statement-filters" method="get" class="filterbar account-statement-filters"><input type="hidden" name="id" value="@Model.Account.Id" /><label>De <input type="date" name="from" value="@(Model.From?.ToString("yyyy-MM-dd"))" /></label><label>Até <input type="date" name="to" value="@(Model.To?.ToString("yyyy-MM-dd"))" /></label><input type="search" name="search" value="@Model.Search" placeholder="Descrição, referência ou categoria..." /><label class="page-size">Por página <select name="pageSize">@foreach (var size in PaginationViewModel.AllowedPageSizes) { <option value="@size" selected="@(size == Model.Pagination.PageSize)">@size</option> }</select></label><button class="button secondary" type="submit">Aplicar filtros</button></form>
    <div class="table-wrap"><table class="entity-table account-statement-table"><thead><tr><th>Data</th><th>Movimento</th><th>Categoria</th><th>Débito</th><th>Crédito</th><th>Saldo</th><th>Reconciliação</th><th class="actions">Ações</th></tr></thead><tbody>
    @foreach (var item in Model.Items) {
        <tr><td class="nowrap"><span class="statement-date">@item.Date.ToString("dd/MM/yyyy")</span></td><td><strong>@item.Description</strong>@if (!string.IsNullOrWhiteSpace(item.Reference)) { <small>Ref. @item.Reference</small> }@if (!string.IsNullOrWhiteSpace(item.LineDescription) && item.LineDescription != item.Description) { <small>@item.LineDescription</small> }</td><td>@if (item.CategoryName is not null) { var kind = item.Debit > 0 ? DenariusAI.Domain.Enums.FinancialGroupKind.Expense : DenariusAI.Domain.Enums.FinancialGroupKind.Income; <partial name="_CategoryKindIcon" model="kind" /> @item.CategoryName } else { <span class="uncategorized">Sem categoria</span> }</td><td class="amount statement-debit">@(item.Debit == 0 ? "—" : item.Debit.ToString("N2"))</td><td class="amount statement-credit">@(item.Credit == 0 ? "—" : item.Credit.ToString("N2"))</td><td class="amount statement-balance"><strong>@item.Balance.ToString("N2") @Model.Account.Currency</strong></td><td><span class="reconciliation-state">@JournalEntriesController.ReconciliationName(item.ReconciliationStatus)</span></td><td class="actions"><a class="text-link" asp-controller="JournalEntries" asp-action="Details" asp-route-id="@item.JournalEntryId">Consultar</a></td></tr>
    }
    @if (Model.Items.Count == 0) { <tr><td colspan="8" class="empty-row">Não foram encontrados movimentos nesta conta.</td></tr> }
    </tbody></table></div>
    <nav class="pagination" aria-label="Paginação"><span>@Model.Pagination.FirstItem–@Model.Pagination.LastItem de @Model.Pagination.TotalItems</span><div><button class="pager-link" type="submit" form="statement-filters" name="page" value="@(Model.Pagination.Page - 1)" disabled="@(!Model.Pagination.HasPreviousPage)">Anterior</button><span>Página @Model.Pagination.Page de @Model.Pagination.TotalPages</span><button class="pager-link" type="submit" form="statement-filters" name="page" value="@(Model.Pagination.Page + 1)" disabled="@(!Model.Pagination.HasNextPage)">Seguinte</button></div></nav>
</section>

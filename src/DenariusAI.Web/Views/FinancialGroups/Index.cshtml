@model FinancialGroupIndexViewModel
@{ ViewData["Title"] = "Grupos"; var activeCount = Model.Items.Count(item => item.IsActive); var incomeCount = Model.Items.Count(item => item.Kind == DenariusAI.Domain.Enums.FinancialGroupKind.Income); var expenseCount = Model.Items.Count(item => item.Kind == DenariusAI.Domain.Enums.FinancialGroupKind.Expense); }
<link rel="stylesheet" href="~/css/summary-cards.css" asp-append-version="true" />
<div class="page-header"><div><p class="eyebrow">Configuração</p><h1>Grupos financeiros</h1><p class="page-subtitle">Estruture as categorias em grupos para facilitar filtros, orçamento e análise.</p></div><a class="button" asp-action="Create">Novo grupo</a></div>
<section class="area-summary" aria-label="Resumo dos grupos financeiros"><article class="summary-primary"><span>Grupos</span><strong>@Model.Pagination.TotalItems</strong><small>Total correspondente aos filtros atuais</small></article><article class="summary-positive"><span>Ativos nesta página</span><strong>@activeCount</strong><small>Grupos disponíveis para classificação</small></article><article class="summary-info"><span>Rendimento</span><strong>@incomeCount</strong><small>Grupos de rendimento nesta página</small></article><article><span>Despesa</span><strong>@expenseCount</strong><small>Grupos de despesa nesta página</small></article></section>
<section class="panel entity-panel groups-panel"><form id="group-filters" method="get" class="filterbar"><input type="search" name="search" value="@Model.Search" placeholder="Pesquisar grupos..." /><label class="check-row"><input type="checkbox" name="showInactive" value="true" checked="@Model.ShowInactive" /> Mostrar inativos</label><label class="page-size">Por página <select name="pageSize">@foreach (var size in PaginationViewModel.AllowedPageSizes) { <option value="@size" selected="@(size == Model.Pagination.PageSize)">@size</option> }</select></label><button class="button secondary" type="submit">Aplicar</button></form>
<div class="table-wrap"><table class="entity-table"><thead><tr><th>Ordem</th><th>Nome</th><th>Tipo</th><th>Estado</th><th class="actions">Ações</th></tr></thead><tbody>
@foreach (var item in Model.Items) { <tr><td>@item.SortOrder</td><td><strong>@item.Name</strong>@if (!string.IsNullOrWhiteSpace(item.Description)) { <small>@item.Description</small> }</td><td>@(item.Kind == DenariusAI.Domain.Enums.FinancialGroupKind.Asset ? "Património" : item.Kind == DenariusAI.Domain.Enums.FinancialGroupKind.Income ? "Rendimento" : "Despesa")</td><td><span class="status @(item.IsActive ? "active" : "inactive")">@(item.IsActive ? "Ativo" : "Inativo")</span></td><td class="actions"><a class="text-link" asp-action="Statement" asp-route-id="@item.Id">Extrato</a><a class="text-link" asp-action="Edit" asp-route-id="@item.Id">Editar</a><form asp-action="SetActive" method="post"><input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="isActive" value="@((!item.IsActive).ToString().ToLowerInvariant())" /><input type="hidden" name="search" value="@Model.Search" /><input type="hidden" name="showInactive" value="@Model.ShowInactive.ToString().ToLowerInvariant()" /><input type="hidden" name="page" value="@Model.Pagination.Page" /><input type="hidden" name="pageSize" value="@Model.Pagination.PageSize" /><button class="text-link" type="submit">@(item.IsActive ? "Desativar" : "Ativar")</button></form>@await Html.PartialAsync("_AuditLink", new AuditLinkViewModel("FinancialGroup", item.Id.ToString()))</td></tr> }
@if (Model.Items.Count == 0) { <tr><td colspan="5" class="empty-row">Não foram encontrados grupos.</td></tr> }
</tbody></table></div>
<nav class="pagination" aria-label="Paginação"><span>@Model.Pagination.FirstItem–@Model.Pagination.LastItem de @Model.Pagination.TotalItems</span><div><button class="pager-link" type="submit" form="group-filters" name="page" value="@(Model.Pagination.Page - 1)" disabled="@(!Model.Pagination.HasPreviousPage)">Anterior</button><span>Página @Model.Pagination.Page de @Model.Pagination.TotalPages</span><button class="pager-link" type="submit" form="group-filters" name="page" value="@(Model.Pagination.Page + 1)" disabled="@(!Model.Pagination.HasNextPage)">Seguinte</button></div></nav></section>

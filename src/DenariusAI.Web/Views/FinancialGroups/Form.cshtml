@model FinancialGroupFormViewModel
@{ var editing = Model.Id != Guid.Empty; ViewData["Title"] = editing ? "Editar grupo" : "Novo grupo"; }
<link rel="stylesheet" href="~/css/data-forms.css" asp-append-version="true" />
<div class="page-header"><div><p class="eyebrow">Configuração · Grupos</p><h1>@ViewData["Title"]</h1><p class="page-subtitle">@(editing ? "Atualize a identificação, o tipo e a ordem deste grupo financeiro." : "Crie um grupo para agregar categorias com a mesma finalidade financeira.")</p></div><a class="button secondary" asp-action="Index">Voltar</a></div>
<section class="data-editor"><div class="data-editor-grid"><div class="data-editor-main"><form asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@(editing ? Model.Id : null)" method="post" class="form-stack"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><label asp-for="Name"></label><input asp-for="Name" autofocus /><span asp-validation-for="Name" class="field-error"></span><label asp-for="Description"></label><textarea asp-for="Description" rows="3"></textarea><span asp-validation-for="Description" class="field-error"></span><label asp-for="Kind"></label><select asp-for="Kind"><option value="1">Património</option><option value="2">Rendimento</option><option value="3">Despesa</option></select><span asp-validation-for="Kind" class="field-error"></span><label asp-for="SortOrder"></label><input asp-for="SortOrder" min="0" /><span asp-validation-for="SortOrder" class="field-error"></span><div class="form-actions"><button class="button" type="submit">Guardar</button><a class="button secondary" asp-action="Index">Cancelar</a></div></form></div><aside class="data-editor-context"><p class="eyebrow">Contexto</p><h2>Estrutura das categorias</h2><p>Os grupos são o nível superior da classificação financeira e agregam categorias com a mesma natureza.</p><ul class="data-editor-context-list"><li><strong>Património</strong>Agrupa ativos, passivos e outras posições patrimoniais.</li><li><strong>Rendimento</strong>Agrupa origens de rendimento usadas na análise e orçamento.</li><li><strong>Despesa</strong>Agrupa destinos de despesa para acompanhamento e controlo.</li><li><strong>Ordem</strong>Define a posição do grupo na apresentação.</li></ul></aside></div></section>

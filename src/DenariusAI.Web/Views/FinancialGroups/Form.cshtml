@model FinancialGroupFormViewModel
@{ var editing = Model.Id != Guid.Empty; ViewData["Title"] = editing ? "Editar grupo" : "Novo grupo"; }
<link rel="stylesheet" href="~/css/data-forms.css" asp-append-version="true" />
<div class="page-header"><div><p class="eyebrow">Configuração · Grupos</p><h1>@ViewData["Title"]</h1><p class="page-subtitle">@(editing ? "Atualize a identificação, o tipo e a ordem deste grupo financeiro." : "Crie um grupo para agregar categorias com a mesma finalidade financeira.")</p></div><a class="button secondary" asp-action="Index">Voltar</a></div>
<section class="panel"><form asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@(editing ? Model.Id : null)" method="post" class="form-stack"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><label asp-for="Name"></label><input asp-for="Name" autofocus /><span asp-validation-for="Name" class="field-error"></span><label asp-for="Description"></label><textarea asp-for="Description" rows="3"></textarea><span asp-validation-for="Description" class="field-error"></span><label asp-for="Kind"></label><select asp-for="Kind"><option value="1">Património</option><option value="2">Rendimento</option><option value="3">Despesa</option></select><span asp-validation-for="Kind" class="field-error"></span><label asp-for="SortOrder"></label><input asp-for="SortOrder" min="0" /><span asp-validation-for="SortOrder" class="field-error"></span><div class="form-actions"><button class="button" type="submit">Guardar</button><a class="button secondary" asp-action="Index">Cancelar</a></div></form></section>

@model AuditIndexViewModel
@{ ViewData["Title"] = "Auditoria"; }
<link rel="stylesheet" href="~/css/audit.css" asp-append-version="true" />
<div class="page-header"><div><p class="eyebrow">Administração</p><h1>Auditoria</h1><p class="page-subtitle">@(Model.RecordId is null ? "Consulte as criações, alterações e eliminações efetuadas na aplicação." : "Histórico completo do registo selecionado. Escolha uma operação para consultar os respetivos detalhes.")</p></div>@if(Model.RecordId is not null){<a class="button secondary" asp-action="Index">Ver toda a auditoria</a>}</div>
<section class="panel entity-panel audit-panel"><form id="audit-filters" method="get" class="filterbar audit-filters">@if(Model.RecordId is not null){<input type="hidden" name="recordId" value="@Model.RecordId" />}<input type="search" name="search" value="@Model.Search" placeholder="Registo, identificador ou utilizador..." /><select name="entityType" asp-items="Model.EntityTypes"></select><select name="action" aria-label="Operação"><option value="">Todas as operações</option><option value="Created" selected="@(Model.Action == "Created")">Criações</option><option value="Updated" selected="@(Model.Action == "Updated")">Alterações</option><option value="Deleted" selected="@(Model.Action == "Deleted")">Eliminações</option></select><label>De <input type="date" name="from" value="@(Model.From?.ToString("yyyy-MM-dd"))" /></label><label>Até <input type="date" name="to" value="@(Model.To?.ToString("yyyy-MM-dd"))" /></label><label class="page-size">Por página <select name="pageSize">@foreach(var size in PaginationViewModel.AllowedPageSizes){<option value="@size" selected="@(size == Model.Pagination.PageSize)">@size</option>}</select></label><button class="button secondary" type="submit">Aplicar</button></form><div class="table-wrap"><table class="entity-table"><thead><tr><th>Data</th><th>Registo</th><th>Descrição</th><th>Operação</th><th>Utilizador</th><th class="actions">Ações</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td class="nowrap">@item.ChangedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td><td><strong>@item.EntityName</strong><small>@item.EntityId</small></td><td>@item.RecordLabel</td><td><span class="audit-action @item.Action.ToLowerInvariant()">@item.ActionName</span></td><td>@item.Actor</td><td class="actions"><a class="text-link" asp-action="Details" asp-route-id="@item.Id">Detalhes</a></td></tr>}@if(Model.Items.Count==0){<tr><td colspan="6" class="empty-row">Não foram encontrados registos de auditoria.</td></tr>}</tbody></table></div><nav class="pagination"><span>@Model.Pagination.FirstItem–@Model.Pagination.LastItem de @Model.Pagination.TotalItems</span><div><button class="pager-link" form="audit-filters" name="page" value="@(Model.Pagination.Page-1)" disabled="@(!Model.Pagination.HasPreviousPage)">Anterior</button><span>Página @Model.Pagination.Page de @Model.Pagination.TotalPages</span><button class="pager-link" form="audit-filters" name="page" value="@(Model.Pagination.Page+1)" disabled="@(!Model.Pagination.HasNextPage)">Seguinte</button></div></nav></section>

@model AuditDetailsViewModel
@{ ViewData["Title"] = "Detalhe da auditoria"; }
<link rel="stylesheet" href="~/css/audit.css" asp-append-version="true" />
<div class="page-header"><div><p class="eyebrow">Administração · Auditoria</p><h1>@Model.RecordLabel</h1><p class="page-subtitle">@Model.EntityName · @Model.ActionName em @Model.ChangedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") por @Model.Actor</p></div><a class="button secondary" asp-action="Index">Voltar</a></div>
<section class="panel audit-details"><dl><div><dt>Tipo de registo</dt><dd>@Model.EntityName</dd></div><div><dt>Identificador</dt><dd><code>@Model.EntityId</code></dd></div><div><dt>Operação</dt><dd>@Model.ActionName</dd></div><div><dt>Utilizador</dt><dd>@Model.Actor</dd></div></dl><div class="table-wrap"><table><thead><tr><th>Campo</th><th>Valor anterior</th><th>Valor posterior</th></tr></thead><tbody>@foreach(var change in Model.Changes){<tr><td><strong>@change.FieldName</strong></td><td>@(change.Before ?? "—")</td><td>@(change.After ?? "—")</td></tr>}@if(Model.Changes.Count==0){<tr><td colspan="3" class="empty-row">Esta operação não contém campos de negócio para apresentar.</td></tr>}</tbody></table></div></section>

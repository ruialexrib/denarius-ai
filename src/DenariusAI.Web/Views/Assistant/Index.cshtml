@model AssistantPageViewModel
@using DenariusAI.Infrastructure.Identity
@{ ViewData["Title"] = "Assistente"; }
<div class="assistant-page">
<header class="assistant-header"><div><p class="eyebrow">Inteligência Artificial</p><h1>Assistente financeiro</h1><p>Transforme os seus dados em respostas claras e decisões mais informadas.</p></div><div class="assistant-status"><span>Somente leitura</span><span class="assistant-model"><i class="@(Model.IsAvailable ? "online" : null)"></i>@Model.Model</span></div></header>
<section class="assistant-shell">
<div id="assistantMessages" class="assistant-messages" aria-live="polite">
<div class="assistant-welcome"><div class="assistant-intro"><span class="assistant-orb">✦</span><p class="eyebrow">O seu copiloto financeiro</p><h2>O que quer compreender hoje?</h2><p>Analiso movimentos, orçamento, poupança e reconciliação sem alterar os seus dados.</p><div class="assistant-trust"><span>✓ Dados privados</span><span>✓ Respostas fundamentadas</span><span>✓ Sem alterações automáticas</span></div></div><div class="assistant-suggestions"><button type="button" data-question="Quanto gastei este mês?"><span>↘</span><strong>Despesas do mês</strong><small>Quanto gastei este mês?</small></button><button type="button" data-question="Estou acima do orçamento?"><span>▦</span><strong>Estado do orçamento</strong><small>Estou acima do orçamento?</small></button><button type="button" data-question="Qual é a minha taxa de poupança?"><span>◇</span><strong>Taxa de poupança</strong><small>Como está a evoluir?</small></button><button type="button" data-question="Que movimentos falta reconciliar?"><span>✓</span><strong>Reconciliação</strong><small>O que ainda está pendente?</small></button><button type="button" data-question="Quais foram as maiores despesas do ano?"><span>⌁</span><strong>Principais tendências</strong><small>Maiores despesas do ano</small></button><button type="button" data-question="Resume a minha situação financeira atual."><span>✦</span><strong>Resumo financeiro</strong><small>Uma visão consolidada</small></button></div></div>
</div>
<div class="assistant-composer">
@if (!Model.IsAvailable) { <div class="assistant-unavailable">@if (User.IsInRole(ApplicationRoles.Administrator)) { <text>A integração de IA ainda não está configurada. <a asp-controller="Settings" asp-action="Index" asp-fragment="ai">Abrir Definições</a></text> } else { <text>A integração de IA ainda não está configurada. Contacte um administrador para a configurar.</text> }</div> }
<form id="assistantForm"><div class="assistant-input-wrap"><span class="composer-spark" aria-hidden="true">✦</span><textarea id="assistantQuestion" maxlength="1000" rows="1" placeholder="Pergunte sobre despesas, orçamento ou poupança…" disabled="@(!Model.IsAvailable)"></textarea><button type="submit" aria-label="Enviar pergunta" disabled="@(!Model.IsAvailable)">↑</button></div><div class="assistant-caption"><span>As respostas são informativas e baseadas nos dados disponíveis.</span><span id="assistantCounter">0 / 1000</span></div>@Html.AntiForgeryToken()</form>
</div></section></div>
@section Scripts { <script src="~/js/assistant.js" asp-append-version="true"></script> }

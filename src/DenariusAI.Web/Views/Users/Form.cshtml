@model UserFormViewModel
@{ var editing = !string.IsNullOrWhiteSpace(Model.Id); ViewData["Title"] = editing ? "Editar utilizador" : "Novo utilizador"; }
<link rel="stylesheet" href="~/css/data-forms.css" asp-append-version="true" />
<div class="page-header"><div><p class="eyebrow">Administração · Utilizadores</p><h1>@ViewData["Title"]</h1><p class="page-subtitle">@(editing ? "Atualize a identidade, permissão ou palavra-passe deste utilizador." : "Crie credenciais e atribua o nível de acesso inicial.")</p></div><a class="button secondary" asp-action="Index">Voltar</a></div>
<section class="data-editor"><div class="data-editor-grid"><div class="data-editor-main">@if (editing) { <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="form-stack"><input asp-for="Id" type="hidden" /><partial name="_UserFormFields" model="Model" /></form> } else { <form asp-action="Create" method="post" class="form-stack"><input asp-for="Id" type="hidden" /><partial name="_UserFormFields" model="Model" /></form> }</div><aside class="data-editor-context"><p class="eyebrow">Contexto</p><h2>Acesso à aplicação</h2><p>Defina a identidade e o nível de acesso do utilizador. As permissões administrativas devem ser atribuídas apenas quando necessárias.</p><ul class="data-editor-context-list"><li><strong>Utilizador</strong>Acesso às funcionalidades normais de gestão financeira autorizadas.</li><li><strong>Administrador</strong>Inclui acesso às áreas administrativas e de configuração protegidas.</li><li><strong>Palavra-passe</strong>Na edição, deixe o campo vazio para manter a palavra-passe atual.</li></ul></aside></div></section>

@model UserFormViewModel
@{ var editing = !string.IsNullOrWhiteSpace(Model.Id); }
<div asp-validation-summary="ModelOnly" class="validation-summary"></div>
<label asp-for="DisplayName"></label><input asp-for="DisplayName" autofocus /><span asp-validation-for="DisplayName" class="field-error"></span>
<label asp-for="Email"></label><input asp-for="Email" type="email" autocomplete="off" /><span asp-validation-for="Email" class="field-error"></span>
<label asp-for="Role"></label><select asp-for="Role"><option value="User">Utilizador</option><option value="Administrator">Administrador</option></select><span asp-validation-for="Role" class="field-error"></span>
<label asp-for="Password">@(editing ? "Nova palavra-passe (opcional)" : "Palavra-passe inicial")</label><input asp-for="Password" type="password" autocomplete="new-password" /><span asp-validation-for="Password" class="field-error"></span>
<p class="form-help">Mínimo de 12 caracteres, com maiúscula, minúscula, número e símbolo.</p>
<div class="form-actions"><button class="button" type="submit">Guardar</button><a class="button secondary" asp-action="Index">Cancelar</a></div>

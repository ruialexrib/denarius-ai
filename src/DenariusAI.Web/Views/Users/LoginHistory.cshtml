@model UserLoginHistoryViewModel
@{ ViewData["Title"] = "Histórico de acessos"; var lisbonTime = TimeZoneInfo.FindSystemTimeZoneById("Europe/Lisbon"); var distinctUsers = Model.Items.Select(item => item.Email).Distinct(StringComparer.OrdinalIgnoreCase).Count(); var todayCount = Model.Items.Count(item => TimeZoneInfo.ConvertTime(item.LoggedInAt, lisbonTime).Date == DateTime.Today); }
<link rel="stylesheet" href="~/css/summary-cards.css" asp-append-version="true" />
<div class="page-header"><div><p class="eyebrow">Administração · Segurança</p><h1>Histórico de acessos</h1><p class="page-subtitle">Últimos acessos efetuados por todos os utilizadores da aplicação.</p></div><a class="button secondary" asp-action="Index">Voltar aos utilizadores</a></div>
<section class="area-summary three" aria-label="Resumo do histórico de acessos"><article class="summary-primary"><span>Acessos encontrados</span><strong>@Model.Pagination.TotalItems</strong><small>Total correspondente aos filtros atuais</small></article><article class="summary-positive"><span>Hoje nesta página</span><strong>@todayCount</strong><small>Acessos efetuados na data atual</small></article><article class="summary-info"><span>Utilizadores nesta página</span><strong>@distinctUsers</strong><small>Contas distintas nos resultados apresentados</small></article></section>
<section class="panel entity-panel login-history-panel"><form id="login-history-filters" method="get" class="filterbar login-history-filters"><label>De <input type="date" name="from" value="@(Model.From?.ToString("yyyy-MM-dd"))" /></label><label>Até <input type="date" name="to" value="@(Model.To?.ToString("yyyy-MM-dd"))" /></label><input type="search" name="search" value="@Model.Search" placeholder="Utilizador, email ou endereço IP…" /><label class="page-size">Por página <select name="pageSize">@foreach (var size in PaginationViewModel.AllowedPageSizes) { <option value="@size" selected="@(size == Model.Pagination.PageSize)">@size</option> }</select></label><button class="button secondary" type="submit">Aplicar filtros</button>@if(Model.From.HasValue || Model.To.HasValue || !string.IsNullOrWhiteSpace(Model.Search)){<a class="text-link" asp-action="LoginHistory">Limpar</a>}</form><div class="login-history-summary"><span><strong>@Model.Pagination.TotalItems</strong> acessos encontrados</span><span>Ordenação: mais recente primeiro</span></div><div class="table-wrap"><table class="entity-table"><thead><tr><th>Utilizador</th><th>Data e hora</th><th>Endereço IP</th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr><td><strong>@item.DisplayName</strong><small>@item.Email</small></td><td><time datetime="@item.LoggedInAt.ToString("O")">@TimeZoneInfo.ConvertTime(item.LoggedInAt, lisbonTime).ToString("dd/MM/yyyy HH:mm:ss")</time></td><td><code>@item.IpAddress</code></td></tr> }@if (Model.Items.Count == 0) { <tr><td colspan="3" class="empty-row">Não foram encontrados acessos com estes filtros.</td></tr> }</tbody></table></div>@if (Model.Pagination.TotalPages > 1) { <nav class="pagination" aria-label="Paginação"><span>Página @Model.Pagination.Page de @Model.Pagination.TotalPages</span><div><button class="button secondary" type="submit" form="login-history-filters" name="page" value="@(Model.Pagination.Page - 1)" disabled="@(Model.Pagination.Page <= 1)">Anterior</button><button class="button secondary" type="submit" form="login-history-filters" name="page" value="@(Model.Pagination.Page + 1)" disabled="@(Model.Pagination.Page >= Model.Pagination.TotalPages)">Seguinte</button></div></nav> }</section>

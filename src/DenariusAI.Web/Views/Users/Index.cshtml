@model UserIndexViewModel
@{ ViewData["Title"] = "Utilizadores"; var administratorCount = Model.Items.Count(item => item.Role == "Administrator"); var standardCount = Model.Items.Count - administratorCount; }
<link rel="stylesheet" href="~/css/summary-cards.css" asp-append-version="true" />
<div class="page-header"><div><p class="eyebrow">Administração</p><h1>Utilizadores</h1><p class="page-subtitle">Crie contas de acesso e controle quem pode administrar a aplicação.</p></div><div class="form-actions"><a class="button secondary" asp-action="LoginHistory">Histórico de acessos</a><a class="button" asp-action="Create">Novo utilizador</a></div></div>
<section class="area-summary three" aria-label="Resumo dos utilizadores"><article class="summary-primary"><span>Contas configuradas</span><strong>@Model.Items.Count</strong><small>Utilizadores com acesso à aplicação</small></article><article class="summary-positive"><span>Administradores</span><strong>@administratorCount</strong><small>Contas com permissões administrativas</small></article><article><span>Utilizadores</span><strong>@standardCount</strong><small>Contas com permissões standard</small></article></section>
<section class="panel entity-panel users-panel"><div class="users-summary"><span><strong>@Model.Items.Count</strong> contas configuradas</span><span>Gestão de acesso à aplicação</span></div><div class="table-wrap"><table class="entity-table users-table"><thead><tr><th>Utilizador</th><th>Email</th><th>Permissão</th><th class="actions">Ações</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td><div class="user-list-identity"><span class="user-list-avatar">@item.DisplayName.Trim().FirstOrDefault().ToString().ToUpperInvariant()</span><div><strong>@item.DisplayName</strong>@if(item.IsCurrentUser){<small>Sessão atual</small>}</div></div></td><td>@item.Email</td><td><span class="status @(item.Role == "Administrator" ? "active" : "pending")">@(item.Role == "Administrator" ? "Administrador" : "Utilizador")</span></td><td class="actions"><a class="text-link" asp-action="Edit" asp-route-id="@item.Id">Editar</a>@if(!item.IsCurrentUser){<form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Eliminar este utilizador permanentemente?')"><button class="text-link danger-link" type="submit">Eliminar</button></form>}@await Html.PartialAsync("_AuditLink", new AuditLinkViewModel("ApplicationUser", item.Id))</td></tr>}</tbody></table></div></section>

@model UserIndexViewModel
@{ ViewData["Title"] = "Utilizadores"; }
<div class="page-header"><div><p class="eyebrow">Administração</p><h1>Utilizadores</h1><p class="page-subtitle">Crie contas de acesso e controle quem pode administrar a aplicação.</p></div><a class="button" asp-action="Create">Novo utilizador</a></div>
<section class="panel"><div class="table-wrap"><table><thead><tr><th>Utilizador</th><th>Email</th><th>Permissão</th><th class="actions">Ações</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td><strong>@item.DisplayName</strong>@if(item.IsCurrentUser){<small>Sessão atual</small>}</td><td>@item.Email</td><td><span class="status @(item.Role == "Administrator" ? "active" : "pending")">@(item.Role == "Administrator" ? "Administrador" : "Utilizador")</span></td><td class="actions"><a class="text-link" asp-action="Edit" asp-route-id="@item.Id">Editar</a>@if(!item.IsCurrentUser){<form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Eliminar este utilizador permanentemente?')"><button class="text-link danger-link" type="submit">Eliminar</button></form>}</td></tr>}</tbody></table></div></section>

@model ApplicationSettingsViewModel
@{ ViewData["Title"] = "Definições da aplicação"; }
<link rel="stylesheet" href="~/css/market-data-settings.css" asp-append-version="true" />
<div class="page-header settings-header"><div><p class="eyebrow">Administração</p><h1>Definições da aplicação</h1><p>Parâmetros globais aplicados a todos os utilizadores.</p></div><span class="pill">Âmbito global</span></div>
<section class="settings-card settings-admin-actions"><div class="settings-card-heading"><span class="settings-icon">▤</span><div><h2>Operações globais</h2><p>Ações administrativas sobre os dados da aplicação.</p></div></div><div class="settings-data-grid"><article class="settings-option settings-operation test"><h3>Testar Mistral</h3><p>Confirma a credencial e o modelo atualmente guardado.</p><form asp-action="TestAiConnection" method="post"><button class="settings-operation-button test" type="submit" disabled="@(!Model.AiIsConfigured)"><span>Testar Ligação</span></button></form></article><article class="settings-option settings-operation demo"><h3>Dados de demonstração</h3><p>Carrega o cenário quando a base financeira está vazia.</p><a class="settings-operation-button demo" asp-action="LoadDemonstrationData"><span>Carregar Dados de Demonstração</span></a></article><article class="settings-option settings-operation danger"><h3>Reiniciar dados</h3><p>Elimina os dados financeiros para começar novamente.</p><a class="settings-operation-button danger" asp-action="ResetFinancialData"><span>Eliminar Todos os Dados</span></a></article></div></section>
<form asp-action="Index" method="post" class="settings-content"><div asp-validation-summary="ModelOnly" class="validation-summary"></div>
<section class="settings-card market-data-settings"><div class="settings-card-heading"><span class="settings-icon">▲</span><div><h2>Cotações de ações</h2><p>Fornecedor gratuito usado pela watchlist e pelo portfólio.</p></div></div><div class="field-grid"><div><label asp-for="MarketDataProvider">Fornecedor</label><select asp-for="MarketDataProvider"><option value="AlphaVantage">Alpha Vantage · plano gratuito</option></select></div><div><label asp-for="MarketDataBaseUrl">API base URL</label><input asp-for="MarketDataBaseUrl" /></div></div></section>
<section class="settings-card"><div class="settings-card-heading"><span class="settings-icon ai">✦</span><div><h2>Mistral AI</h2><p>Fornecedor, modelo e parâmetros de geração.</p></div></div><div class="field-grid"><div><label asp-for="MistralModel">Modelo</label><input asp-for="MistralModel" /></div><div><label asp-for="MistralBaseUrl">API base URL</label><input asp-for="MistralBaseUrl" /></div><div><label asp-for="MistralMaxTokens">Máximo de tokens</label><input asp-for="MistralMaxTokens" type="number" /></div><div><label asp-for="MistralTemperature">Temperatura</label><input asp-for="MistralTemperature" type="number" min="0" max="1" step="0.1" /></div></div></section>
<section class="settings-card"><div class="settings-card-heading"><span class="settings-icon ai">✓</span><div><h2>Teste de ligação</h2></div></div><label asp-for="ConnectionTestPrompt"></label><textarea asp-for="ConnectionTestPrompt" rows="3"></textarea></section>
<section class="settings-card"><div class="settings-card-heading"><span class="settings-icon ai">☀</span><div><h2>Boas-vindas do Dashboard</h2></div></div><label asp-for="DashboardWelcomePrompt"></label><textarea asp-for="DashboardWelcomePrompt" rows="7"></textarea></section>
<section class="settings-card"><div class="settings-card-heading"><span class="settings-icon ai">▥</span><div><h2>Análise financeira</h2></div></div><label asp-for="FinancialAnalysisPrompt"></label><textarea asp-for="FinancialAnalysisPrompt" rows="9"></textarea></section>
<section class="settings-card"><div class="settings-card-heading"><span class="settings-icon ai">⌗</span><div><h2>Metadados da correspondência</h2></div></div><label asp-for="CorrespondenceMetadataPrompt"></label><textarea asp-for="CorrespondenceMetadataPrompt" rows="10"></textarea></section>
<section class="settings-card"><div class="settings-card-heading"><span class="settings-icon ai">▣</span><div><h2>Preenchimento de seguros</h2><p>Instruções usadas para interpretar dados copiados e propor os campos de uma nova apólice.</p></div></div><label asp-for="InsuranceClipboardPrompt"></label><textarea asp-for="InsuranceClipboardPrompt" rows="11"></textarea><span asp-validation-for="InsuranceClipboardPrompt" class="field-error"></span><p class="form-help">A análise não grava dados; o utilizador revê o formulário e confirma a criação.</p></section>
<section class="settings-card"><div class="settings-card-heading"><span class="settings-icon ai">▣</span><div><h2>Preenchimento de Certificados de Aforro</h2><p>Instruções usadas para interpretar conteúdo copiado do AforroNet e propor os dados da subscrição.</p></div></div><label asp-for="SavingsCertificateClipboardPrompt"></label><textarea asp-for="SavingsCertificateClipboardPrompt" rows="11"></textarea><span asp-validation-for="SavingsCertificateClipboardPrompt" class="field-error"></span><p class="form-help">Preserve as propriedades JSON esperadas. A IA apenas propõe valores; o utilizador revê o formulário antes de guardar.</p></section>
<section class="settings-card"><div class="settings-card-heading"><span class="settings-icon ai">✦</span><div><h2>Assistente financeiro</h2></div></div><label asp-for="AssistantSystemPrompt">Prompt de sistema</label><textarea asp-for="AssistantSystemPrompt" rows="8"></textarea><div class="settings-parameter-grid"><div><label asp-for="AssistantContextMonths">Meses de contexto</label><input asp-for="AssistantContextMonths" type="number" /></div><div><label asp-for="AssistantMaxTransactions">Máximo de movimentos</label><input asp-for="AssistantMaxTransactions" type="number" /></div><div><label asp-for="AssistantHistoryMessages">Mensagens de histórico</label><input asp-for="AssistantHistoryMessages" type="number" /></div></div></section>
<section class="settings-card"><div class="settings-card-heading"><span class="settings-icon ai">✦</span><div><h2>Sugestão de movimentos</h2></div></div><label asp-for="JournalSuggestionSystemPrompt">Prompt de sistema</label><textarea asp-for="JournalSuggestionSystemPrompt" rows="11"></textarea><div class="settings-parameter-grid"><div><label asp-for="JournalSuggestionHistoryMessages">Mensagens de histórico</label><input asp-for="JournalSuggestionHistoryMessages" type="number" /></div></div></section>
<section id="reconciliation-prompts" class="settings-card"><div class="settings-card-heading"><span class="settings-icon ai">✦</span><div><h2>Reconciliação assistida</h2></div></div><label asp-for="ReconciliationExtractionPrompt">Interpretação dos movimentos</label><textarea asp-for="ReconciliationExtractionPrompt" rows="11"></textarea><label asp-for="ReconciliationClassificationPrompt">Classificação contabilística</label><textarea asp-for="ReconciliationClassificationPrompt" rows="8"></textarea></section>
<div class="settings-savebar"><button class="button" type="submit">Guardar e aplicar definições</button><span>As alterações são aplicadas às próximas chamadas, sem reiniciar.</span></div></form>

@model ApplicationSettingsViewModel
@{ ViewData["Title"] = "Definições da aplicação"; }
<div class="page-header settings-header"><div><p class="eyebrow">Administração</p><h1>Definições da aplicação</h1><p>Parâmetros globais aplicados a todos os utilizadores.</p></div><span class="pill">Âmbito global</span></div>
<section class="settings-card settings-admin-actions"><div class="settings-card-heading"><span class="settings-icon">▤</span><div><h2>Operações globais</h2><p>Ações administrativas sobre os dados da aplicação.</p></div></div><div class="settings-data-grid"><article class="settings-option settings-operation test"><span class="operation-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m12 3 1.4 4.1 4.1 1.4-4.1 1.4L12 14l-1.4-4.1-4.1-1.4 4.1-1.4z"/><path d="m18.5 14 .8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8z"/></svg></span><h3>Testar Mistral</h3><p>Confirma a credencial e o modelo atualmente guardado.</p><form asp-action="TestAiConnection" method="post"><button class="settings-operation-button test" type="submit" disabled="@(!Model.AiIsConfigured)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3v5m8-5v5M6 8h12v2a6 6 0 0 1-6 6v5m-3 0h6"/></svg><span>Testar Ligação</span></button></form></article><article class="settings-option settings-operation demo"><span class="operation-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><ellipse cx="10" cy="5" rx="7" ry="3"/><path d="M3 5v6c0 1.7 3.1 3 7 3m7-9v5M3 11v6c0 1.7 3.1 3 7 3h1m7-7v8m-4-4h8"/></svg></span><h3>Dados de demonstração</h3><p>Carrega o cenário quando a base financeira está vazia.</p><a class="settings-operation-button demo" asp-action="LoadDemonstrationData"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 18H5a4 4 0 0 1-.4-8A7 7 0 0 1 18 8.5 4.5 4.5 0 0 1 19 17h-2"/><path d="M12 11v10m-4-4 4 4 4-4"/></svg><span>Carregar Dados de Demonstração</span></a></article><article class="settings-option settings-operation danger"><span class="operation-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 7h16M9 7V4h6v3m3 0-1 14H7L6 7m4 4v6m4-6v6"/></svg></span><h3>Reiniciar dados</h3><p>Elimina os dados financeiros para começar novamente.</p><a class="settings-operation-button danger" asp-action="ResetFinancialData"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 2.5 20h19z"/><path d="M12 9v5m0 3h.01"/></svg><span>Eliminar Todos os Dados</span></a></article></div></section>
<form asp-action="Index" method="post" class="settings-content"><div asp-validation-summary="ModelOnly" class="validation-summary"></div>
<section class="settings-card"><div class="settings-card-heading"><span class="settings-icon ai">✦</span><div><h2>Mistral AI</h2><p>Fornecedor, modelo e parâmetros de geração.</p></div><span class="status @(Model.AiIsConfigured ? "active" : "inactive")">@(Model.AiIsConfigured ? "Chave configurada" : "Chave em falta")</span></div><div class="field-grid"><div><label asp-for="MistralModel">Modelo</label><input asp-for="MistralModel" /><span asp-validation-for="MistralModel" class="field-error"></span></div><div><label asp-for="MistralBaseUrl">API base URL</label><input asp-for="MistralBaseUrl" /><span asp-validation-for="MistralBaseUrl" class="field-error"></span></div><div><label asp-for="MistralMaxTokens">Máximo de tokens</label><input asp-for="MistralMaxTokens" type="number" /><span asp-validation-for="MistralMaxTokens" class="field-error"></span></div><div><label asp-for="MistralTemperature">Temperatura</label><input asp-for="MistralTemperature" type="number" min="0" max="1" step="0.1" /><span asp-validation-for="MistralTemperature" class="field-error"></span></div></div><p class="form-help">A API key mantém-se exclusivamente em MISTRAL_API_KEY e nunca é persistida.</p></section>
<section class="settings-card"><div class="settings-card-heading"><span class="settings-icon ai">☀</span><div><h2>Boas-vindas do Dashboard</h2><p>Instruções usadas para criar o resumo curto e contextual apresentado ao utilizador.</p></div></div><label asp-for="DashboardWelcomePrompt"></label><textarea asp-for="DashboardWelcomePrompt" rows="7"></textarea><span asp-validation-for="DashboardWelcomePrompt" class="field-error"></span><p class="form-help">A mensagem é gerada com indicadores agregados e fica em cache durante 30 minutos.</p></section>
<section class="settings-card"><div class="settings-card-heading"><span class="settings-icon ai">✦</span><div><h2>Assistente financeiro</h2><p>Prompt e limites do contexto enviado ao modelo.</p></div></div><label asp-for="AssistantSystemPrompt">Prompt de sistema</label><textarea asp-for="AssistantSystemPrompt" rows="8"></textarea><span asp-validation-for="AssistantSystemPrompt" class="field-error"></span><div class="settings-parameter-grid"><div><label asp-for="AssistantContextMonths">Meses de contexto</label><input asp-for="AssistantContextMonths" type="number" /></div><div><label asp-for="AssistantMaxTransactions">Máximo de movimentos</label><input asp-for="AssistantMaxTransactions" type="number" /></div><div><label asp-for="AssistantHistoryMessages">Mensagens de histórico</label><input asp-for="AssistantHistoryMessages" type="number" /></div></div></section>
<section class="settings-card"><div class="settings-card-heading"><span class="settings-icon ai">✦</span><div><h2>Sugestão de movimentos</h2><p>Prompt usado no preenchimento em linguagem natural.</p></div></div><label asp-for="JournalSuggestionSystemPrompt">Prompt de sistema</label><textarea asp-for="JournalSuggestionSystemPrompt" rows="11"></textarea><span asp-validation-for="JournalSuggestionSystemPrompt" class="field-error"></span><div class="settings-parameter-grid"><div><label asp-for="JournalSuggestionHistoryMessages">Mensagens de histórico</label><input asp-for="JournalSuggestionHistoryMessages" type="number" /></div></div></section>
<section class="settings-card"><div class="settings-card-heading"><span class="settings-icon ai">✦</span><div><h2>Reconciliação assistida</h2><p>Prompts usados para interpretar o texto colado e classificar os movimentos encontrados.</p></div></div><label asp-for="ReconciliationExtractionPrompt">Interpretação dos movimentos</label><textarea asp-for="ReconciliationExtractionPrompt" rows="9"></textarea><span asp-validation-for="ReconciliationExtractionPrompt" class="field-error"></span><label asp-for="ReconciliationClassificationPrompt">Classificação contabilística</label><textarea asp-for="ReconciliationClassificationPrompt" rows="8"></textarea><span asp-validation-for="ReconciliationClassificationPrompt" class="field-error"></span><p class="form-help">As alterações são usadas na próxima análise. Preserve os formatos JSON indicados nos prompts.</p></section><div class="settings-savebar"><button class="button" type="submit">Guardar e aplicar definições</button><span>As alterações são aplicadas às próximas chamadas, sem reiniciar.</span></div></form>

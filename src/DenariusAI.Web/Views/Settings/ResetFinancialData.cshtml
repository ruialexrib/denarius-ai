@model ResetFinancialDataViewModel
@{ ViewData["Title"] = "Reiniciar dados financeiros"; }
<link rel="stylesheet" href="~/css/data-forms.css" asp-append-version="true" />
<div class="page-header"><div><p class="eyebrow">Definições · Zona de perigo</p><h1>Começar de novo</h1><p class="page-subtitle">Elimine os dados financeiros existentes para recomeçar com uma base financeira vazia.</p></div></div>
<section class="data-editor"><div class="data-editor-grid"><div class="data-editor-main"><form asp-action="ResetFinancialData" method="post" class="form-stack" onsubmit="return confirm('Confirma a eliminação permanente de todos os dados financeiros?')">
<div asp-validation-summary="ModelOnly" class="validation-summary"></div>
<label asp-for="Password"></label><input asp-for="Password" autocomplete="current-password" /><span asp-validation-for="Password" class="field-error"></span>
<label asp-for="Confirmation"></label><input asp-for="Confirmation" autocomplete="off" placeholder="APAGAR TUDO" /><span asp-validation-for="Confirmation" class="field-error"></span>
<p class="form-help">Escreva exatamente <strong>APAGAR TUDO</strong>.</p>
<div class="form-actions"><button class="button danger" type="submit">Eliminar dados e começar de novo</button><a class="button secondary" asp-action="Index">Cancelar</a></div>
</form></div>
<aside class="data-editor-context"><p class="eyebrow">Contexto</p><h2>Antes de eliminar os dados</h2><p>Esta operação remove permanentemente os dados financeiros associados à sua utilização do Denarius AI e permite começar de novo com uma base financeira vazia.</p><ul class="data-editor-context-list"><li><strong>Operação irreversível</strong>Os dados eliminados não podem ser recuperados através desta operação.</li><li><strong>Confirmação explícita</strong>É necessário indicar a palavra-passe atual e escrever exatamente APAGAR TUDO.</li><li><strong>Proteção adicional</strong>Antes do envio será apresentada uma confirmação final da operação.</li><li><strong>Recomeçar</strong>Depois da eliminação pode voltar a configurar a sua estrutura financeira ou carregar dados de demonstração.</li></ul></aside>
</div></section>

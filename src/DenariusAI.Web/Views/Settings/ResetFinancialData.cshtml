@model ResetFinancialDataViewModel
@{ ViewData["Title"] = "Reiniciar dados financeiros"; }
<div class="page-header"><div><p class="eyebrow">Definições · Zona de perigo</p><h1>Começar de novo</h1></div></div><section class="panel narrow danger-zone"><div class="panel-heading"><h2>Eliminar todos os dados financeiros</h2><p>Esta operação é permanente e não pode ser desfeita.</p></div><form asp-action="ResetFinancialData" method="post" class="form-stack" onsubmit="return confirm('Confirma a eliminação permanente de todos os dados financeiros?')"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><label asp-for="Password"></label><input asp-for="Password" autocomplete="current-password" /><span asp-validation-for="Password" class="field-error"></span><label asp-for="Confirmation"></label><input asp-for="Confirmation" autocomplete="off" placeholder="APAGAR TUDO" /><span asp-validation-for="Confirmation" class="field-error"></span><p class="form-help">Escreva exatamente <strong>APAGAR TUDO</strong>.</p><div class="form-actions"><button class="button danger" type="submit">Eliminar dados e começar de novo</button><a class="button secondary" asp-action="Index">Cancelar</a></div></form></section>

@model AnalyticsViewModel
@using System.Globalization
@{
    var invariant = CultureInfo.InvariantCulture;
    var moneyMax = Math.Max(Model.AnnualIncomeExpenses.SelectMany(item => new[] { item.Income, item.Expenses }).DefaultIfEmpty(0m).Max(), 1m);
    var budgetMax = Math.Max(Model.AnnualBudgetExecution.SelectMany(item => new[] { item.Budgeted, item.Actual }).DefaultIfEmpty(0m).Max(), 1m);
    string Points(IEnumerable<decimal> values, decimal max) => string.Join(" ", values.Select((value, index) => $"{45 + index * 75},{(225 - value / max * 180m).ToString(invariant)}"));
}
<section class="annual-analysis-charts" aria-label="Evolução financeira anual">
<article class="panel annual-analysis-chart"><div class="panel-title"><div><p class="eyebrow">Ano @DateTime.Today.Year</p><h2>Rendimentos e despesas</h2></div></div><div class="line-chart-scroll"><svg viewBox="0 0 915 245" class="analysis-line-chart" role="img" aria-label="Evolução mensal de rendimentos e despesas">@for(var grid=0;grid<5;grid++){<line x1="45" y1="@(45+grid*45)" x2="870" y2="@(45+grid*45)" class="analysis-grid-line" />}<polyline points="@Points(Model.AnnualIncomeExpenses.Select(item=>item.Income),moneyMax)" class="analysis-income-line" /><polyline points="@Points(Model.AnnualIncomeExpenses.Select(item=>item.Expenses),moneyMax)" class="analysis-expense-line" />@for(var i=0;i<Model.AnnualIncomeExpenses.Count;i++){var item=Model.AnnualIncomeExpenses[i];var x=45+i*75;var iy=225-item.Income/moneyMax*180m;var ey=225-item.Expenses/moneyMax*180m;<circle cx="@x" cy="@iy.ToString(invariant)" r="4" class="analysis-income-point"><title>@item.Label · Rendimentos @item.Income.ToString("N2") €</title></circle>@Html.Raw($"<text x=\"{x}\" y=\"{(iy-10).ToString(invariant)}\" class=\"analysis-value-label income-label\">{item.Income:N0} €</text>")<circle cx="@x" cy="@ey.ToString(invariant)" r="4" class="analysis-expense-point"><title>@item.Label · Despesas @item.Expenses.ToString("N2") €</title></circle>@Html.Raw($"<text x=\"{x}\" y=\"{(ey+16).ToString(invariant)}\" class=\"analysis-value-label expense-label\">{item.Expenses:N0} €</text>")}</svg></div><div class="analysis-months">@foreach(var item in Model.AnnualIncomeExpenses){<span>@(new DateTime(item.Year,item.Month,1).ToString("MMM",CultureInfo.GetCultureInfo("pt-PT")))</span>}</div><div class="chart-legend"><span class="income">Rendimentos</span><span class="expenses">Despesas</span></div></article>
<article class="panel annual-analysis-chart"><div class="panel-title"><div><p class="eyebrow">Ano @DateTime.Today.Year</p><h2>Orçamentado e executado</h2></div></div><div class="line-chart-scroll"><svg viewBox="0 0 915 245" class="analysis-line-chart" role="img" aria-label="Evolução mensal do orçamento e execução">@for(var grid=0;grid<5;grid++){<line x1="45" y1="@(45+grid*45)" x2="870" y2="@(45+grid*45)" class="analysis-grid-line" />}<polyline points="@Points(Model.AnnualBudgetExecution.Select(item=>item.Budgeted),budgetMax)" class="analysis-budget-line" /><polyline points="@Points(Model.AnnualBudgetExecution.Select(item=>item.Actual),budgetMax)" class="analysis-actual-line" />@for(var i=0;i<Model.AnnualBudgetExecution.Count;i++){var item=Model.AnnualBudgetExecution[i];var x=45+i*75;var by=225-item.Budgeted/budgetMax*180m;var ay=225-item.Actual/budgetMax*180m;<circle cx="@x" cy="@by.ToString(invariant)" r="4" class="analysis-budget-point"><title>@item.Label · Orçamentado @item.Budgeted.ToString("N2") €</title></circle>@Html.Raw($"<text x=\"{x}\" y=\"{(by-10).ToString(invariant)}\" class=\"analysis-value-label budget-label\">{item.Budgeted:N0} €</text>")<circle cx="@x" cy="@ay.ToString(invariant)" r="4" class="analysis-actual-point"><title>@item.Label · Executado @item.Actual.ToString("N2") €</title></circle>@Html.Raw($"<text x=\"{x}\" y=\"{(ay+16).ToString(invariant)}\" class=\"analysis-value-label actual-label\">{item.Actual:N0} €</text>")}</svg></div><div class="analysis-months">@foreach(var item in Model.AnnualBudgetExecution){<span>@(new DateTime(item.Year,item.Month,1).ToString("MMM",CultureInfo.GetCultureInfo("pt-PT")))</span>}</div><div class="analysis-budget-legend"><span class="budgeted">Orçamentado</span><span class="actual">Executado</span></div></article>
</section>

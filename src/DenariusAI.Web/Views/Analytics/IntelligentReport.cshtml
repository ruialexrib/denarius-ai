@model IntelligentReportViewModel
@using DenariusAI.Web.Models
@{ ViewData["Title"] = "Relatório financeiro inteligente"; }
<link rel="stylesheet" href="~/css/intelligent-workflows.css" asp-append-version="true" />
<section class="report-hero">
    <div class="report-hero-icon" aria-hidden="true">✦</div>
    <div class="report-hero-copy"><p class="eyebrow">Análise · Inteligência Artificial</p><h1>Relatório financeiro inteligente</h1><p>Análise consolidada das suas finanças, com tendências, riscos, oportunidades e recomendações para o período selecionado.</p><div class="report-period"><span>Período analisado</span><strong>@Model.From.ToString("dd/MM/yyyy")</strong><i aria-hidden="true">→</i><strong>@Model.To.ToString("dd/MM/yyyy")</strong></div></div>
    <div class="report-actions"><a class="button report-back" asp-action="Index" asp-route-from="@Model.From" asp-route-to="@Model.To">← Voltar à análise</a><div class="report-export-actions"><form asp-action="ExportMarkdown" method="post" data-no-progress="true"><input type="hidden" name="from" value="@Model.From" /><input type="hidden" name="to" value="@Model.To" /><textarea name="markdown" hidden>@Model.Markdown</textarea><button class="button report-export" type="submit"><span aria-hidden="true">↓</span> Markdown</button></form><form asp-action="ExportPdf" method="post" data-no-progress="true"><input type="hidden" name="from" value="@Model.From" /><input type="hidden" name="to" value="@Model.To" /><textarea name="markdown" hidden>@Model.Markdown</textarea><button class="button report-export report-export-pdf" type="submit"><span aria-hidden="true">▣</span> PDF</button></form></div></div>
</section>
<section class="intelligent-report">
    <aside class="report-sidebar"><div class="report-status"><span class="report-status-dot"></span><div><small>Estado</small><strong>Relatório concluído</strong></div></div><dl><div><dt>Gerado em</dt><dd>@Model.GeneratedAt</dd></div><div><dt>Modelo de IA</dt><dd>@Model.Model</dd></div><div><dt>Intervalo</dt><dd>@((Model.To.DayNumber - Model.From.DayNumber) + 1) dias</dd></div></dl><div class="report-note"><span aria-hidden="true">◎</span><p>As conclusões são apoio à decisão. Confirme sempre os dados antes de tomar decisões financeiras.</p></div></aside>
    <div class="report-document"><div class="report-document-heading"><div><span>DenariusAI</span><h2>Análise consolidada</h2></div><span class="report-ai-badge">✦ Gerado por IA</span></div><details class="markdown-source report-source-top"><summary><span>‹/›</span> Ver Markdown original</summary><pre>@Model.Markdown</pre></details><article class="markdown-preview">@Html.Raw(MarkdownPreview.Render(Model.Markdown))</article></div>
</section>

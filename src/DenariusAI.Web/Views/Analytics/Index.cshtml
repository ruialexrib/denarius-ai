@model AnalyticsViewModel
@using System.Globalization
@{ ViewData["Title"] = "Análise Financeira"; var data = Model.Analytics; var maxCategory = Math.Max(data.Categories.Select(item => item.Amount).DefaultIfEmpty(0m).Max(), 1m); var maxTrend = Math.Max(data.Trend.Select(item => Math.Max(item.Income, item.Expenses)).DefaultIfEmpty(0m).Max(), 1m); }
<link rel="stylesheet" href="~/css/analytics.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/financial-enhancements.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/searchable-select.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/cards.css" asp-append-version="true" />
<div class="page-header"><div><p class="eyebrow">Análise</p><h1>Análise Financeira</h1><p class="page-subtitle">Explore rendimentos, despesas, poupança e evolução patrimonial.</p></div></div>
<section class="analytics-kpis" aria-label="Indicadores da análise"><article class="kpi-featured"><span>Poupança</span><strong class="@(data.Savings < 0 ? "negative" : "positive")">@data.Savings.ToString("N2") €</strong><small>Taxa @data.SavingsRate.ToString("N1")% · anterior @data.PreviousSavingsRate.ToString("N1")%</small></article><article class="income-kpi"><span>Rendimentos</span><strong class="positive">@data.Income.ToString("N2") €</strong><small>@(data.IncomeChange.HasValue ? $"{(data.IncomeChange >= 0 ? "+" : "")}{data.IncomeChange:N1}% face ao período anterior" : $"Anterior: {data.PreviousIncome:N2} €")</small></article><article class="expense-kpi"><span>Despesas</span><strong class="negative">@data.Expenses.ToString("N2") €</strong><small>@(data.ExpensesChange.HasValue ? $"{(data.ExpensesChange >= 0 ? "+" : "")}{data.ExpensesChange:N1}% face ao período anterior" : $"Anterior: {data.PreviousExpenses:N2} €")</small></article><article><span>Património</span><strong>@data.NetWorth.ToString("N2") €</strong><small>Inclui Certificados de Aforro</small></article></section>
<section class="panel analytics-filter-panel"><div class="filter-heading"><span>Período e filtros</span><small>Refine os dados apresentados</small></div><form method="get" class="analytics-filters"><label>De<input type="date" name="from" value="@Model.Filter.From.ToString("yyyy-MM-dd")" /></label><label>Até<input type="date" name="to" value="@Model.Filter.To.ToString("yyyy-MM-dd")" /></label><select name="groupId" asp-items="Model.Groups" aria-label="Grupo"></select><select name="categoryId" asp-items="Model.Categories" aria-label="Categoria" class="searchable-select-control" data-search-placeholder="Pesquisar categoria…" data-search-empty-text="Nenhuma categoria encontrada" data-search-include-empty="true"></select><select name="accountId" asp-items="Model.Accounts" aria-label="Conta"></select><button class="button secondary" type="submit">Aplicar filtros</button></form></section>
<section class="analytics-ai-cta"><div class="analytics-ai-icon" aria-hidden="true">✦</div><div><span>Relatório inteligente</span><h2>Análise consolidada com IA</h2><p>Analise todas as tabelas financeiras no período selecionado. A IA produz um resumo executivo, identifica tendências, riscos e oportunidades e sugere ações. Pode rever o resultado formatado, consultar o Markdown original e exportar o relatório.</p></div><form asp-action="GenerateIntelligentReport" method="post" data-progress-message="A analisar os seus dados e a gerar o relatório…"><input type="hidden" name="from" value="@Model.Filter.From.ToString("yyyy-MM-dd")" /><input type="hidden" name="to" value="@Model.Filter.To.ToString("yyyy-MM-dd")" /><button class="button" type="submit">✦ Gerar relatório inteligente</button></form></section>
<partial name="_AnnualLineCharts" model="Model" />
<section class="analytics-insights"><article class="panel savings-insight"><div><p class="eyebrow">Comparação</p><h2>Evolução da poupança</h2></div><strong class="@(data.SavingsChange < 0 ? "negative" : "positive")">@data.SavingsChange.ToString("+0.00;-0.00;0.00") €</strong><span>face ao período anterior de @data.PreviousSavings.ToString("N2") €</span></article><article class="panel certificates-insight"><div class="panel-title"><div><p class="eyebrow">Poupanças</p><h2>Certificados de Aforro</h2></div><a class="text-link" asp-controller="SavingsCertificates" asp-action="Index">Gerir carteira</a></div><div><span>Valor atual<strong>@data.SavingsCertificatesValue.ToString("N2") €</strong></span><span>Valor futuro<strong>@data.SavingsCertificatesFutureValue.ToString("N2") €</strong></span><span>Juro projetado<strong class="positive">@data.SavingsCertificatesFutureNetInterest.ToString("N2") €</strong></span><span>Peso no património<strong>@(data.NetWorth == 0 ? "—" : $"{data.SavingsCertificatesValue / data.NetWorth * 100m:N1}%")</strong></span></div></article></section>
<section class="analytics-grid"><article class="panel"><div class="panel-title"><div><p class="eyebrow">Categorias</p><h2>Distribuição das despesas</h2></div></div>@if(data.Categories.Count==0){<p class="analytics-empty">Sem despesas no período.</p>}else{<div class="analytics-bars">@foreach(var item in data.Categories.Take(10)){<div><span><strong><partial name="_CategoryKindIcon" model="DenariusAI.Domain.Enums.FinancialGroupKind.Expense" /> @item.Name</strong><small>@item.Amount.ToString("N2") €</small></span><i><b style="width:@((Math.Max(item.Amount,0)/maxCategory*100).ToString(CultureInfo.InvariantCulture))%"></b></i></div>}</div>}</article>
<article class="panel"><div class="panel-title"><div><p class="eyebrow">Evolução</p><h2>Rendimentos e despesas</h2></div></div><div class="analytics-trend">@foreach(var item in data.Trend){<div><span><span class="analytics-column"><em>@item.Income.ToString("N0") €</em><i style="height:@((item.Income/maxTrend*100).ToString(CultureInfo.InvariantCulture))%"></i></span><span class="analytics-column"><em>@item.Expenses.ToString("N0") €</em><b style="height:@((item.Expenses/maxTrend*100).ToString(CultureInfo.InvariantCulture))%"></b></span></span><small>@item.Label</small></div>}</div><div class="chart-legend"><span class="income">Rendimentos</span><span class="expenses">Despesas</span></div></article></section>
<section class="analytics-grid"><article class="panel"><div class="panel-title"><div><p class="eyebrow">Grupos</p><h2>Despesas por grupo</h2></div></div><table><thead><tr><th>Grupo</th><th>Valor</th></tr></thead><tbody>@foreach(var item in data.Groups){<tr><td>@item.Name</td><td class="amount">@item.Amount.ToString("N2") €</td></tr>}@if(data.Groups.Count==0){<tr><td colspan="2" class="empty-row">Sem resultados.</td></tr>}</tbody></table></article><article class="panel"><div class="panel-title"><div><p class="eyebrow">Contas</p><h2>Movimento líquido por conta</h2></div></div><table><thead><tr><th>Conta</th><th>Variação</th></tr></thead><tbody>@foreach(var item in data.Accounts){<tr><td>@item.Name</td><td class="amount @(item.Amount<0?"negative":"positive")">@item.Amount.ToString("N2") €</td></tr>}@if(data.Accounts.Count==0){<tr><td colspan="2" class="empty-row">Sem resultados.</td></tr>}</tbody></table></article></section>
<section class="panel"><div class="panel-title"><div><p class="eyebrow">Poupanças</p><h2>Carteira de Certificados de Aforro</h2></div><a class="text-link" asp-controller="SavingsCertificates" asp-action="Index">Gerir carteira</a></div><div class="table-wrap"><table><thead><tr><th>Série/Número</th><th>Descrição</th><th>Investimento</th><th>Valor atual</th><th>Rendimento</th><th>Valor futuro</th></tr></thead><tbody>@foreach(var item in data.SavingsCertificates){<tr><td><strong>@item.SeriesNumber</strong></td><td>@item.Description</td><td class="amount">@item.InvestmentValue.ToString("N2") €</td><td class="amount">@item.CurrentValue.ToString("N2") €</td><td class="amount @(item.Yield < 0 ? "negative" : "positive")">@item.Yield.ToString("N2") €</td><td class="amount">@item.FutureValue.ToString("N2") €</td></tr>}@if(data.SavingsCertificates.Count==0){<tr><td colspan="6" class="empty-row">Sem Certificados de Aforro.</td></tr>}</tbody></table></div></section>
@section Scripts { <script src="~/js/searchable-select.js" asp-append-version="true"></script> }

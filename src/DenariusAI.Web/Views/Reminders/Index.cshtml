@model ReminderIndexViewModel
@{ ViewData["Title"] = "Lembretes"; }
<link rel="stylesheet" href="~/css/reminders.css" asp-append-version="true" />
<div class="page-header"><div><p class="eyebrow">Organização</p><h1>Lembretes</h1><p class="page-subtitle">Antecipe pagamentos, renovações e outros eventos importantes.</p></div><a class="button" asp-action="Create">Novo lembrete</a></div>
<section class="reminder-summary"><article class="reminder-active"><span>Alertas ativos</span><strong>@Model.ActiveCount</strong><small>Aguardam a sua confirmação</small></article><article class="reminder-scheduled"><span>Agendados</span><strong>@Model.ScheduledCount</strong><small>Ainda fora do período de aviso</small></article><article class="reminder-confirmed"><span>Confirmados</span><strong>@Model.AcknowledgedCount</strong><small>Já tomou conhecimento</small></article><article><span>Total registado</span><strong>@Model.TotalCount</strong><small>Todos os eventos criados</small></article></section>
<section class="panel reminder-list-panel"><form id="reminder-filters" method="get" class="filterbar reminder-filters"><input type="search" name="search" value="@Model.Search" placeholder="Pesquisar lembretes..." /><select name="status" aria-label="Estado"><option value="all" selected="@(Model.Status == "all")">Todos os estados</option><option value="active" selected="@(Model.Status == "active")">Por confirmar</option><option value="scheduled" selected="@(Model.Status == "scheduled")">Agendados</option><option value="acknowledged" selected="@(Model.Status == "acknowledged")">Confirmados</option></select><label>De <input type="date" name="from" value="@(Model.From?.ToString("yyyy-MM-dd"))" /></label><label>Até <input type="date" name="to" value="@(Model.To?.ToString("yyyy-MM-dd"))" /></label><button class="button secondary" type="submit">Aplicar filtros</button>@if(!string.IsNullOrWhiteSpace(Model.Search) || Model.Status != "all" || Model.From.HasValue || Model.To.HasValue){<a class="text-link clear-filters" asp-action="Index">Limpar</a>}</form><div class="table-wrap"><table class="reminder-table"><thead><tr><th>Evento</th><th>Data</th><th>Antecedência</th><th>Estado pessoal</th><th class="actions">Ações</th></tr></thead><tbody>
@foreach(var item in Model.Items){<tr class="@(item.IsAvailable && !item.IsAcknowledged ? "attention" : null)"><td><strong>@item.Text</strong><small>@(item.DaysRemaining < 0 ? $"Ocorreu há {-item.DaysRemaining} dias" : item.DaysRemaining == 0 ? "É hoje" : $"Daqui a {item.DaysRemaining} dias")</small></td><td class="nowrap">@item.EventDate.ToString("dd/MM/yyyy")</td><td>@item.NoticeDays dias</td><td>@if(item.IsAvailable && !item.IsAcknowledged){<span class="status pending">Por confirmar</span>}else if(item.IsAcknowledged){<span class="status active">Confirmado</span>}else{<span class="status inactive">Agendado</span>}</td><td class="actions">@if(item.IsAvailable && !item.IsAcknowledged){<form asp-action="Acknowledge" method="post"><input type="hidden" name="id" value="@item.Id" /><button class="text-link" type="submit">Tomei conhecimento</button></form>}<a class="text-link" asp-action="Edit" asp-route-id="@item.Id">Editar</a><form asp-action="Delete" method="post" onsubmit="return confirm('Remover este lembrete?')"><input type="hidden" name="id" value="@item.Id" /><button class="text-link danger-link" type="submit">Remover</button></form></td></tr>}
@if(Model.Items.Count==0){<tr><td colspan="5" class="empty-row">Não foram encontrados lembretes para estes filtros.</td></tr>}
</tbody></table></div></section>

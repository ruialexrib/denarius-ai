@model ReminderIndexViewModel
@{
    ViewData["Title"] = "Lembretes";

    var requestedView = Context.Request.Query["view"].ToString();
    var isCalendarView = string.Equals(requestedView, "calendar", StringComparison.OrdinalIgnoreCase);
    var today = DateOnly.FromDateTime(DateTime.Today);
    var monthStart = new DateOnly(today.Year, today.Month, 1);
    var requestedMonth = Context.Request.Query["month"].ToString();

    if (!string.IsNullOrWhiteSpace(requestedMonth) &&
        DateOnly.TryParseExact(
            $"{requestedMonth}-01",
            "yyyy-MM-dd",
            System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None,
            out var parsedMonth))
    {
        monthStart = parsedMonth;
    }

    var previousMonth = monthStart.AddMonths(-1);
    var nextMonth = monthStart.AddMonths(1);
    var firstCalendarDay = monthStart.AddDays(-(((int)monthStart.DayOfWeek + 6) % 7));
    var calendarDays = Enumerable.Range(0, 42).Select(offset => firstCalendarDay.AddDays(offset)).ToArray();
    var ptCulture = System.Globalization.CultureInfo.GetCultureInfo("pt-PT");
    var monthTitle = ptCulture.TextInfo.ToTitleCase(monthStart.ToString("MMMM yyyy", ptCulture));
}
<link rel="stylesheet" href="~/css/reminders.css" asp-append-version="true" />
<div class="page-header">
    <div>
        <p class="eyebrow">Organização</p>
        <h1>Lembretes</h1>
        <p class="page-subtitle">Antecipe pagamentos, renovações e outros eventos importantes.</p>
    </div>
    <a class="button" asp-action="Create">Novo lembrete</a>
</div>

<section class="reminder-summary">
    <article class="reminder-active"><span>Alertas ativos</span><strong>@Model.ActiveCount</strong><small>Aguardam a sua confirmação</small></article>
    <article class="reminder-scheduled"><span>Agendados</span><strong>@Model.ScheduledCount</strong><small>Ainda fora do período de aviso</small></article>
    <article class="reminder-confirmed"><span>Confirmados</span><strong>@Model.AcknowledgedCount</strong><small>Já tomou conhecimento</small></article>
    <article><span>Total registado</span><strong>@Model.TotalCount</strong><small>Todos os eventos criados</small></article>
</section>

<div class="reminder-view-switch" role="group" aria-label="Modo de visualização dos lembretes">
    <a class="reminder-view-option @(!isCalendarView ? "active" : null)"
       asp-action="Index"
       asp-route-view="list"
       asp-route-search="@Model.Search"
       asp-route-status="@Model.Status"
       asp-route-from="@(Model.From?.ToString("yyyy-MM-dd"))"
       asp-route-to="@(Model.To?.ToString("yyyy-MM-dd"))">Lista</a>
    <a class="reminder-view-option @(isCalendarView ? "active" : null)"
       asp-action="Index"
       asp-route-view="calendar"
       asp-route-month="@monthStart.ToString("yyyy-MM")"
       asp-route-search="@Model.Search"
       asp-route-status="@Model.Status"
       asp-route-from="@(Model.From?.ToString("yyyy-MM-dd"))"
       asp-route-to="@(Model.To?.ToString("yyyy-MM-dd"))">Calendário</a>
</div>

@if (isCalendarView)
{
    <section class="panel reminder-calendar-panel">
        <div class="reminder-calendar-toolbar">
            <div class="reminder-calendar-navigation" aria-label="Navegação do calendário">
                <a class="button secondary"
                   asp-action="Index"
                   asp-route-view="calendar"
                   asp-route-month="@previousMonth.ToString("yyyy-MM")"
                   asp-route-search="@Model.Search"
                   asp-route-status="@Model.Status"
                   asp-route-from="@(Model.From?.ToString("yyyy-MM-dd"))"
                   asp-route-to="@(Model.To?.ToString("yyyy-MM-dd"))"
                   aria-label="Mês anterior">‹</a>
                <a class="button secondary"
                   asp-action="Index"
                   asp-route-view="calendar"
                   asp-route-month="@today.ToString("yyyy-MM")"
                   asp-route-search="@Model.Search"
                   asp-route-status="@Model.Status"
                   asp-route-from="@(Model.From?.ToString("yyyy-MM-dd"))"
                   asp-route-to="@(Model.To?.ToString("yyyy-MM-dd"))">Hoje</a>
                <a class="button secondary"
                   asp-action="Index"
                   asp-route-view="calendar"
                   asp-route-month="@nextMonth.ToString("yyyy-MM")"
                   asp-route-search="@Model.Search"
                   asp-route-status="@Model.Status"
                   asp-route-from="@(Model.From?.ToString("yyyy-MM-dd"))"
                   asp-route-to="@(Model.To?.ToString("yyyy-MM-dd"))"
                   aria-label="Mês seguinte">›</a>
            </div>
            <h2>@monthTitle</h2>
        </div>

        <div class="reminder-calendar-scroll">
            <div class="reminder-calendar" role="grid" aria-label="Calendário mensal de lembretes">
                <div class="reminder-calendar-weekdays" role="row">
                    <div role="columnheader">Seg</div>
                    <div role="columnheader">Ter</div>
                    <div role="columnheader">Qua</div>
                    <div role="columnheader">Qui</div>
                    <div role="columnheader">Sex</div>
                    <div role="columnheader">Sáb</div>
                    <div role="columnheader">Dom</div>
                </div>
                <div class="reminder-calendar-grid">
                    @foreach (var day in calendarDays)
                    {
                        var dayReminders = Model.Items.Where(item => item.EventDate == day).ToList();
                        var isCurrentMonth = day.Month == monthStart.Month && day.Year == monthStart.Year;
                        var isToday = day == today;
                        <div class="reminder-calendar-day @(!isCurrentMonth ? "adjacent-month" : null) @(isToday ? "today" : null)" role="gridcell" aria-label="@day.ToString("D", ptCulture)">
                            <div class="reminder-calendar-day-heading">
                                <span class="reminder-calendar-day-number">@day.Day</span>
                                @if (isToday)
                                {
                                    <span class="reminder-calendar-today-label">Hoje</span>
                                }
                            </div>
                            <div class="reminder-calendar-events">
                                @foreach (var item in dayReminders)
                                {
                                    var statusClass = item.IsAcknowledged ? "confirmed" : item.IsAvailable ? "pending" : "scheduled";
                                    var statusLabel = item.IsAcknowledged ? "Confirmado" : item.IsAvailable ? "Por confirmar" : "Agendado";
                                    <a class="reminder-calendar-event @statusClass"
                                       asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       title="@item.Text — @statusLabel">
                                        <span class="reminder-calendar-event-title">@item.Text</span>
                                        <span class="reminder-calendar-event-status">@statusLabel</span>
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
}
else
{
    <section class="panel reminder-list-panel">
        <form id="reminder-filters" method="get" class="filterbar reminder-filters">
            <input type="hidden" name="view" value="list" />
            <input type="search" name="search" value="@Model.Search" placeholder="Pesquisar lembretes..." />
            <select name="status" aria-label="Estado">
                <option value="all" selected="@(Model.Status == "all")">Todos os estados</option>
                <option value="active" selected="@(Model.Status == "active")">Por confirmar</option>
                <option value="scheduled" selected="@(Model.Status == "scheduled")">Agendados</option>
                <option value="acknowledged" selected="@(Model.Status == "acknowledged")">Confirmados</option>
            </select>
            <label>De <input type="date" name="from" value="@(Model.From?.ToString("yyyy-MM-dd"))" /></label>
            <label>Até <input type="date" name="to" value="@(Model.To?.ToString("yyyy-MM-dd"))" /></label>
            <button class="button secondary" type="submit">Aplicar filtros</button>
            @if (!string.IsNullOrWhiteSpace(Model.Search) || Model.Status != "all" || Model.From.HasValue || Model.To.HasValue)
            {
                <a class="text-link clear-filters" asp-action="Index" asp-route-view="list">Limpar</a>
            }
        </form>
        <div class="table-wrap">
            <table class="reminder-table">
                <thead><tr><th>Evento</th><th>Data</th><th>Antecedência</th><th>Estado pessoal</th><th class="actions">Ações</th></tr></thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr class="@(item.IsAvailable && !item.IsAcknowledged ? "attention" : null)">
                            <td><strong>@item.Text</strong><small>@(item.DaysRemaining < 0 ? $"Ocorreu há {-item.DaysRemaining} dias" : item.DaysRemaining == 0 ? "É hoje" : $"Daqui a {item.DaysRemaining} dias")</small></td>
                            <td class="nowrap">@item.EventDate.ToString("dd/MM/yyyy")</td>
                            <td>@item.NoticeDays dias</td>
                            <td>
                                @if (item.IsAvailable && !item.IsAcknowledged)
                                {
                                    <span class="status pending">Por confirmar</span>
                                }
                                else if (item.IsAcknowledged)
                                {
                                    <span class="status active">Confirmado</span>
                                }
                                else
                                {
                                    <span class="status inactive">Agendado</span>
                                }
                            </td>
                            <td class="actions">
                                @if (item.IsAvailable && !item.IsAcknowledged)
                                {
                                    <form asp-action="Acknowledge" method="post">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button class="text-link" type="submit">Tomei conhecimento</button>
                                    </form>
                                }
                                <a class="text-link" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                                <form asp-action="Delete" method="post" onsubmit="return confirm('Remover este lembrete?')">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button class="text-link danger-link" type="submit">Remover</button>
                                </form>
                                @await Html.PartialAsync("_AuditLink", new AuditLinkViewModel("Reminder", item.Id.ToString()))
                            </td>
                        </tr>
                    }
                    @if (Model.Items.Count == 0)
                    {
                        <tr><td colspan="5" class="empty-row">Não foram encontrados lembretes para estes filtros.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

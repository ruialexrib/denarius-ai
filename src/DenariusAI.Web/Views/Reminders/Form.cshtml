@model ReminderFormViewModel
@{ var editing = Model.Id != Guid.Empty; ViewData["Title"] = editing ? "Editar lembrete" : "Novo lembrete"; }
<link rel="stylesheet" href="~/css/data-forms.css" asp-append-version="true" />
<div class="page-header"><div><p class="eyebrow">Organização</p><h1>@ViewData["Title"]</h1><p class="page-subtitle">Defina o evento e quando pretende começar a receber o aviso.</p></div></div>
<section class="panel"><form asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" class="form-stack"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div><label asp-for="Text"></label><textarea asp-for="Text" rows="4" placeholder="Ex.: Renovar o seguro automóvel"></textarea><span asp-validation-for="Text" class="field-error"></span></div><div class="form-grid two"><div><label asp-for="EventDate"></label><input asp-for="EventDate" type="date" /><span asp-validation-for="EventDate" class="field-error"></span></div><div><label asp-for="NoticeDays"></label><input asp-for="NoticeDays" type="number" min="0" max="3650" /><span asp-validation-for="NoticeDays" class="field-error"></span></div></div><p class="form-help">O alerta fica disponível quando faltarem os dias indicados e permanece ativo até cada utilizador confirmar.</p><div class="form-actions"><button class="button" type="submit">@(editing ? "Guardar alterações" : "Criar lembrete")</button><a class="button secondary" asp-action="Index">Cancelar</a></div></form></section>

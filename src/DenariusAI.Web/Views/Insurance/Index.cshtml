@model DenariusAI.Web.ViewModels.InsurancePortfolioViewModel
@using DenariusAI.Domain.Enums
@{ ViewData["Title"] = "Seguros"; }

<div class="d-flex justify-content-between align-items-start gap-3 mb-4">
    <div><div class="text-uppercase small text-muted fw-semibold">Património · Seguros</div><h1 class="h2 mb-1">Carteira de seguros</h1><p class="text-muted mb-0">Acompanhe apólices, renovações e prémios pagos ou por pagar.</p></div>
    <a asp-action="Create" class="btn btn-primary">Nova apólice</a>
</div>
<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="text-muted small">Apólices ativas</div><div class="fs-3 fw-semibold">@Model.ActivePolicies</div></div></div></div>
    <div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="text-muted small">Custo no ano</div><div class="fs-3 fw-semibold">@Model.AnnualCost.ToString("N2") €</div></div></div></div>
    <div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="text-muted small">Prémios vencidos</div><div class="fs-3 fw-semibold">@Model.OutstandingPremiums</div></div></div></div>
    <div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="text-muted small">Renovações · 30 dias</div><div class="fs-3 fw-semibold">@Model.UpcomingRenewals</div></div></div></div>
</div>
<div class="card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Apólice</th><th>Seguradora</th><th>Tipo</th><th>Renovação</th><th>Estado</th><th class="text-end">Ações</th></tr></thead><tbody>
@foreach (var item in Model.Policies) { <tr><td><strong>@item.Name</strong><div class="small text-muted">@item.PolicyNumber</div></td><td>@item.Insurer</td><td>@item.Type</td><td>@(item.RenewalDate?.ToString("dd/MM/yyyy") ?? "—")</td><td>@item.Status</td><td class="text-end"><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Ver</a> <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Editar</a></td></tr> }
@if (Model.Policies.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-5">Ainda não existem apólices registadas.</td></tr> }
</tbody></table></div></div>

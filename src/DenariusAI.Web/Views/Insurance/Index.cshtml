@model DenariusAI.Web.ViewModels.InsurancePortfolioViewModel
@using DenariusAI.Domain.Enums
@{ ViewData["Title"] = "Seguros"; }
<link rel="stylesheet" href="~/css/insurance.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/cards.css" asp-append-version="true" />
<div class="page-header"><div><p class="eyebrow">Proteção</p><h1>Carteira de seguros</h1><p class="page-subtitle">Acompanhe apólices, encargos, pagamentos e renovações num único lugar.</p></div><a class="button" asp-action="Create">Nova apólice</a></div>
<section class="insurance-totals" aria-label="Resumo da carteira de seguros">
    <article class="insurance-primary"><span>Custo no ano</span><strong>@Model.AnnualCost.ToString("N2") €</strong><small>Prémios registados no ano atual</small></article>
    <article class="insurance-active"><span>Apólices ativas</span><strong>@Model.ActivePolicies</strong><small>Coberturas atualmente em vigor</small></article>
    <article class="insurance-overdue"><span>Prémios vencidos</span><strong>@Model.OutstandingPremiums</strong><small>Pagamentos por regularizar</small></article>
    <article class="insurance-renewals"><span>Próximas renovações</span><strong>@Model.UpcomingRenewals</strong><small>Nos próximos 30 dias</small></article>
</section>
<section class="panel insurance-panel">
    <header class="insurance-panel-header"><div><p class="eyebrow">Apólices</p><h2>Proteções registadas</h2></div><span>@Model.Pagination.TotalItems registo@(Model.Pagination.TotalItems == 1 ? "" : "s")</span></header>
    <form id="insurance-filters" method="get" class="filterbar insurance-filters">
        <select name="type" aria-label="Tipo de seguro">
            <option value="">Todos os tipos</option>
            <option value="Home" selected="@(Model.Type == InsurancePolicyType.Home)">Habitação</option>
            <option value="Motor" selected="@(Model.Type == InsurancePolicyType.Motor)">Automóvel</option>
            <option value="Health" selected="@(Model.Type == InsurancePolicyType.Health)">Saúde</option>
            <option value="Life" selected="@(Model.Type == InsurancePolicyType.Life)">Vida</option>
            <option value="PersonalAccident" selected="@(Model.Type == InsurancePolicyType.PersonalAccident)">Acidentes pessoais</option>
            <option value="Other" selected="@(Model.Type == InsurancePolicyType.Other)">Outro</option>
        </select>
        <select name="status" aria-label="Estado da apólice">
            <option value="">Todos os estados</option>
            <option value="Active" selected="@(Model.Status == InsurancePolicyStatus.Active)">Ativas</option>
            <option value="Archived" selected="@(Model.Status == InsurancePolicyStatus.Archived)">Arquivadas</option>
            <option value="Cancelled" selected="@(Model.Status == InsurancePolicyStatus.Cancelled)">Canceladas</option>
        </select>
        <input type="search" name="search" value="@Model.Search" placeholder="Pesquisar apólices..." aria-label="Pesquisar apólices" />
        <label class="page-size">Por página <select name="pageSize">@foreach (var size in PaginationViewModel.AllowedPageSizes) { <option value="@size" selected="@(size == Model.Pagination.PageSize)">@size</option> }</select></label>
        <button class="button secondary" type="submit">Aplicar</button>
    </form>
    <div class="table-wrap"><table class="entity-table insurance-table"><thead><tr><th>Apólice</th><th>Seguradora</th><th>Tipo</th><th>Renovação</th><th>Estado</th><th class="actions">Ações</th></tr></thead><tbody>
    @foreach (var item in Model.Policies)
    {
        var typeLabel = item.Type switch { InsurancePolicyType.Home => "Habitação", InsurancePolicyType.Motor => "Automóvel", InsurancePolicyType.Health => "Saúde", InsurancePolicyType.Life => "Vida", InsurancePolicyType.PersonalAccident => "Acidentes pessoais", _ => "Outro" };
        var statusLabel = item.Status switch { InsurancePolicyStatus.Active => "Ativa", InsurancePolicyStatus.Archived => "Arquivada", _ => "Cancelada" };
        <tr><td><strong>@item.Name</strong><small>@item.PolicyNumber</small></td><td>@item.Insurer</td><td>@typeLabel</td><td class="nowrap">@(item.RenewalDate?.ToString("dd/MM/yyyy") ?? "—")</td><td><span class="status @(item.Status == InsurancePolicyStatus.Active ? "active" : "inactive")">@statusLabel</span></td><td class="actions"><a class="text-link" asp-action="Details" asp-route-id="@item.Id">Consultar</a><a class="text-link" asp-action="Edit" asp-route-id="@item.Id">Editar</a></td></tr>
    }
    @if (Model.Policies.Count == 0) { <tr><td colspan="6" class="empty-row"><strong>Não foram encontradas apólices.</strong><small>Altere os filtros ou registe uma nova apólice.</small></td></tr> }
    </tbody></table></div>
    <nav class="pagination insurance-pagination" aria-label="Paginação"><span>@Model.Pagination.FirstItem–@Model.Pagination.LastItem de @Model.Pagination.TotalItems</span><div><button class="pager-link" type="submit" form="insurance-filters" name="page" value="@(Model.Pagination.Page - 1)" disabled="@(!Model.Pagination.HasPreviousPage)">Anterior</button><span>Página @Model.Pagination.Page de @Model.Pagination.TotalPages</span><button class="pager-link" type="submit" form="insurance-filters" name="page" value="@(Model.Pagination.Page + 1)" disabled="@(!Model.Pagination.HasNextPage)">Seguinte</button></div></nav>
</section>

@model DenariusAI.Web.ViewModels.InsurancePolicyFormViewModel
@{ var editing = ViewContext.RouteData.Values["action"]?.ToString() == "Edit"; ViewData["Title"] = editing ? "Editar apólice" : "Nova apólice"; }
<link rel="stylesheet" href="~/css/data-forms.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/insurance.css" asp-append-version="true" />
<div class="page-header"><div><p class="eyebrow">Proteção · Seguros</p><h1>@ViewData["Title"]</h1><p class="page-subtitle">@(editing ? "Atualize a identificação, cobertura e calendário desta apólice." : "Identifique a cobertura e configure as datas relevantes da nova apólice.")</p></div><a class="button secondary" asp-action="Index">Voltar</a></div>
<section class="data-editor insurance-editor"><div class="data-editor-grid"><div class="data-editor-main">@if (!editing) { <section class="insurance-ai-import" aria-labelledby="insurance-ai-title"><span class="insurance-ai-icon" aria-hidden="true">✦</span><div class="insurance-ai-copy"><span class="insurance-ai-eyebrow">Preenchimento assistido</span><h2 id="insurance-ai-title">Usar dados da área de transferência</h2><p>Copie os dados da apólice para a IA propor os campos do formulário. Nada será gravado sem a sua confirmação.</p><p id="insurance-ai-status" class="insurance-ai-status" role="status" aria-live="polite">@(Model.AiSuggestionAvailable ? "Apenas os campos identificados serão preenchidos." : "Configure a chave Mistral nas Definições para utilizar esta opção.")</p><button id="insurance-ai-paste" class="button secondary insurance-ai-action" type="button" disabled="@(!Model.AiSuggestionAvailable)">Colar e preencher com IA</button></div></section> }<form method="post" id="insurance-policy-form" class="form-stack insurance-form"><div asp-validation-summary="ModelOnly" class="validation-summary"></div>
    <section class="insurance-form-section"><header><span>01</span><div><h2>Identificação</h2><p>Dados que permitem reconhecer o contrato e a entidade seguradora.</p></div></header><div class="insurance-form-body"><div class="form-grid two"><div><label asp-for="Name"></label><input asp-for="Name" placeholder="Ex.: Seguro automóvel familiar" autofocus /><span asp-validation-for="Name" class="field-error"></span></div><div><label asp-for="Insurer"></label><input asp-for="Insurer" placeholder="Ex.: Fidelidade" /><span asp-validation-for="Insurer" class="field-error"></span></div></div><div class="form-grid two"><div><label asp-for="PolicyNumber"></label><input asp-for="PolicyNumber" placeholder="Número indicado no contrato" /><span asp-validation-for="PolicyNumber" class="field-error"></span></div><div><label asp-for="InsuredSubject"></label><input asp-for="InsuredSubject" placeholder="Ex.: Viatura 00-AA-00 ou habitação" /><span asp-validation-for="InsuredSubject" class="field-error"></span></div></div></div></section>
    <section class="insurance-form-section"><header><span>02</span><div><h2>Cobertura e pagamento</h2><p>Classifique o risco e indique a frequência habitual do prémio.</p></div></header><div class="insurance-form-body"><div class="form-grid two"><div><label asp-for="Type"></label><select asp-for="Type"><option value="1">Habitação</option><option value="2">Automóvel</option><option value="3">Saúde</option><option value="4">Vida</option><option value="5">Acidentes pessoais</option><option value="99">Outro</option></select><span asp-validation-for="Type" class="field-error"></span></div><div><label asp-for="PaymentFrequency"></label><select asp-for="PaymentFrequency"><option value="1">Mensal</option><option value="3">Trimestral</option><option value="6">Semestral</option><option value="12">Anual</option><option value="99">Irregular</option></select><span asp-validation-for="PaymentFrequency" class="field-error"></span></div></div></div></section>
    <section class="insurance-form-section"><header><span>03</span><div><h2>Vigência e renovação</h2><p>Defina o período contratual e a próxima data que exige acompanhamento.</p></div></header><div class="insurance-form-body"><div class="form-grid three"><div><label asp-for="StartDate"></label><input asp-for="StartDate" type="date" /><span asp-validation-for="StartDate" class="field-error"></span></div><div><label asp-for="EndDate"></label><input asp-for="EndDate" type="date" /><span asp-validation-for="EndDate" class="field-error"></span></div><div><label asp-for="RenewalDate"></label><input asp-for="RenewalDate" type="date" /><span asp-validation-for="RenewalDate" class="field-error"></span></div></div></div></section>
    <section class="insurance-form-section"><header><span>04</span><div><h2>Notas</h2><p>Acrescente informação útil que não esteja refletida nos restantes campos.</p></div></header><div class="insurance-form-body"><label asp-for="Notes"></label><textarea asp-for="Notes" rows="4" placeholder="Coberturas, franquias ou observações relevantes"></textarea><span asp-validation-for="Notes" class="field-error"></span></div></section>
    <div class="form-actions"><button class="button" type="submit">@(editing ? "Guardar alterações" : "Criar apólice")</button><a class="button secondary" asp-action="Index">Cancelar</a></div>
</form></div><aside class="data-editor-context"><p class="eyebrow">Contexto</p><h2>Acompanhar uma apólice</h2><p>A apólice identifica a cobertura. Os respetivos encargos são registados separadamente como prémios.</p><ul class="data-editor-context-list"><li><strong>Contrato</strong>Use a designação e o número constantes da documentação da seguradora.</li><li><strong>Prémios</strong>Cada pagamento pode ter comprovativos próprios e ser associado a um movimento financeiro existente.</li><li><strong>Fonte de verdade</strong>Quando associado, o movimento ativo determina o estado e a data efetiva do pagamento.</li><li><strong>Renovação</strong>A data permite antecipar revisões de condições, cancelamentos ou novos pagamentos.</li></ul></aside></div></section>
@section Scripts { @if (!editing) { <script src="~/js/insurance-clipboard-ai.js" asp-append-version="true"></script> } }

@model DenariusAI.Web.ViewModels.InsurancePolicyFormViewModel
@{ var editing = ViewContext.RouteData.Values["action"]?.ToString() == "Edit"; ViewData["Title"] = editing ? "Editar apólice" : "Nova apólice"; }
<div class="mb-4"><div class="text-uppercase small text-muted fw-semibold">Património · Seguros</div><h1 class="h2 mb-1">@(editing ? "Editar apólice" : "Nova apólice")</h1><p class="text-muted mb-0">Registe os dados da cobertura e da próxima renovação.</p></div>
<div class="row g-4"><div class="col-lg-8"><div class="card"><div class="card-body"><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3">
<div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control"/><span asp-validation-for="Name" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Insurer" class="form-label"></label><input asp-for="Insurer" class="form-control"/></div>
<div class="col-md-6"><label asp-for="PolicyNumber" class="form-label"></label><input asp-for="PolicyNumber" class="form-control"/></div><div class="col-md-3"><label asp-for="Type" class="form-label"></label><select asp-for="Type" asp-items="Html.GetEnumSelectList<DenariusAI.Domain.Enums.InsurancePolicyType>()" class="form-select"></select></div><div class="col-md-3"><label asp-for="PaymentFrequency" class="form-label"></label><select asp-for="PaymentFrequency" asp-items="Html.GetEnumSelectList<DenariusAI.Domain.Enums.InsurancePaymentFrequency>()" class="form-select"></select></div>
<div class="col-md-4"><label asp-for="StartDate" class="form-label"></label><input asp-for="StartDate" class="form-control"/></div><div class="col-md-4"><label asp-for="EndDate" class="form-label"></label><input asp-for="EndDate" class="form-control"/></div><div class="col-md-4"><label asp-for="RenewalDate" class="form-label"></label><input asp-for="RenewalDate" class="form-control"/></div>
<div class="col-12"><label asp-for="InsuredSubject" class="form-label"></label><input asp-for="InsuredSubject" class="form-control"/></div><div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" rows="4" class="form-control"></textarea></div></div><div class="d-flex justify-content-between mt-4"><a asp-action="Index" class="btn btn-outline-secondary">Voltar</a><button class="btn btn-primary" type="submit">Guardar</button></div></form></div></div></div>
<div class="col-lg-4"><div class="card h-100"><div class="card-body"><h2 class="h5">Contexto</h2><p class="text-muted">A apólice descreve a cobertura. Os pagamentos são registados separadamente como prémios e podem ser associados aos movimentos financeiros existentes.</p><p class="text-muted mb-0">O Denarius não duplica o movimento contabilístico: o movimento ativo continua a ser a fonte de verdade do pagamento.</p></div></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

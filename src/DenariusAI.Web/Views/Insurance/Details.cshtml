@model DenariusAI.Web.ViewModels.InsurancePolicyDetailsViewModel
@using DenariusAI.Domain.Enums
@{ var policy = Model.Policy; ViewData["Title"] = policy.Name; var today = DateOnly.FromDateTime(DateTime.Today); var statusLabel = policy.Status switch { InsurancePolicyStatus.Active => "Ativa", InsurancePolicyStatus.Archived => "Arquivada", _ => "Cancelada" }; }
<link rel="stylesheet" href="~/css/data-forms.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/searchable-select.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/insurance.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/cards.css" asp-append-version="true" />
<div class="page-header"><div><p class="eyebrow">Proteção · Seguros</p><h1>@policy.Name</h1><p class="page-subtitle">@policy.Insurer · Apólice @policy.PolicyNumber</p></div><div class="header-actions"><a class="button secondary" asp-action="Index">Voltar</a><a class="button" asp-action="Edit" asp-route-id="@policy.Id">Editar apólice</a>@if (policy.Status == InsurancePolicyStatus.Active) { <form asp-action="Archive" method="post" onsubmit="return confirm('Arquivar esta apólice? O histórico será preservado.')"><input type="hidden" name="id" value="@policy.Id" /><button class="button secondary" type="submit">Arquivar</button></form><form asp-action="Cancel" method="post" onsubmit="return confirm('Cancelar esta apólice? O histórico será preservado.')"><input type="hidden" name="id" value="@policy.Id" /><button class="button danger" type="submit">Cancelar</button></form> } else { <form asp-action="Activate" method="post"><input type="hidden" name="id" value="@policy.Id" /><button class="button" type="submit">Reativar</button></form> }</div></div>
<section class="insurance-policy-summary" aria-label="Resumo da apólice"><article class="insurance-summary-primary"><span>Estado da apólice</span><strong>@statusLabel</strong><small>@(policy.InsuredSubject ?? "Pessoa ou bem não indicado")</small></article><article><span>Próxima renovação</span><strong>@(policy.RenewalDate?.ToString("dd/MM/yyyy") ?? "—")</strong><small>Data de acompanhamento</small></article><article><span>Prémios registados</span><strong>@policy.Premiums.Count</strong><small>Histórico desta apólice</small></article><article><span>Total registado</span><strong>@policy.Premiums.Sum(x => x.Amount).ToString("N2") €</strong><small>Valor acumulado dos prémios</small></article></section>
<section class="panel insurance-panel insurance-policy-documents"><header class="insurance-panel-header"><div><p class="eyebrow">Documentação</p><h2>Documentos gerais da apólice</h2></div><span>@policy.Attachments.Count documento@(policy.Attachments.Count == 1 ? "" : "s")</span></header><div class="insurance-policy-documents-body"><div><p>Guarde aqui o contrato, as condições particulares, o certificado ou outros documentos que pertencem à apólice e não a um pagamento específico.</p>@if (policy.Attachments.Count > 0) { <ul class="insurance-policy-document-list">@foreach (var attachment in policy.Attachments.OrderBy(x => x.FileName)) { <li><span aria-hidden="true">PDF</span><a asp-action="PolicyAttachment" asp-route-id="@attachment.Id" target="_blank" rel="noopener">@attachment.FileName</a></li> }</ul> } else { <p class="insurance-document-empty">Ainda não existem documentos gerais.</p> }</div><form asp-action="UploadPolicyAttachment" method="post" enctype="multipart/form-data" class="insurance-upload insurance-policy-upload"><input type="hidden" name="policyId" value="@policy.Id" /><label class="file-picker" data-file-picker><span class="file-picker-icon" aria-hidden="true">＋</span><span class="file-picker-copy"><strong data-file-name>Adicionar documento geral</strong><span data-file-meta aria-live="polite">PDF até 5 MB</span></span><span class="file-picker-change" data-file-action>Escolher</span><input name="file" type="file" accept="application/pdf,.pdf" required /></label><button class="button secondary" type="submit">Anexar PDF</button></form></div></section>
@if (policy.Status == InsurancePolicyStatus.Active)
{
<section class="data-editor insurance-premium-editor"><div class="data-editor-grid"><div class="data-editor-main"><form asp-action="AddPremium" method="post" class="form-stack insurance-premium-form"><input type="hidden" name="policyId" value="@policy.Id" /><div><p class="eyebrow">Novo encargo</p><h2>Registar prémio</h2><p class="insurance-section-intro">Indique o valor, o período coberto e a data limite de pagamento.</p></div><div class="form-grid two"><div><label for="premium-amount">Valor do prémio</label><input id="premium-amount" name="Amount" type="number" step="0.01" min="0.01" inputmode="decimal" placeholder="0,00" required /></div><div><label for="premium-reference">Referência</label><input id="premium-reference" name="Reference" placeholder="Referência ou descrição opcional" /></div></div><div class="form-grid three"><div><label for="premium-start">Período desde</label><input id="premium-start" name="PeriodStart" type="date" required /></div><div><label for="premium-end">Período até</label><input id="premium-end" name="PeriodEnd" type="date" required /></div><div><label for="premium-due">Vencimento</label><input id="premium-due" name="DueDate" type="date" required /></div></div><div class="form-actions"><button class="button" type="submit">Adicionar prémio</button></div></form></div><aside class="data-editor-context"><p class="eyebrow">Pagamento</p><h2>Movimento financeiro</h2><p>O prémio representa a obrigação contratual. O pagamento continua a ser comprovado pelo movimento financeiro associado.</p><ul class="data-editor-context-list"><li><strong>Sem duplicação</strong>Associe um movimento existente em vez de registar novamente a despesa.</li><li><strong>Estado do pagamento</strong>Um prémio é considerado pago apenas quando tem um movimento ativo associado.</li><li><strong>Comprovativos</strong>Os documentos pertencem ao prémio e ficam disponíveis no respetivo histórico.</li></ul></aside></div></section>
}
else
{
<div class="alert warning">Esta apólice está @statusLabel.ToLowerInvariant(). Reative-a para registar novos prémios.</div>
}
<section class="panel insurance-panel insurance-premiums-panel"><header class="insurance-panel-header"><div><p class="eyebrow">Histórico</p><h2>Prémios da apólice</h2></div><span>@policy.Premiums.Count registo@(policy.Premiums.Count == 1 ? "" : "s")</span></header><div class="insurance-premium-list">
@foreach (var premium in policy.Premiums.OrderByDescending(x => x.DueDate))
{
    var overdue = premium.DueDate < today && !premium.IsPaid;
    <article class="insurance-premium-card"><header><div><span class="status @(premium.IsPaid ? "active" : overdue ? "overdue" : "pending")">@(premium.IsPaid ? "Pago" : overdue ? "Vencido" : "Pendente")</span><h3>@premium.Amount.ToString("N2") €</h3><p>@premium.PeriodStart.ToString("dd/MM/yyyy") — @premium.PeriodEnd.ToString("dd/MM/yyyy")</p></div><div class="insurance-premium-due"><small>Vencimento</small><strong>@premium.DueDate.ToString("dd/MM/yyyy")</strong></div></header><div class="insurance-premium-grid"><section><h4>Pagamento</h4>@if (premium.IsPaid) { <p><a class="text-link" asp-controller="JournalEntries" asp-action="Details" asp-route-id="@premium.JournalEntryId">Movimento associado · @premium.PaymentDate?.ToString("dd/MM/yyyy")</a></p><form asp-action="RemoveMovement" method="post"><input type="hidden" name="premiumId" value="@premium.Id" /><button class="text-link danger-link" type="submit">Desassociar movimento</button></form> } else { <p>Selecione o movimento que comprova este pagamento.</p><form asp-action="AssociateMovement" method="post" class="insurance-inline-form"><input type="hidden" name="premiumId" value="@premium.Id" /><select name="journalEntryId" class="searchable-select-control" data-search-placeholder="Procurar por data, descrição, referência ou valor" asp-items="Model.AvailableMovements" required></select><button class="button secondary compact" type="submit">Associar</button></form> }</section><section><h4>Documentos</h4>@if (premium.Attachments.Count > 0) { <ul class="insurance-documents">@foreach (var attachment in premium.Attachments) { <li><a asp-action="Attachment" asp-route-id="@attachment.Id" target="_blank" rel="noopener">@attachment.FileName</a></li> }</ul> } else { <p>Sem documentos anexados.</p> }<form asp-action="UploadAttachment" method="post" enctype="multipart/form-data" class="insurance-upload"><input type="hidden" name="premiumId" value="@premium.Id" /><label class="file-picker" data-file-picker><span class="file-picker-icon" aria-hidden="true">＋</span><span class="file-picker-copy"><strong data-file-name>Adicionar comprovativo</strong><span data-file-meta aria-live="polite">PDF até 5 MB</span></span><span class="file-picker-change" data-file-action>Escolher</span><input name="file" type="file" accept="application/pdf,.pdf" required /></label><button class="button secondary compact" type="submit">Anexar PDF</button></form></section></div></article>
}

@if (policy.Premiums.Count == 0) { <div class="insurance-empty"><strong>Ainda não existem prémios nesta apólice.</strong><p>Registe o primeiro encargo quando a apólice estiver ativa.</p></div> }
</div></section>
@section Scripts { <script src="~/js/searchable-select.js" asp-append-version="true"></script><script src="~/js/insurance-file-picker.js" asp-append-version="true"></script> }

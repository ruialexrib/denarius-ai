@model DenariusAI.Domain.Entities.InsurancePolicy
@{ ViewData["Title"] = Model.Name; var today = DateOnly.FromDateTime(DateTime.Today); }
<div class="d-flex justify-content-between align-items-start gap-3 mb-4"><div><div class="text-uppercase small text-muted fw-semibold">Seguros · Apólice</div><h1 class="h2 mb-1">@Model.Name</h1><p class="text-muted mb-0">@Model.Insurer · @Model.PolicyNumber</p></div><div><a asp-action="Index" class="btn btn-outline-secondary">Voltar</a> <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a></div></div>
<div class="row g-3 mb-4"><div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">Estado</div><strong>@Model.Status</strong></div></div></div><div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">Renovação</div><strong>@(Model.RenewalDate?.ToString("dd/MM/yyyy") ?? "—")</strong></div></div></div><div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">Prémios</div><strong>@Model.Premiums.Count</strong></div></div></div><div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">Total registado</div><strong>@Model.Premiums.Sum(x => x.Amount).ToString("N2") €</strong></div></div></div></div>
<div class="card mb-4"><div class="card-header"><strong>Novo prémio</strong></div><div class="card-body"><form asp-action="AddPremium" method="post"><input type="hidden" name="policyId" value="@Model.Id"/><div class="row g-3"><div class="col-md-2"><label class="form-label">Prémio</label><input name="Amount" type="number" step="0.01" min="0.01" class="form-control" required/></div><div class="col-md-2"><label class="form-label">Período desde</label><input name="PeriodStart" type="date" class="form-control" required/></div><div class="col-md-2"><label class="form-label">Período até</label><input name="PeriodEnd" type="date" class="form-control" required/></div><div class="col-md-2"><label class="form-label">Vencimento</label><input name="DueDate" type="date" class="form-control" required/></div><div class="col-md-3"><label class="form-label">Referência</label><input name="Reference" class="form-control"/></div><div class="col-md-1 d-flex align-items-end"><button class="btn btn-primary w-100">Adicionar</button></div></div></form></div></div>
<div class="card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Período</th><th>Vencimento</th><th class="text-end">Valor</th><th>Pagamento</th><th>Documentos</th></tr></thead><tbody>@foreach (var p in Model.Premiums.OrderByDescending(x => x.DueDate)) { <tr><td>@p.PeriodStart.ToString("dd/MM/yyyy") — @p.PeriodEnd.ToString("dd/MM/yyyy")</td><td>@p.DueDate.ToString("dd/MM/yyyy")</td><td class="text-end">@p.Amount.ToString("N2") €</td><td>@if (p.IsPaid) { <span class="badge text-bg-success">Pago · @p.PaymentDate?.ToString("dd/MM/yyyy")</span><form asp-action="RemoveMovement" method="post" class="d-inline"><input type="hidden" name="premiumId" value="@p.Id"/><button class="btn btn-sm btn-link">Desassociar</button></form> } else { <span class="badge text-bg-@(p.DueDate < today ? "danger" : "secondary")">@(p.DueDate < today ? "Vencido" : "Pendente")</span><form asp-action="AssociateMovement" method="post" class="d-flex gap-1 mt-2"><input type="hidden" name="premiumId" value="@p.Id"/><input name="journalEntryId" class="form-control form-control-sm" placeholder="ID do movimento" required/><button class="btn btn-sm btn-outline-primary">Associar</button></form> }</td><td>@foreach (var a in p.Attachments) { <div><a asp-action="Attachment" asp-route-id="@a.Id">@a.FileName</a></div> }<form asp-action="UploadAttachment" method="post" enctype="multipart/form-data" class="d-flex gap-1 mt-2"><input type="hidden" name="premiumId" value="@p.Id"/><input name="file" type="file" accept="application/pdf,.pdf" class="form-control form-control-sm" required/><button class="btn btn-sm btn-outline-secondary">Anexar</button></form></td></tr> } @if (Model.Premiums.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-5">Ainda não existem prémios nesta apólice.</td></tr> }</tbody></table></div></div>

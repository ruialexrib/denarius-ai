@model ReconciliationIndexViewModel
@{ ViewData["Title"] = "Reconciliação"; }
<div class="page-header"><div><p class="eyebrow">Finanças</p><h1>Reconciliação bancária</h1><p class="muted">Confirme os movimentos que já constam no extrato da respetiva conta.</p></div><div class="form-actions"><a class="button" asp-action="Import">Importar Excel</a></div></div><div asp-validation-summary="ModelOnly" class="validation-summary"></div>
<section class="reconciliation-stats"><article><span>Por reconciliar</span><strong>@Model.UnreconciledCount</strong></article><article><span>Reconciliados</span><strong>@Model.ReconciledCount</strong></article><article class="future-import"><span>Importação de extratos</span><strong>Excel + IA</strong><small>Deteção e classificação assistida de novos movimentos.</small></article></section>
<section class="panel"><form id="reconciliation-filters" method="get" class="filterbar reconciliation-filters"><select name="accountId" asp-items="Model.Accounts" aria-label="Conta bancária"></select><label>De <input type="date" name="from" value="@(Model.From?.ToString("yyyy-MM-dd"))" /></label><label>Até <input type="date" name="to" value="@(Model.To?.ToString("yyyy-MM-dd"))" /></label><select name="status" asp-items="Model.Statuses" aria-label="Estado"></select><input type="search" name="search" value="@Model.Search" placeholder="Descrição ou referência..." /><select name="sort" asp-items="Model.SortOptions" aria-label="Ordenação"></select><label class="page-size">Por página <select name="pageSize">@foreach (var size in PaginationViewModel.AllowedPageSizes) { <option value="@size" selected="@(size == Model.Pagination.PageSize)">@size</option> }</select></label><button class="button secondary" type="submit">Aplicar</button></form>
<div class="table-wrap"><table><thead><tr><th>Data</th><th>Movimento</th><th>Conta bancária</th><th>Entrada</th><th>Saída</th><th>Estado</th><th>Auditoria</th><th class="actions">Ações</th></tr></thead><tbody>
@foreach (var item in Model.Items) { <tr><td class="nowrap">@item.Date.ToString("dd/MM/yyyy")</td><td><strong>@item.Description</strong>@if (!string.IsNullOrWhiteSpace(item.Reference)) { <small>Ref. @item.Reference</small> }</td><td>@item.AccountNames</td><td class="amount positive">@(item.Debit == 0 ? "—" : item.Debit.ToString("N2"))</td><td class="amount negative">@(item.Credit == 0 ? "—" : item.Credit.ToString("N2"))</td><td><span class="status @(item.Status == DenariusAI.Domain.Enums.ReconciliationStatus.Reconciled ? "active" : "pending")">@(item.Status == DenariusAI.Domain.Enums.ReconciliationStatus.Reconciled ? "Reconciliado" : "Não reconciliado")</span></td><td>@if (item.ReconciledAt.HasValue) { @item.ReconciledAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") <small>@item.ReconciledBy</small> } else { <span>—</span> }</td><td class="actions"><a class="text-link" asp-controller="JournalEntries" asp-action="Details" asp-route-id="@item.JournalEntryId">Consultar</a><form asp-action="@(item.Status == DenariusAI.Domain.Enums.ReconciliationStatus.Reconciled ? "Undo" : "Reconcile")" method="post"><input type="hidden" name="id" value="@item.JournalEntryId" /><input type="hidden" name="accountId" value="@Model.AccountId" /><input type="hidden" name="from" value="@Model.From" /><input type="hidden" name="to" value="@Model.To" /><input type="hidden" name="status" value="@Model.Status" /><input type="hidden" name="search" value="@Model.Search" /><input type="hidden" name="sort" value="@Model.Sort" /><input type="hidden" name="page" value="@Model.Pagination.Page" /><input type="hidden" name="pageSize" value="@Model.Pagination.PageSize" /><button class="text-link" type="submit">@(item.Status == DenariusAI.Domain.Enums.ReconciliationStatus.Reconciled ? "Desfazer" : "Reconciliar")</button></form></td></tr> }
@if (Model.Items.Count == 0) { <tr><td colspan="8" class="empty-row">Não foram encontrados movimentos bancários com estes filtros.</td></tr> }
</tbody></table></div><nav class="pagination" aria-label="Paginação"><span>@Model.Pagination.FirstItem–@Model.Pagination.LastItem de @Model.Pagination.TotalItems</span><div><button class="pager-link" type="submit" form="reconciliation-filters" name="page" value="@(Model.Pagination.Page - 1)" disabled="@(!Model.Pagination.HasPreviousPage)">Anterior</button><span>Página @Model.Pagination.Page de @Model.Pagination.TotalPages</span><button class="pager-link" type="submit" form="reconciliation-filters" name="page" value="@(Model.Pagination.Page + 1)" disabled="@(!Model.Pagination.HasNextPage)">Seguinte</button></div></nav></section>

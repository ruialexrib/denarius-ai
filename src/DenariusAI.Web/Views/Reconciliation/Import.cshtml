@model ReconciliationPasteViewModel
@{ ViewData["Title"] = "Analisar movimentos"; }
<link rel="stylesheet" href="~/css/intelligent-workflows.css" asp-append-version="true" />
<div class="page-header">
    <div><p class="eyebrow">Reconciliação · Assistente</p><h1>Colar movimentos do extrato</h1><p class="page-subtitle">Converse com o modelo para interpretar o extrato e encontrar apenas movimentos ainda não registados.</p></div>
    <a class="button secondary" asp-action="Index">Cancelar</a>
</div>
<section class="panel import-panel reconciliation-conversation">
    <div class="movement-ai-message assistant">Cole abaixo os movimentos tal como aparecem no banco. Inclua, se possível, uma linha por movimento com data, descrição, referência e valor. Use valores positivos para entradas e negativos para saídas.</div>
    @if (!string.IsNullOrWhiteSpace(Model.AssistantMessage)) { <div class="movement-ai-message assistant rationale">@Model.AssistantMessage</div> }
    <form asp-action="AnalyzeConversation" method="post" class="form-stack settings-form">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <label asp-for="BankAccountId">Conta do extrato<select asp-for="BankAccountId" asp-items="Model.BankAccounts" required><option value="">Selecionar conta…</option></select><span asp-validation-for="BankAccountId" class="field-error"></span></label>
        <label asp-for="MovementsText">Movimentos<textarea asp-for="MovementsText" rows="14" maxlength="50000" placeholder="24/08/2026 | Fatura da água | Ref. 123/2026 | -30,00&#10;21/08/2026 | Ordenado | Agosto 2026 | 1 500,00" required></textarea><span asp-validation-for="MovementsText" class="field-error"></span></label>
        <p class="muted">A IA interpreta o texto, compara-o com os movimentos existentes e propõe classificações. Nada é gravado nesta etapa.</p>
        <div class="form-actions"><button class="button" type="submit">Enviar e analisar</button></div>
    </form>
</section>

@model JournalEntryFormViewModel
@{ var editing = Model.Id != Guid.Empty; ViewData["Title"] = editing ? "Editar movimento" : "Novo movimento"; }
<link rel="stylesheet" href="~/css/data-forms.css" asp-append-version="true" />
<div class="page-header"><div><p class="eyebrow">Finanças · Movimentos</p><h1>@ViewData["Title"]</h1><p class="page-subtitle">@(editing ? "Atualize os dados e as linhas contabilísticas deste movimento." : "Descreva a operação manualmente ou use a assistência em linguagem natural para preencher os campos.")</p></div></div>
@if (!editing) {
<section class="movement-ai"><div class="movement-ai-intro"><div class="movement-ai-card-content"><div class="movement-ai-card-top"><span class="movement-ai-icon" aria-hidden="true">✦</span><span class="movement-ai-state">Assistido por IA</span></div><span class="movement-ai-eyebrow">Registo inteligente</span><h2>Crie um movimento através de uma conversa</h2><p>Descreva a operação em linguagem natural. A IA consulta as contas, grupos, categorias e movimentos recentes, pede a informação em falta e prepara uma sugestão completa para rever.</p></div><button id="toggle-movement-ai" class="button movement-ai-action" type="button" disabled="@(!Model.AiSuggestionAvailable)"><i class="bi bi-chat-dots" aria-hidden="true"></i> Iniciar conversa</button></div>
@if (!Model.AiSuggestionAvailable) { <div class="movement-ai-disabled">Configure a chave Mistral nas <a asp-controller="Account" asp-action="Profile" asp-fragment="ai">Definições</a> para utilizar esta opção.</div> }
<div id="movement-ai-chat" class="movement-ai-chat" hidden><div id="movement-ai-messages"><div class="movement-ai-message assistant">Conte-me o que aconteceu por palavras simples. Se faltar algum dado necessário, faço-lhe uma pergunta antes de preparar o movimento.</div><div class="movement-ai-examples"><span>Experimente um exemplo</span><button type="button" data-ai-example="Paguei ontem 42 € de eletricidade com a Conta à Ordem. Referência da fatura: 123/25/2026."><strong>Despesa de eletricidade</strong><small>Paguei ontem 42 € com a Conta à Ordem…</small></button><button type="button" data-ai-example="Recebi ontem 1 500 € de salário na Conta à Ordem. Referência do recibo: 123/78/2026."><strong>Recebimento de salário</strong><small>Recebi ontem 1 500 € na Conta à Ordem…</small></button></div></div><form id="movement-ai-form"><div class="movement-ai-composer"><textarea id="movement-ai-input" maxlength="1000" rows="2" placeholder="Descreva a despesa, rendimento ou transferência…"></textarea><button class="button" type="submit">Enviar</button></div></form><p class="movement-ai-note">A IA propõe o tipo de movimento, o valor, a conta e a categoria. Nada será guardado sem a sua confirmação.</p></div></section>
}
<form id="journal-entry-form" asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@(editing ? Model.Id : null)" method="post" class="form-stack">
<section class="panel"><div asp-validation-summary="ModelOnly" class="validation-summary"></div>@if (editing) { <input asp-for="Id" type="hidden" /> }@if (Model.Accounts.Count < 3) { <div class="alert error">Crie pelo menos duas contas ativas antes de registar um movimento.</div> }<div class="form-grid journal-header"><div><label asp-for="Date"></label><input asp-for="Date" type="date" /><span asp-validation-for="Date" class="field-error"></span></div><div><label asp-for="Description"></label><input asp-for="Description" autocomplete="off" /><span asp-validation-for="Description" class="field-error"></span></div><div><label asp-for="Reference"></label><input asp-for="Reference" autocomplete="off" /><span asp-validation-for="Reference" class="field-error"></span></div><div><label asp-for="BudgetId"></label><select asp-for="BudgetId" asp-items="Model.Budgets"></select><p class="form-help">É selecionado por defeito o orçamento correspondente à data do movimento.</p></div></div><div><label asp-for="Notes"></label><textarea asp-for="Notes" rows="2"></textarea><span asp-validation-for="Notes" class="field-error"></span></div></section>
@if (!editing) {
<section class="panel simple-entry-panel" data-expense-account="@Model.ExpenseAccountId" data-income-account="@Model.IncomeAccountId"><div class="section-heading"><div><p class="eyebrow">Registo simples</p><h2>Como movimentou o dinheiro?</h2><p class="section-copy">Indique o tipo, o valor e a conta. A aplicação prepara o lançamento contabilístico por si.</p></div><button id="show-advanced" class="button secondary compact" type="button">Modo avançado</button></div>
<div class="entry-type-switch" role="group" aria-label="Tipo de movimento"><button type="button" class="active" data-entry-type="expense">Despesa</button><button type="button" data-entry-type="income">Rendimento</button><button type="button" data-entry-type="transfer">Transferência</button></div>
<div class="form-grid simple-entry-grid"><div><label for="simple-amount">Valor</label><div class="money-field"><input id="simple-amount" type="number" min="0.01" step="0.01" placeholder="0,00" /><span>€</span></div></div><div id="simple-source-wrap"><label for="simple-source">Pago com</label><select id="simple-source">@foreach (var option in Model.TransactionAccounts) { <option value="@option.Value">@option.Text</option> }</select></div><div id="simple-destination-wrap" hidden><label for="simple-destination">Transferido para</label><select id="simple-destination">@foreach (var option in Model.TransactionAccounts) { <option value="@option.Value">@option.Text</option> }</select></div><div id="simple-category-wrap"><label for="simple-category">Categoria</label><select id="simple-category"></select></div></div>
<p id="simple-entry-summary" class="simple-entry-summary">Preencha o valor, a conta e a categoria para preparar o movimento.</p></section>
}
<section id="advanced-entry" class="panel" hidden="@(!editing)"><div class="section-heading"><div><p class="eyebrow">Partidas</p><h2>Linhas do movimento</h2><p class="section-copy">Área avançada para consultar ou ajustar débitos, créditos e contrapartidas.</p></div><div class="section-actions">@if (!editing) { <button id="show-simple" class="button secondary compact" type="button">Voltar ao modo simples</button> }<button id="add-line" class="button secondary" type="button">Adicionar linha</button></div></div><span asp-validation-for="Lines" class="field-error"></span><div class="table-wrap"><table class="journal-lines"><thead><tr><th>Conta</th><th>Categoria</th><th>Descrição</th><th>Débito</th><th>Crédito</th><th></th></tr></thead><tbody id="journal-lines">
@for (var index = 0; index < Model.Lines.Count; index++) { <tr class="journal-line"><td><select asp-for="Lines[index].AccountId" asp-items="Model.Accounts" class="line-account"></select></td><td><select asp-for="Lines[index].CategoryId" asp-items="Model.Categories"></select></td><td><input asp-for="Lines[index].Description" autocomplete="off" /></td><td><input asp-for="Lines[index].Debit" class="line-debit amount-input" type="number" min="0" step="0.01" /></td><td><input asp-for="Lines[index].Credit" class="line-credit amount-input" type="number" min="0" step="0.01" /></td><td><button class="remove-line" type="button" aria-label="Remover linha">×</button></td></tr> }
</tbody><tfoot><tr><th colspan="3">Totais</th><th id="total-debit">0,00</th><th id="total-credit">0,00</th><th></th></tr></tfoot></table></div><div class="journal-balance"><span>Diferença</span><strong id="journal-difference">0,00</strong><small id="balance-state">O movimento tem de ficar equilibrado.</small></div></section>
<div class="form-actions"><button id="save-journal" class="button" type="submit">Guardar movimento</button>@if (editing) { <a class="button secondary" asp-action="Details" asp-route-id="@Model.Id">Cancelar</a> } else { <a class="button secondary" asp-action="Index">Cancelar</a> }</div></form>
<template id="journal-line-template"><tr class="journal-line"><td><select name="Lines[__index__].AccountId" class="line-account">@foreach (var option in Model.Accounts) { <option value="@option.Value">@option.Text</option> }</select></td><td><select name="Lines[__index__].CategoryId">@foreach (var option in Model.Categories) { <option value="@option.Value">@option.Text</option> }</select></td><td><input name="Lines[__index__].Description" autocomplete="off" /></td><td><input name="Lines[__index__].Debit" class="line-debit amount-input" type="number" min="0" step="0.01" value="0" /></td><td><input name="Lines[__index__].Credit" class="line-credit amount-input" type="number" min="0" step="0.01" value="0" /></td><td><button class="remove-line" type="button" aria-label="Remover linha">×</button></td></tr></template>
@if (!editing) { <script type="application/json" id="expense-categories">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExpenseCategories.Where(x => !string.IsNullOrEmpty(x.Value)).Select(x => new { value = x.Value, text = x.Text })))</script><script type="application/json" id="income-categories">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.IncomeCategories.Where(x => !string.IsNullOrEmpty(x.Value)).Select(x => new { value = x.Value, text = x.Text })))</script> }
@section Scripts { <script src="~/js/journal-entry-form.js" asp-append-version="true"></script>@if (!editing) { <script src="~/js/journal-entry-ai.js" asp-append-version="true"></script> } }

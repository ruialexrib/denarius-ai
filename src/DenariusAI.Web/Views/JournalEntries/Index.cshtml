@model JournalEntryIndexViewModel
@using DenariusAI.Web.Controllers
@{ ViewData["Title"] = "Movimentos"; }
<div class="page-header"><div><p class="eyebrow">Finanças</p><h1>Movimentos</h1><p class="page-subtitle">Registe, consulte e filtre operações contabilísticas entre contas.</p></div><a class="button" asp-action="Create">Novo movimento</a></div>
<section class="panel entity-panel journal-list-panel">
<form id="journal-filters" method="get" class="filterbar journal-filters"><label>De <input type="date" name="from" value="@(Model.From?.ToString("yyyy-MM-dd"))" /></label><label>Até <input type="date" name="to" value="@(Model.To?.ToString("yyyy-MM-dd"))" /></label><select name="status" asp-items="Model.Statuses" aria-label="Estado"></select><select name="budget" asp-items="Model.BudgetOptions" aria-label="Orçamento"></select><input type="search" name="search" value="@Model.Search" placeholder="Descrição ou referência..." /><select name="sort" asp-items="Model.SortOptions" aria-label="Ordenação"></select><label class="page-size">Por página <select name="pageSize">@foreach (var size in PaginationViewModel.AllowedPageSizes) { <option value="@size" selected="@(size == Model.Pagination.PageSize)">@size</option> }</select></label><button class="button secondary" type="submit">Aplicar</button></form>
<div class="table-wrap"><table class="entity-table journal-list-table"><thead><tr><th>Data</th><th>Movimento</th><th>Valor</th><th>Estado</th><th>Reconciliação</th><th class="actions">Ações</th></tr></thead><tbody>
@foreach (var item in Model.Items) { var movementClass = item.MovementType == "Entrada" ? "income" : item.MovementType == "Saída" ? "expense" : "transfer"; <tr><td class="nowrap"><span class="movement-date">@item.Date.ToString("dd/MM/yyyy")</span><small>@(item.BudgetName is null ? "Sem orçamento" : $"Orçamento {item.BudgetName}")</small></td><td><strong>@item.Description</strong>@if (!string.IsNullOrWhiteSpace(item.Reference)) { <small>Ref. @item.Reference</small> }</td><td class="amount movement-value"><strong>@item.TotalDebit.ToString("N2") €</strong><span class="movement-kind @movementClass">@item.MovementType</span></td><td><span class="status @(item.Status == DenariusAI.Domain.Enums.JournalEntryStatus.Active ? "active" : "inactive")">@JournalEntriesController.StatusName(item.Status)</span></td><td><span class="reconciliation-state">@JournalEntriesController.ReconciliationName(item.ReconciliationStatus)</span></td><td class="actions"><a class="text-link" asp-action="Details" asp-route-id="@item.Id">Consultar</a>@if (item.Status == DenariusAI.Domain.Enums.JournalEntryStatus.Active && item.ReconciliationStatus != DenariusAI.Domain.Enums.ReconciliationStatus.Reconciled) { <a class="text-link" asp-action="Edit" asp-route-id="@item.Id">Editar</a> }</td></tr> }
@if (Model.Items.Count == 0) { <tr><td colspan="6" class="empty-row">Não foram encontrados movimentos.</td></tr> }
</tbody></table></div><nav class="pagination" aria-label="Paginação"><span>@Model.Pagination.FirstItem–@Model.Pagination.LastItem de @Model.Pagination.TotalItems</span><div><button class="pager-link" type="submit" form="journal-filters" name="page" value="@(Model.Pagination.Page - 1)" disabled="@(!Model.Pagination.HasPreviousPage)">Anterior</button><span>Página @Model.Pagination.Page de @Model.Pagination.TotalPages</span><button class="pager-link" type="submit" form="journal-filters" name="page" value="@(Model.Pagination.Page + 1)" disabled="@(!Model.Pagination.HasNextPage)">Seguinte</button></div></nav>
</section>

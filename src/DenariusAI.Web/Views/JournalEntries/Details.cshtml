@model JournalEntryDetailsViewModel
@using DenariusAI.Web.Controllers
@{ var entry = Model.Entry; var editable = entry.Status == DenariusAI.Domain.Enums.JournalEntryStatus.Active && entry.ReconciliationStatus != DenariusAI.Domain.Enums.ReconciliationStatus.Reconciled; ViewData["Title"] = "Consultar movimento"; }
<div class="page-header"><div><p class="eyebrow">Finanças · Movimentos</p><h1>@entry.Description</h1><p class="page-subtitle">Consulte as linhas contabilísticas, o orçamento associado e o estado da operação.</p></div><div class="form-actions">@if (editable) { <a class="button secondary" asp-action="Edit" asp-route-id="@entry.Id">Editar</a><form asp-action="Cancel" asp-route-id="@entry.Id" method="post" onsubmit="return confirm('Anular este movimento? Esta ação não pode ser revertida.')"><button class="button danger" type="submit">Anular</button></form> }<a class="button secondary" asp-action="Index">Voltar</a></div></div>
<section class="panel journal-summary"><dl><div><dt>Data</dt><dd>@entry.Date.ToString("dd/MM/yyyy")</dd></div><div><dt>Orçamento</dt><dd>@(entry.BudgetName ?? "Sem orçamento")</dd></div><div><dt>Referência</dt><dd>@(entry.Reference ?? "—")</dd></div><div><dt>Estado</dt><dd><span class="status @(entry.Status == DenariusAI.Domain.Enums.JournalEntryStatus.Active ? "active" : "inactive")">@JournalEntriesController.StatusName(entry.Status)</span></dd></div><div><dt>Reconciliação</dt><dd>@JournalEntriesController.ReconciliationName(entry.ReconciliationStatus)</dd></div>@if (!string.IsNullOrWhiteSpace(entry.Notes)) { <div class="wide"><dt>Notas</dt><dd>@entry.Notes</dd></div> }@if (entry.CancelledAt.HasValue) { <div class="wide"><dt>Anulação</dt><dd>@entry.CancelledAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @entry.CancelledBy</dd></div> }</dl></section>
@if (Model.InsurancePremiums.Count > 0) { <section class="panel"><div class="section-heading"><div><p class="eyebrow">Seguros</p><h2>Prémios associados</h2></div></div><div class="table-wrap"><table><thead><tr><th>Apólice</th><th>Referência</th><th>Comprovativos</th></tr></thead><tbody>@foreach (var premium in Model.InsurancePremiums) { <tr><td><a class="text-link" asp-controller="Insurance" asp-action="Details" asp-route-id="@premium.PolicyId">@premium.PolicyName</a></td><td>@(premium.PremiumReference ?? "—")</td><td>@if (premium.Attachments.Count == 0) { <text>—</text> } else { @foreach (var attachment in premium.Attachments) { <a class="text-link" asp-controller="Insurance" asp-action="Attachment" asp-route-id="@attachment.Id" target="_blank" rel="noopener">@attachment.FileName</a> } }</td></tr> }</tbody></table></div></section> }
<section class="panel"><div class="section-heading"><div><p class="eyebrow">Partidas</p><h2>Linhas contabilísticas</h2></div></div><div class="table-wrap"><table><thead><tr><th>Conta</th><th>Categoria</th><th>Descrição</th><th>Débito</th><th>Crédito</th></tr></thead><tbody>@foreach (var line in entry.Lines) { <tr><td><a class="text-link" asp-controller="Accounts" asp-action="Statement" asp-route-id="@line.AccountId"><strong>@line.AccountName</strong></a></td><td>@if (line.CategoryName is not null) { var kind = line.Debit > 0 ? DenariusAI.Domain.Enums.FinancialGroupKind.Expense : DenariusAI.Domain.Enums.FinancialGroupKind.Income; <partial name="_CategoryKindIcon" model="kind" /> @line.CategoryName } else { <text>—</text> }</td><td>@(line.Description ?? "—")</td><td class="amount">@line.Debit.ToString("N2")</td><td class="amount">@line.Credit.ToString("N2")</td></tr> }</tbody><tfoot><tr><th colspan="3">Totais</th><th class="amount">@entry.TotalDebit.ToString("N2")</th><th class="amount">@entry.TotalCredit.ToString("N2")</th></tr></tfoot></table></div></section>

@model BudgetCategoryDetailsViewModel
@using System.Globalization
@{ ViewData["Title"] = $"Orçamento · {Model.CategoryName}"; var max = Math.Max(Model.History.Select(item => Math.Max(item.Budgeted, item.Actual)).DefaultIfEmpty(0m).Max(), 1m); }
<link rel="stylesheet" href="~/css/budget-category.css" asp-append-version="true" />
<div class="page-header"><div><p class="eyebrow">Orçamento · Categoria</p><h1><partial name="_CategoryKindIcon" model="Model.Kind" /> @Model.CategoryName</h1><p class="page-subtitle">Evolução dos valores orçamentados e realizados ao longo dos períodos criados. Grupo: @Model.GroupName.</p></div><div class="header-actions"><a class="button secondary" asp-controller="Categories" asp-action="Statement" asp-route-id="@Model.CategoryId">Extrato</a><a class="button secondary" asp-action="Index">Voltar</a></div></div>
<section class="budget-summary"><article><span>Total orçamentado</span><strong>@Model.TotalBudgeted.ToString("N2") €</strong></article><article><span>Total realizado</span><strong>@Model.TotalActual.ToString("N2") €</strong></article><article class="@(Model.TotalVariance > 0 ? "over" : "")"><span>Desvio acumulado</span><strong>@Model.TotalVariance.ToString("N2") €</strong></article></section>
<section class="panel"><div class="panel-title"><div><p class="eyebrow">Evolução</p><h2>Orçamentado vs. realizado</h2></div></div>
@if (Model.History.Count == 0) { <p class="empty-row">Ainda não existem orçamentos.</p> } else {
<div class="budget-history-chart">@foreach (var item in Model.History) { <div class="history-column"><div class="history-bars"><i title="@item.Period · Orçamentado: @item.Budgeted.ToString("N2") €" style="height:@((item.Budgeted / max * 100m).ToString(CultureInfo.InvariantCulture))%"></i><b title="@item.Period · Realizado: @item.Actual.ToString("N2") €" style="height:@((Math.Max(item.Actual, 0m) / max * 100m).ToString(CultureInfo.InvariantCulture))%"></b></div><small>@item.Period</small></div> }</div><div class="chart-legend"><span class="budgeted">Orçamentado</span><span class="actual">Realizado</span></div> }
</section>
<section class="panel"><div class="panel-title"><div><p class="eyebrow">Histórico</p><h2>Valores por período</h2></div></div><div class="table-wrap"><table><thead><tr><th>Período</th><th>Orçamentado</th><th>Realizado</th><th>Desvio</th><th>Execução</th></tr></thead><tbody>
@foreach (var item in Model.History.OrderByDescending(item => item.Year).ThenByDescending(item => item.Month)) { <tr><td><strong>@item.Period</strong></td><td class="amount">@item.Budgeted.ToString("N2") €</td><td class="amount">@item.Actual.ToString("N2") €</td><td class="amount @(item.Variance > 0 ? "negative" : "positive")">@item.Variance.ToString("N2") €</td><td class="amount">@(item.ExecutionPercentage.HasValue ? $"{item.ExecutionPercentage:N1}%" : "—")</td></tr> }
@if (Model.History.Count == 0) { <tr><td colspan="5" class="empty-row">Sem períodos para apresentar.</td></tr> }
</tbody></table></div></section>

@model BudgetIndexViewModel
@{ ViewData["Title"] = "Orçamento"; var execution = Model.ExecutionPercentage; }
<div class="page-header"><div><p class="eyebrow">Finanças</p><h1>Orçamento mensal</h1><p class="muted">Defina os limites por categoria. O realizado é calculado pelos movimentos associados a este orçamento, independentemente da data.</p></div></div>
<section class="budget-summary"><article><span>Orçamentado</span><strong>@Model.TotalBudgeted.ToString("N2") €</strong></article><article><span>Realizado</span><strong>@Model.TotalActual.ToString("N2") €</strong></article><article class="@(Model.TotalVariance > 0 ? "over" : "")"><span>Desvio</span><strong>@Model.TotalVariance.ToString("N2") €</strong></article><article><span>Execução</span><strong>@(execution.HasValue ? $"{execution:N1}%" : "—")</strong><div class="progress"><i style="width:@Math.Min(execution ?? 0m, 100m).ToString(System.Globalization.CultureInfo.InvariantCulture)%"></i></div></article></section>
<section class="panel">
<form id="budget-filters" method="get" class="filterbar budget-filters"><select name="year" asp-items="Model.Years" aria-label="Ano"></select><select name="month" asp-items="Model.Months" aria-label="Mês"></select><select name="groupId" asp-items="Model.Groups" aria-label="Grupo"></select><input type="search" name="search" value="@Model.Search" placeholder="Pesquisar categoria..." /><select name="sort" asp-items="Model.SortOptions" aria-label="Ordenação"></select><label class="page-size">Por página <select name="pageSize">@foreach (var size in PaginationViewModel.AllowedPageSizes) { <option value="@size" selected="@(size == Model.Pagination.PageSize)">@size</option> }</select></label><button class="button secondary" type="submit">Aplicar</button></form>
<form asp-action="Save" method="post"><input type="hidden" name="Year" value="@Model.Year" /><input type="hidden" name="Month" value="@Model.Month" /><input type="hidden" name="GroupId" value="@Model.GroupId" /><input type="hidden" name="Search" value="@Model.Search" /><input type="hidden" name="Sort" value="@Model.Sort" /><input type="hidden" name="Page" value="@Model.Pagination.Page" /><input type="hidden" name="PageSize" value="@Model.Pagination.PageSize" />
<div class="table-wrap"><table class="budget-table"><thead><tr><th>Grupo</th><th>Categoria</th><th>Orçamentado</th><th>Realizado</th><th>Desvio</th><th>Execução</th></tr></thead><tbody>
@for (var index = 0; index < Model.Lines.Count; index++) { var line = Model.Lines[index]; var percentage = line.ExecutionPercentage; <tr><td>@line.FinancialGroupName</td><td><strong><partial name="_CategoryKindIcon" model="line.Kind" /> <a class="text-link category-name-link" asp-action="Category" asp-route-id="@line.CategoryId">@line.CategoryName</a></strong><small><a class="text-link" asp-controller="Categories" asp-action="Statement" asp-route-id="@line.CategoryId">Ver extrato</a></small><input type="hidden" name="Lines[@index].CategoryId" value="@line.CategoryId" /></td><td><div class="money-input"><input name="Lines[@index].Amount" value="@line.Amount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" type="number" min="0" step="0.01" /><span>€</span></div></td><td class="amount">@line.Actual.ToString("N2") €</td><td class="amount @(line.Variance > 0 ? "negative" : "positive")">@line.Variance.ToString("N2") €</td><td><div class="execution-cell"><span>@(percentage.HasValue ? $"{percentage:N1}%" : "—")</span><div class="progress"><i class="@(percentage > 100 ? "over" : "")" style="width:@Math.Min(percentage ?? 0m, 100m).ToString(System.Globalization.CultureInfo.InvariantCulture)%"></i></div></div></td></tr> }
@if (Model.Lines.Count == 0) { <tr><td colspan="6" class="empty-row">Não foram encontradas categorias de despesa.</td></tr> }
</tbody></table></div><div class="budget-actions">@if (Model.Lines.Count > 0) { <button class="button" type="submit">Guardar esta página</button> }<small>Os valores das outras páginas são preservados.</small></div></form>
<nav class="pagination" aria-label="Paginação"><span>@Model.Pagination.FirstItem–@Model.Pagination.LastItem de @Model.Pagination.TotalItems</span><div><button class="pager-link" type="submit" form="budget-filters" name="page" value="@(Model.Pagination.Page - 1)" disabled="@(!Model.Pagination.HasPreviousPage)">Anterior</button><span>Página @Model.Pagination.Page de @Model.Pagination.TotalPages</span><button class="pager-link" type="submit" form="budget-filters" name="page" value="@(Model.Pagination.Page + 1)" disabled="@(!Model.Pagination.HasNextPage)">Seguinte</button></div></nav></section>

@model SavingsCertificateIndexViewModel
@{ ViewData["Title"] = "Certificados de Aforro"; }
<div class="page-header"><div><p class="eyebrow">Poupanças</p><h1>Certificados de Aforro</h1><p class="page-subtitle">Gira a carteira, acompanhe a valorização e antecipe a próxima capitalização líquida.</p></div><a class="button" asp-action="Create">Adicionar certificado</a></div>
<section class="certificate-totals" aria-label="Resumo da carteira"><article class="certificate-current"><span>Valor atual da carteira</span><strong>@Model.TotalCurrentValue.ToString("N2") €</strong><small>Investimento de @Model.TotalInvestment.ToString("N2") €</small></article><article class="certificate-investment"><span>Total investido</span><strong>@Model.TotalInvestment.ToString("N2") €</strong><small>Capital subscrito</small></article><article class="certificate-yield"><span>Rendimento acumulado</span><strong class="@(Model.TotalYield < 0 ? "negative" : "positive")">@Model.TotalYield.ToString("N2") €</strong><small>Valorização atual</small></article><article class="certificate-interest"><span>Próximo juro líquido</span><strong>@Model.TotalFutureNetInterest.ToString("N2") €</strong><small>Projeção após retenção</small></article><article class="certificate-future"><span>Valor futuro</span><strong>@Model.TotalFutureValue.ToString("N2") €</strong><small>Após próxima capitalização</small></article></section>
<section class="panel certificate-panel"><div class="table-wrap"><table class="certificate-table"><thead><tr><th>Data</th><th>Antiguidade<br />em dias</th><th>Série/Número</th><th>Descrição</th><th>Valor do<br />investimento</th><th>Taxa</th><th>Valor atual</th><th>Rendimento</th><th>Próx. capit.</th><th>Dif.</th><th>Juro líq.<br />futuro</th><th>Valor futuro</th><th class="actions">Ações</th></tr></thead><tbody>
@foreach (var item in Model.Items) { <tr><td class="nowrap">@item.InvestmentDate.ToString("dd/MM/yyyy")</td><td class="amount">@item.AgeDays</td><td><strong>@item.SeriesNumber</strong></td><td>@item.Description</td><td class="amount">@item.InvestmentValue.ToString("N2") €</td><td class="amount">@item.Rate.ToString("N3")%</td><td class="amount">@item.CurrentValue.ToString("N2") €</td><td class="amount @(item.Yield < 0 ? "negative" : "positive")">@item.Yield.ToString("N2") €</td><td class="nowrap">@item.NextCapitalization.ToString("dd/MM/yyyy")</td><td class="amount @(item.DaysUntilCapitalization < 0 ? "negative" : null)">@item.DaysUntilCapitalization</td><td class="amount">@item.FutureNetInterest.ToString("N2") €</td><td class="amount"><strong>@item.FutureValue.ToString("N2") €</strong></td><td class="actions"><a class="text-link" asp-action="Edit" asp-route-id="@item.Id">Editar</a><form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Remover este certificado da carteira?')"><button class="text-link danger-link" type="submit">Remover</button></form></td></tr> }
@if (Model.Items.Count == 0) { <tr><td colspan="13" class="empty-row">Ainda não existem Certificados de Aforro na carteira.</td></tr> }
</tbody><tfoot><tr><th colspan="4">Totais</th><th class="amount">@Model.TotalInvestment.ToString("N2") €</th><th></th><th class="amount">@Model.TotalCurrentValue.ToString("N2") €</th><th class="amount">@Model.TotalYield.ToString("N2") €</th><th colspan="2"></th><th class="amount">@Model.TotalFutureNetInterest.ToString("N2") €</th><th class="amount">@Model.TotalFutureValue.ToString("N2") €</th><th></th></tr></tfoot></table></div><p class="certificate-note">O juro líquido futuro considera retenção de 28% e capitalização trimestral: valor atual × (taxa × 72% ÷ 4).</p></section>

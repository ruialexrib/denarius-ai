@model SavingsCertificateFormViewModel
@{ var editing = Model.Id != Guid.Empty; ViewData["Title"] = editing ? "Editar certificado" : "Adicionar certificado"; }
<link rel="stylesheet" href="~/css/data-forms.css" asp-append-version="true" />
<style>.panel.narrow{max-width:none}</style>
<div class="page-header"><div><p class="eyebrow">Poupanças · Certificados de Aforro</p><h1>@ViewData["Title"]</h1><p class="page-subtitle">@(editing ? "Atualize os dados usados no acompanhamento e nas projeções deste certificado." : "Registe uma subscrição para a incluir nos totais e nas projeções da carteira.")</p></div><a class="button secondary" asp-action="Index">Voltar</a></div>
<section class="panel narrow"><form asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@(editing ? Model.Id : null)" method="post" class="form-stack"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-grid two"><div><label asp-for="InvestmentDate"></label><input asp-for="InvestmentDate" type="date" /><span asp-validation-for="InvestmentDate" class="field-error"></span></div><div><label asp-for="NextCapitalization"></label><input asp-for="NextCapitalization" type="date" /><span asp-validation-for="NextCapitalization" class="field-error"></span></div></div><div class="form-grid two"><div><label asp-for="SeriesNumber"></label><input asp-for="SeriesNumber" autofocus /><span asp-validation-for="SeriesNumber" class="field-error"></span></div><div><label asp-for="Description"></label><input asp-for="Description" /><span asp-validation-for="Description" class="field-error"></span></div></div><div class="form-grid three"><div><label asp-for="InvestmentValue"></label><input asp-for="InvestmentValue" type="number" min="0.01" step="0.01" /><span asp-validation-for="InvestmentValue" class="field-error"></span></div><div><label asp-for="Rate"></label><input asp-for="Rate" type="number" min="0" max="100" step="0.001" /><span asp-validation-for="Rate" class="field-error"></span></div><div><label asp-for="CurrentValue"></label><input asp-for="CurrentValue" type="number" min="0" step="0.01" /><span asp-validation-for="CurrentValue" class="field-error"></span></div></div><p class="form-help">Antiguidade, rendimento, diferença em dias, juro líquido futuro e valor futuro são calculados automaticamente.</p><div class="form-actions"><button class="button" type="submit">Guardar</button><a class="button secondary" asp-action="Index">Cancelar</a></div></form></section>

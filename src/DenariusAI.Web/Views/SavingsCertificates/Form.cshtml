@model SavingsCertificateFormViewModel
@{ var editing = Model.Id != Guid.Empty; ViewData["Title"] = editing ? "Editar certificado" : "Adicionar certificado"; }
<link rel="stylesheet" href="~/css/data-forms.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/insurance.css" asp-append-version="true" />
<style>.panel.narrow{max-width:none}</style>
<div class="page-header"><div><p class="eyebrow">Poupanças · Certificados de Aforro</p><h1>@ViewData["Title"]</h1><p class="page-subtitle">@(editing ? "Atualize os dados e o lembrete associado a este certificado." : "Registe uma subscrição e configure o aviso da próxima capitalização.")</p></div><a class="button secondary" asp-action="Index">Voltar</a></div>
<section class="data-editor"><div class="data-editor-grid"><div class="data-editor-main">
@if (!editing) { <section class="insurance-ai-import" aria-labelledby="savings-certificate-ai-title"><span class="insurance-ai-icon" aria-hidden="true">✦</span><div class="insurance-ai-copy"><span class="insurance-ai-eyebrow">Preenchimento assistido</span><h2 id="savings-certificate-ai-title">Usar dados copiados do AforroNet</h2><p>Copie o detalhe do pedido de subscrição. A IA identifica o pedido, a série, a data, as unidades e o valor e propõe os campos do formulário. Nada será gravado sem a sua confirmação.</p><p id="savings-certificate-ai-status" class="insurance-ai-status" role="status" aria-live="polite">@(Model.AiSuggestionAvailable ? "Apenas os campos identificados serão preenchidos." : "Configure a chave Mistral nas Definições para utilizar esta opção.")</p><button id="savings-certificate-ai-paste" class="button secondary insurance-ai-action" type="button" disabled="@(!Model.AiSuggestionAvailable)">Colar e preencher com IA</button></div></section> }
<form id="savings-certificate-form" asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@(editing ? Model.Id : null)" method="post" class="form-stack"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-grid two"><div><label asp-for="InvestmentDate"></label><input asp-for="InvestmentDate" type="date" /><span asp-validation-for="InvestmentDate" class="field-error"></span></div><div><label asp-for="NextCapitalization"></label><input asp-for="NextCapitalization" type="date" /><span asp-validation-for="NextCapitalization" class="field-error"></span></div></div><div><label asp-for="NoticeDays"></label><input asp-for="NoticeDays" type="number" min="0" max="3650" /><span asp-validation-for="NoticeDays" class="field-error"></span><p class="form-help">O lembrete associado acompanha automaticamente a próxima capitalização.</p></div><div class="form-grid two"><div><label asp-for="SeriesNumber"></label><input asp-for="SeriesNumber" autofocus /><span asp-validation-for="SeriesNumber" class="field-error"></span></div><div><label asp-for="Description"></label><input asp-for="Description" /><span asp-validation-for="Description" class="field-error"></span></div></div><div class="form-grid three"><div><label asp-for="InvestmentValue"></label><input asp-for="InvestmentValue" type="number" min="0.01" step="0.01" /><span asp-validation-for="InvestmentValue" class="field-error"></span></div><div><label asp-for="Rate"></label><input asp-for="Rate" type="number" min="0" max="100" step="0.001" /><span asp-validation-for="Rate" class="field-error"></span></div><div><label asp-for="CurrentValue"></label><input asp-for="CurrentValue" type="number" min="0" step="0.01" /><span asp-validation-for="CurrentValue" class="field-error"></span></div></div><p class="form-help">Antiguidade, rendimento, diferença em dias, juro líquido futuro e valor futuro são calculados automaticamente.</p><div class="form-actions"><button class="button" type="submit">Guardar</button><a class="button secondary" asp-action="Index">Cancelar</a></div></form></div><aside class="data-editor-context"><p class="eyebrow">Contexto</p><h2>Acompanhar a poupança</h2><p>Registe apenas os dados conhecidos. Os indicadores derivados continuam a ser calculados deterministicamente pela aplicação.</p><ul class="data-editor-context-list"><li><strong>AforroNet</strong>O preenchimento assistido interpreta o detalhe copiado do pedido de subscrição.</li><li><strong>Capitalização</strong>A próxima data alimenta o lembrete associado.</li><li><strong>Subscrição</strong>A série, o número do pedido e a data identificam o investimento.</li><li><strong>Cálculos</strong>Rendimento e projeções continuam a ser calculados pela aplicação.</li></ul></aside></div></section>
@section Scripts { @if (!editing) { <script src="~/js/savings-certificate-clipboard-ai.js" asp-append-version="true"></script> } }

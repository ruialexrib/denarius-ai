@model CorrespondenceFormViewModel
@{ var editing=Model.Id!=Guid.Empty; ViewData["Title"]=editing?"Editar correspondência":"Nova correspondência"; }
<link rel="stylesheet" href="~/css/data-forms.css" asp-append-version="true" />
<div class="page-header"><div><p class="eyebrow">Documentos</p><h1>@ViewData["Title"]</h1><p class="page-subtitle">Registe a correspondência e associe o documento recebido.</p></div></div>
<section class="panel"><form asp-action="@(editing?"Edit":"Create")" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="form-stack"><input asp-for="Id" type="hidden" /><input asp-for="ExistingDocumentFileName" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div><label asp-for="Subject"></label><input asp-for="Subject" /><span asp-validation-for="Subject" class="field-error"></span></div><div class="form-grid two"><div><label asp-for="Sender"></label><input asp-for="Sender" /></div><div><label asp-for="ReceivedDate"></label><input asp-for="ReceivedDate" type="date" /><span asp-validation-for="ReceivedDate" class="field-error"></span></div></div><div><label asp-for="Notes"></label><textarea asp-for="Notes" rows="4"></textarea><span asp-validation-for="Notes" class="field-error"></span></div><div><label asp-for="Document"></label><input asp-for="Document" type="file" accept="application/pdf,.pdf" /><span asp-validation-for="Document" class="field-error"></span>@if(editing){<p class="form-help">Documento atual: <strong>@Model.ExistingDocumentFileName</strong>. Selecione outro PDF apenas para o substituir.</p>}else{<p class="form-help">Apenas PDF, até 10 MB. O conteúdo será guardado na base de dados.</p>}</div><div class="form-actions"><button class="button" type="submit">@(editing?"Guardar alterações":"Criar correspondência")</button><a class="button secondary" asp-action="Index">Cancelar</a></div></form></section>

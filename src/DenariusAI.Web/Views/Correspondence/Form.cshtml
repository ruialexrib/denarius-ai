@model CorrespondenceFormViewModel
@{ var editing=Model.Id!=Guid.Empty; ViewData["Title"]=editing?"Editar correspondência":"Nova correspondência"; }
<link rel="stylesheet" href="~/css/data-forms.css" asp-append-version="true" />
<div class="page-header"><div><p class="eyebrow">Documentos</p><h1>@ViewData["Title"]</h1><p class="page-subtitle">Registe a correspondência e associe o documento recebido.</p></div></div>
<section class="data-editor"><div class="data-editor-grid"><div class="data-editor-main"><form asp-action="@(editing?"Edit":"Create")" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="form-stack"><input asp-for="Id" type="hidden" /><input asp-for="ExistingDocumentFileName" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div><label asp-for="Subject"></label><input asp-for="Subject" /><span asp-validation-for="Subject" class="field-error"></span></div><div class="form-grid two"><div><label asp-for="Sender"></label><input asp-for="Sender" /></div><div><label asp-for="ReceivedDate"></label><input asp-for="ReceivedDate" type="date" /><span asp-validation-for="ReceivedDate" class="field-error"></span></div></div><div><label asp-for="Notes"></label><textarea asp-for="Notes" rows="4"></textarea><span asp-validation-for="Notes" class="field-error"></span></div><div><label for="Document">Documento PDF</label><label class="file-picker@(editing && Model.ExistingDocumentFileName is not null ? " has-file" : "")" for="Document" id="documentFilePicker"><span class="file-picker-icon" aria-hidden="true">+</span><span class="file-picker-copy"><strong id="documentFileTitle">@(editing && Model.ExistingDocumentFileName is not null ? Model.ExistingDocumentFileName : "Selecionar documento PDF")</strong><span id="documentFileMeta">@(editing && Model.ExistingDocumentFileName is not null ? "Documento atual · selecione outro PDF para substituir" : "Ficheiro PDF até 10 MB")</span></span><span class="file-picker-change" id="documentFileChange" @(editing && Model.ExistingDocumentFileName is not null ? "" : "hidden")>Alterar</span><input asp-for="Document" type="file" accept="application/pdf,.pdf" /></label><span asp-validation-for="Document" class="field-error"></span></div><div class="form-actions"><button class="button" type="submit">@(editing?"Guardar alterações":"Criar correspondência")</button><a class="button secondary" asp-action="Index">Cancelar</a></div></form></div><aside class="data-editor-context"><p class="eyebrow">Contexto</p><h2>Registo documental</h2><p>Use este registo para manter o documento recebido associado à sua origem, data e contexto.</p><ul class="data-editor-context-list"><li><strong>Assunto</strong>Identifique o conteúdo de forma fácil de reconhecer posteriormente.</li><li><strong>Remetente e data</strong>Permitem contextualizar e localizar a correspondência.</li><li><strong>Documento</strong>O PDF fica associado ao registo; numa edição só é substituído se selecionar outro ficheiro.</li></ul></aside></div></section>
@section Scripts {<script>(()=>{const input=document.getElementById('Document');const picker=document.getElementById('documentFilePicker');const title=document.getElementById('documentFileTitle');const meta=document.getElementById('documentFileMeta');const change=document.getElementById('documentFileChange');const maxSize=10*1024*1024;input?.addEventListener('change',async()=>{const file=input.files?.[0];if(!file)return;title.textContent=file.name;if(!file.name.toLowerCase().endsWith('.pdf')){showInvalid('Ficheiro inválido · a extensão tem de ser .pdf');return;}if(file.size>maxSize){showInvalid(`${formatFileSize(file.size)} · excede o limite de 10 MB`);return;}let isPdf=false;try{const header=new Uint8Array(await file.slice(0,5).arrayBuffer());isPdf=header.length===5&&header[0]===0x25&&header[1]===0x50&&header[2]===0x44&&header[3]===0x46&&header[4]===0x2d;}catch{showInvalid('Não foi possível validar o ficheiro · selecione outro PDF');return;}if(!isPdf){showInvalid('Ficheiro inválido · selecione um PDF válido');return;}picker?.classList.add('has-file');meta.textContent=`${formatFileSize(file.size)} · PDF selecionado`;change.hidden=false;});function showInvalid(message){picker?.classList.remove('has-file');meta.textContent=message;change.hidden=true;}function formatFileSize(bytes){if(bytes<1024)return`${bytes} B`;if(bytes<1024*1024)return`${(bytes/1024).toFixed(1)} KB`;return`${(bytes/(1024*1024)).toFixed(1)} MB`;}})();</script>}

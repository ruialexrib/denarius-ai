@model CorrespondenceMetadataPageViewModel
@{ ViewData["Title"] = "Metadados da correspondência"; }
<link rel="stylesheet" href="~/css/data-forms.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/documents.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/correspondence-metadata.css" asp-append-version="true" />
<div class="page-header"><div><p class="eyebrow">Correspondência · Metadados</p><h1>@Model.Subject</h1><p class="page-subtitle">Reveja e confirme os dados associados ao documento.</p></div><a class="button secondary" asp-action="Index">Voltar</a></div>
<section class="panel metadata-ai-panel"><div><span class="metadata-ai-icon" aria-hidden="true">✦</span><div><h2>Análise assistida</h2><p>Extrai texto do PDF e envia-o ao fornecedor de IA selecionado para propor metadados. A análise não grava alterações.</p></div></div><form asp-action="AnalyzeMetadata" asp-route-id="@Model.CorrespondenceId" method="post" data-progress-message="A analisar o documento e a propor metadados…"><button class="button" type="submit" disabled="@(!Model.HasDocument)">Analisar PDF com IA</button></form>@if(!Model.HasDocument){<p class="form-help">Adicione primeiro um PDF à correspondência.</p>}</section>
@if(Model.IsProposal){<aside class="metadata-proposal-note" role="status"><strong>Proposta por confirmar</strong><span>Foram analisadas @Model.ExtractedPages páginas e @Model.ExtractedCharacters caracteres. Edite ou remova campos antes de confirmar.</span></aside>}
<section class="panel metadata-editor"><form asp-action="SaveMetadata" method="post" class="form-stack"><input asp-for="CorrespondenceId" type="hidden" /><input asp-for="IsProposal" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="metadata-heading"><div><h2>Dicionário de metadados</h2><p>Máximo de 30 pares chave–valor.</p></div><button class="button secondary" type="button" data-add-metadata>Adicionar campo</button></div><div class="metadata-rows" data-metadata-rows>
@for(var index=0;index<Model.Items.Count;index++){<div class="metadata-row" data-metadata-row><input asp-for="Items[index].Id" type="hidden" /><input asp-for="Items[index].Confidence" type="hidden" /><div><label asp-for="Items[index].Key"></label><input asp-for="Items[index].Key" /><span asp-validation-for="Items[index].Key" class="field-error"></span></div><div><label asp-for="Items[index].Value"></label><textarea asp-for="Items[index].Value" rows="2"></textarea><span asp-validation-for="Items[index].Value" class="field-error"></span></div><div class="metadata-row-state">@if(Model.Items[index].Confidence is "high" or "low"){<span class="metadata-confidence @Model.Items[index].Confidence">Confiança @(Model.Items[index].Confidence == "high" ? "alta" : "baixa")</span>}<label class="metadata-remove"><input asp-for="Items[index].Remove" /> Remover</label></div></div>}
@if(Model.Items.Count==0){<p class="metadata-empty" data-metadata-empty>Ainda não existem metadados. Pode adicioná-los manualmente ou analisar o PDF.</p>}
</div><div class="form-actions"><button class="button" type="submit">@(Model.IsProposal ? "Confirmar metadados" : "Guardar metadados")</button><a class="button secondary" asp-action="Index">Cancelar</a></div></form></section>
@section Scripts{<script src="~/js/correspondence-metadata.js" asp-append-version="true"></script>}

@model CorrespondenceIndexViewModel
@{ ViewData["Title"] = "Correspondência"; }
<link rel="stylesheet" href="~/css/documents.css" asp-append-version="true" />
<div class="page-header"><div><p class="eyebrow">Documentos</p><h1>Correspondência</h1><p class="page-subtitle">Organize cartas, notificações e outra correspondência recebida.</p></div><a class="button" asp-action="Create">Nova correspondência</a></div>
<section class="panel document-list-panel"><form method="get" class="filterbar document-filters"><input type="search" name="search" value="@Model.Search" placeholder="Pesquisar por assunto ou remetente..." /><button class="button secondary" type="submit">Pesquisar</button>@if(!string.IsNullOrWhiteSpace(Model.Search)){<a class="text-link" asp-action="Index">Limpar</a>}</form><div class="table-wrap"><table class="document-table"><thead><tr><th>Assunto</th><th>Remetente</th><th>Receção</th><th>Documento</th><th>Metadados</th><th class="actions">Ações</th></tr></thead><tbody>
@foreach(var item in Model.Items){<tr><td><strong>@item.Subject</strong></td><td>@(item.Sender ?? "—")</td><td class="nowrap">@item.ReceivedDate.ToString("dd/MM/yyyy")</td><td>@if(item.DocumentFileName is not null){<a class="document-link" asp-action="Document" asp-route-id="@item.Id" target="_blank" rel="noopener">Ver PDF</a><small>@item.DocumentFileName</small>}else{<span class="status inactive">Sem documento</span>}</td><td><a class="document-link" asp-action="Metadata" asp-route-id="@item.Id">Gerir</a><small>@item.MetadataCount @(item.MetadataCount == 1 ? "campo" : "campos")</small></td><td class="actions"><a class="text-link" asp-action="Edit" asp-route-id="@item.Id">Editar</a><form asp-action="Delete" method="post" onsubmit="return confirm('Remover esta correspondência e o respetivo PDF?')"><input type="hidden" name="id" value="@item.Id" /><button class="text-link danger-link" type="submit">Remover</button></form>@await Html.PartialAsync("_AuditLink", new AuditLinkViewModel("Correspondence", item.Id.ToString()))</td></tr>}
@if(Model.Items.Count==0){<tr><td colspan="6" class="empty-row">Não foi encontrada correspondência.</td></tr>}
</tbody></table></div></section>

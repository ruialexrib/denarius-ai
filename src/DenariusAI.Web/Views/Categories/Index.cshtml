@model CategoryIndexViewModel
@{ ViewData["Title"] = "Categorias"; var activeCount = Model.Items.Count(item => item.Category.IsActive); var incomeCount = Model.Items.Count(item => item.Kind == DenariusAI.Domain.Enums.FinancialGroupKind.Income); var expenseCount = Model.Items.Count(item => item.Kind == DenariusAI.Domain.Enums.FinancialGroupKind.Expense); }
<link rel="stylesheet" href="~/css/summary-cards.css" asp-append-version="true" />
<div class="page-header"><div><p class="eyebrow">Configuração</p><h1>Categorias</h1><p class="page-subtitle">Organize rendimentos, despesas e património para classificar movimentos e orçamentos.</p></div><a class="button" asp-action="Create">Nova categoria</a></div>
<section class="area-summary" aria-label="Resumo das categorias"><article class="summary-primary"><span>Categorias</span><strong>@Model.Pagination.TotalItems</strong><small>Total correspondente aos filtros atuais</small></article><article class="summary-positive"><span>Ativas nesta página</span><strong>@activeCount</strong><small>Categorias disponíveis para utilização</small></article><article class="summary-info"><span>Rendimento</span><strong>@incomeCount</strong><small>Categorias de rendimento nesta página</small></article><article><span>Despesa</span><strong>@expenseCount</strong><small>Categorias de despesa nesta página</small></article></section>
<section class="panel entity-panel categories-panel"><form id="category-filters" method="get" class="filterbar categories"><select name="groupId" asp-items="Model.Groups"></select><input type="search" name="search" value="@Model.Search" placeholder="Pesquisar categorias..." /><label class="check-row"><input type="checkbox" name="showInactive" value="true" checked="@Model.ShowInactive" /> Mostrar inativas</label><label class="page-size">Por página <select name="pageSize">@foreach (var size in PaginationViewModel.AllowedPageSizes) { <option value="@size" selected="@(size == Model.Pagination.PageSize)">@size</option> }</select></label><button class="button secondary" type="submit">Aplicar</button></form>
<div class="table-wrap"><table class="entity-table"><thead><tr><th>Ordem</th><th>Categoria</th><th>Grupo</th><th>Estado</th><th class="actions">Ações</th></tr></thead><tbody>
@foreach (var item in Model.Items) { <tr><td>@item.Category.SortOrder</td><td><strong><partial name="_CategoryKindIcon" model="item.Kind" /> @item.Category.Name</strong>@if (!string.IsNullOrWhiteSpace(item.Category.Description)) { <small>@item.Category.Description</small> }</td><td>@item.GroupName</td><td><span class="status @(item.Category.IsActive ? "active" : "inactive")">@(item.Category.IsActive ? "Ativa" : "Inativa")</span></td><td class="actions"><a class="text-link" asp-action="Statement" asp-route-id="@item.Category.Id">Extrato</a><a class="text-link" asp-action="Edit" asp-route-id="@item.Category.Id">Editar</a><form asp-action="SetActive" method="post"><input type="hidden" name="id" value="@item.Category.Id" /><input type="hidden" name="isActive" value="@((!item.Category.IsActive).ToString().ToLowerInvariant())" /><input type="hidden" name="groupId" value="@Model.GroupId" /><input type="hidden" name="search" value="@Model.Search" /><input type="hidden" name="showInactive" value="@Model.ShowInactive.ToString().ToLowerInvariant()" /><input type="hidden" name="page" value="@Model.Pagination.Page" /><input type="hidden" name="pageSize" value="@Model.Pagination.PageSize" /><button class="text-link" type="submit">@(item.Category.IsActive ? "Desativar" : "Ativar")</button></form>@await Html.PartialAsync("_AuditLink", new AuditLinkViewModel("Category", item.Category.Id.ToString()))</td></tr> }
@if (Model.Items.Count == 0) { <tr><td colspan="5" class="empty-row">Não foram encontradas categorias.</td></tr> }
</tbody></table></div>
<nav class="pagination" aria-label="Paginação"><span>@Model.Pagination.FirstItem–@Model.Pagination.LastItem de @Model.Pagination.TotalItems</span><div><button class="pager-link" type="submit" form="category-filters" name="page" value="@(Model.Pagination.Page - 1)" disabled="@(!Model.Pagination.HasPreviousPage)">Anterior</button><span>Página @Model.Pagination.Page de @Model.Pagination.TotalPages</span><button class="pager-link" type="submit" form="category-filters" name="page" value="@(Model.Pagination.Page + 1)" disabled="@(!Model.Pagination.HasNextPage)">Seguinte</button></div></nav></section>

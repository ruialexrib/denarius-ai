@model CategoryFormViewModel
@{ var editing = Model.Id != Guid.Empty; ViewData["Title"] = editing ? "Editar categoria" : "Nova categoria"; }
<div class="page-header"><div><p class="eyebrow">Configuração · Categorias</p><h1>@ViewData["Title"]</h1><p class="page-subtitle">@(editing ? "Atualize o grupo, a identificação e a ordem desta categoria." : "Crie uma categoria e associe-a ao grupo financeiro adequado.")</p></div><a class="button secondary" asp-action="Index">Voltar</a></div>
<section class="panel"><form asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@(editing ? Model.Id : null)" method="post" class="form-stack"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><label asp-for="FinancialGroupId"></label><select asp-for="FinancialGroupId" asp-items="Model.Groups"><option value="">Selecione um grupo</option></select><span asp-validation-for="FinancialGroupId" class="field-error"></span><label asp-for="Name"></label><input asp-for="Name" autofocus /><span asp-validation-for="Name" class="field-error"></span><label asp-for="Description"></label><textarea asp-for="Description" rows="3"></textarea><span asp-validation-for="Description" class="field-error"></span><label asp-for="SortOrder"></label><input asp-for="SortOrder" min="0" /><span asp-validation-for="SortOrder" class="field-error"></span><div class="form-actions"><button class="button" type="submit">Guardar</button><a class="button secondary" asp-action="Index">Cancelar</a></div></form></section>

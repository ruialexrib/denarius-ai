@model HelpIndexViewModel
@{ ViewData["Title"] = "Ajuda"; }
<link rel="stylesheet" href="~/css/help-details.css" asp-append-version="true" />
<div class="page-header help-header">
    <div>
        <p class="eyebrow">Suporte</p>
        <h1>Centro de ajuda</h1>
        <p class="page-subtitle">Documentação funcional do Denarius AI: áreas, campos, regras, cálculos e respostas para as dúvidas mais frequentes.</p>
    </div>
</div>
<section class="panel help-search-panel" aria-label="Pesquisar documentação">
    <label for="helpSearch">Pesquisar na ajuda</label>
    <div class="help-search-control">
        <span aria-hidden="true">⌕</span>
        <input id="helpSearch" type="search" placeholder="Ex.: reconciliar, orçamento, apólice, ticker, cópia de segurança..." autocomplete="off" />
    </div>
    <p>Pesquise pelo nome da área ou por conceitos incluídos na documentação.</p>
</section>
<div id="helpTopics">
@foreach (var group in Model.Topics.GroupBy(topic => topic.Category))
{
    <section class="help-category" data-help-category>
        <div class="help-category-heading">
            <h2>@group.Key</h2>
            <span>@group.Count() @(group.Count() == 1 ? "área" : "áreas")</span>
        </div>
        <div class="help-grid">
        @foreach (var topic in group)
        {
            var classes = $"help-card{(topic.Featured ? " featured" : string.Empty)}{(topic.AiTopic ? " ai" : string.Empty)}";
            var searchText = $"{topic.Category} {topic.Title} {topic.Subtitle} {string.Join(" ", topic.Sections.Select(section => $"{section.Title} {section.Description} {string.Join(" ", section.Items)}"))}";
            <a class="@classes" asp-action="HelpDetail" asp-route-id="@topic.Id" data-help-topic data-help-search="@searchText">
                <span class="help-icon">@topic.Icon</span>
                <span class="help-card-category">@topic.Category</span>
                <h3>@topic.Title</h3>
                <p>@topic.Subtitle</p>
                <strong>Consultar documentação →</strong>
            </a>
        }
        </div>
    </section>
}
</div>
<section id="helpNoResults" class="panel help-empty" hidden>
    <strong>Não foram encontrados resultados.</strong>
    <p>Tente outro termo ou procure pela área funcional onde realiza a operação.</p>
</section>
@section Scripts {
<script>
(() => {
    const input = document.getElementById('helpSearch');
    const topics = [...document.querySelectorAll('[data-help-topic]')];
    const categories = [...document.querySelectorAll('[data-help-category]')];
    const empty = document.getElementById('helpNoResults');
    if (!input) return;
    input.addEventListener('input', () => {
        const term = input.value.trim().toLocaleLowerCase('pt-PT');
        let visibleCount = 0;
        topics.forEach(topic => {
            const haystack = (topic.dataset.helpSearch || '').toLocaleLowerCase('pt-PT');
            const visible = term.length === 0 || haystack.includes(term);
            topic.hidden = !visible;
            if (visible) visibleCount++;
        });
        categories.forEach(category => {
            category.hidden = !category.querySelector('[data-help-topic]:not([hidden])');
        });
        if (empty) empty.hidden = visibleCount !== 0;
    });
})();
</script>
}
@model WhatsNewViewModel
@{ ViewData["Title"] = "O que há de novo"; }
<div class="page-header"><div><p class="eyebrow">DenariusAI</p><h1>O que há de novo</h1><p class="page-subtitle">Novidades, correções e informação técnica da versão em execução.</p></div><a class="button secondary" href="@Model.RepositoryUrl" target="_blank" rel="noopener noreferrer">Consultar GitHub</a></div>
<section class="release-layout"><div class="release-list">@foreach(var release in Model.Releases){<article class="release-card"><header><div><span>Versão</span><h2>@release.Version</h2></div><time>@release.PublishedAt</time></header><ul>@foreach(var change in release.Changes){<li>@change.TrimStart('-', '*', ' ')</li>}</ul><a href="@release.Url" target="_blank" rel="noopener noreferrer">Ver no GitHub</a></article>}</div>
<aside class="runtime-card"><p class="eyebrow">Sistema</p><h2>Informação da aplicação</h2><dl><div><dt>Versão</dt><dd>v@(Model.Version)</dd></div><div><dt>Runtime</dt><dd>@Model.Framework</dd></div><div><dt>Sistema operativo</dt><dd>@Model.OperatingSystem</dd></div><div><dt>Contentorização</dt><dd>@(Model.RunningInContainer ? "Docker" : "Host local")</dd></div><div><dt>Aplicação Web</dt><dd>@Model.WebContainer</dd></div><div><dt>Base de dados</dt><dd>@Model.Database</dd></div><div><dt>Servidor MCP</dt><dd>@Model.McpContainer</dd></div></dl><hr /><p>© @DateTime.Today.Year DenariusAI · Rui Ribeiro</p><p>Software disponibilizado sob a <strong>Licença MIT</strong>.</p><a href="@Model.RepositoryUrl" target="_blank" rel="noopener noreferrer">github.com/ruialexrib/denarius-ai</a></aside></section>
<section class="support-card"><div class="support-icon" aria-hidden="true">☕</div><div><p class="eyebrow">Apoiar e contribuir</p><h2>Apoie o desenvolvimento do DenariusAI</h2><p>Se considera este projeto útil e gostaria de apoiar o desenvolvimento contínuo e a partilha de conhecimento, pode fazê-lo através do Buy Me a Coffee. O seu apoio ajuda-me a continuar a criar e partilhar projetos open source e conteúdo técnico.</p></div><a class="support-button" href="https://buymeacoffee.com/ruialexrib" target="_blank" rel="noopener noreferrer"><span aria-hidden="true">☕</span> Buy Me a Coffee</a></section>

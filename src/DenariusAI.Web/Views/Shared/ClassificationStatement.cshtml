@model ClassificationStatementViewModel
@{ ViewData["Title"] = $"Extrato · {Model.Name}"; var controller = Model.EntityType == "Grupo" ? "FinancialGroups" : "Categories"; var kindName = Model.Kind == DenariusAI.Domain.Enums.FinancialGroupKind.Asset ? "Património" : Model.Kind == DenariusAI.Domain.Enums.FinancialGroupKind.Income ? "Rendimento" : "Despesa"; }
<div class="page-header account-statement-header"><div><p class="eyebrow">Finanças · Extrato de @Model.EntityType.ToLowerInvariant()</p><h1>@Model.Name</h1><p class="page-subtitle">Acompanhe os movimentos classificados, a evolução do saldo e as contas relacionadas.</p></div><a class="button secondary" asp-controller="@controller" asp-action="Index">← Voltar a @Model.EntityType.ToLowerInvariant()s</a></div>
<section class="statement-summary classification-summary">
    <article class="statement-account-card"><span class="statement-card-icon" aria-hidden="true">@(Model.EntityType == "Grupo" ? "▱" : "◇")</span><div><span>@Model.EntityType</span><strong>@Model.Name</strong><small>Classificação financeira</small></div></article>
    <article><span>Natureza</span><strong>@kindName</strong><small>Tipo de classificação</small></article>
    <article><span>Movimentos</span><strong>@Model.Pagination.TotalItems</strong><small>No intervalo selecionado</small></article>
    <article class="statement-current-balance"><span>Saldo atual</span><strong>@Model.CurrentBalance.ToString("N2")</strong><small>Valor acumulado</small></article>
</section>
<section class="panel entity-panel account-statement-panel classification-statement-panel">
<div class="statement-filter-heading"><div><span>Movimentos classificados</span><small>Filtre por período, movimento, conta ou categoria</small></div></div>
<form id="classification-statement-filters" method="get" class="filterbar account-statement-filters"><input type="hidden" name="id" value="@Model.Id" /><label>De <input type="date" name="from" value="@(Model.From?.ToString("yyyy-MM-dd"))" /></label><label>Até <input type="date" name="to" value="@(Model.To?.ToString("yyyy-MM-dd"))" /></label><input type="search" name="search" value="@Model.Search" placeholder="Movimento, conta ou categoria..." /><label class="page-size">Por página <select name="pageSize">@foreach (var size in PaginationViewModel.AllowedPageSizes) { <option value="@size" selected="@(size == Model.Pagination.PageSize)">@size</option> }</select></label><button class="button secondary" type="submit">Aplicar filtros</button></form>
<div class="table-wrap"><table class="entity-table account-statement-table classification-statement-table"><thead><tr><th>Data</th><th>Movimento</th><th>Conta</th><th>Categoria</th><th>Débito</th><th>Crédito</th><th>Saldo</th><th class="actions">Ações</th></tr></thead><tbody>
@foreach (var item in Model.Items) {
var debitClass = Model.Kind == DenariusAI.Domain.Enums.FinancialGroupKind.Expense ? "negative" : "positive"; var creditClass = Model.Kind == DenariusAI.Domain.Enums.FinancialGroupKind.Income ? "positive" : "negative";
<tr><td class="nowrap"><span class="statement-date">@item.Date.ToString("dd/MM/yyyy")</span></td><td><strong>@item.Description</strong>@if (!string.IsNullOrWhiteSpace(item.Reference)) { <small>Ref. @item.Reference</small> }</td><td><span class="statement-account-name">@item.AccountName</span></td><td><partial name="_CategoryKindIcon" model="Model.Kind" /> @item.CategoryName</td><td class="amount @debitClass">@(item.Debit == 0 ? "—" : item.Debit.ToString("N2"))</td><td class="amount @creditClass">@(item.Credit == 0 ? "—" : item.Credit.ToString("N2"))</td><td class="amount statement-balance"><strong>@item.Balance.ToString("N2")</strong></td><td class="actions"><a class="text-link" asp-controller="JournalEntries" asp-action="Details" asp-route-id="@item.JournalEntryId">Consultar</a></td></tr>
}
@if (Model.Items.Count == 0) { <tr><td colspan="8" class="empty-row">Não foram encontrados movimentos.</td></tr> }
</tbody></table></div>
<nav class="pagination" aria-label="Paginação"><span>@Model.Pagination.FirstItem–@Model.Pagination.LastItem de @Model.Pagination.TotalItems</span><div><button class="pager-link" type="submit" form="classification-statement-filters" name="page" value="@(Model.Pagination.Page - 1)" disabled="@(!Model.Pagination.HasPreviousPage)">Anterior</button><span>Página @Model.Pagination.Page de @Model.Pagination.TotalPages</span><button class="pager-link" type="submit" form="classification-statement-filters" name="page" value="@(Model.Pagination.Page + 1)" disabled="@(!Model.Pagination.HasNextPage)">Seguinte</button></div></nav>
</section>

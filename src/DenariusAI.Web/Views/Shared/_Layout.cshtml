@using DenariusAI.Application.Abstractions.Services
@using DenariusAI.Infrastructure.Identity
@using DenariusAI.Domain.Enums
@using Microsoft.AspNetCore.Identity
@using System.Runtime.InteropServices
@inject ApplicationInfo AppInfo
@inject UserManager<ApplicationUser> UserManager
@inject ILLMService LlmService
@inject IApplicationSettingsService ApplicationSettings
@inject IAccountService AccountService
@inject IWebHostEnvironment HostEnvironment
@{ var documentController = ViewContext.RouteData.Values["controller"]?.ToString(); var isWarranties = documentController == "Warranties"; var isCorrespondence = documentController == "Correspondence"; }
@{ var controller = ViewContext.RouteData.Values["controller"]?.ToString(); var isHome = controller == "Home"; var isJournalEntries = controller == "JournalEntries"; var isReconciliation = controller == "Reconciliation"; var isBudget = controller == "Budget"; var isSavingsCertificates = controller == "SavingsCertificates"; var isStockPortfolio = controller == "StockPortfolio"; var isInsurance = controller == "Insurance"; var isAnalytics = controller == "Analytics"; var isAssistant = controller == "Assistant"; var isAccounts = controller == "Accounts"; var isGroups = controller == "FinancialGroups"; var isCategories = controller == "Categories"; var isUsers = controller == "Users"; var isSettings = controller == "Settings"; var isAudit = controller == "Audit"; var isAdministrator = User.IsInRole(ApplicationRoles.Administrator); var currentUser = await UserManager.GetUserAsync(User); var runtimeSettings = await ApplicationSettings.GetAsync(); var aiIsOllama = string.Equals(runtimeSettings.AiProvider, "Ollama", StringComparison.OrdinalIgnoreCase); var aiProviderName = aiIsOllama ? "Ollama" : "Mistral AI"; var aiModel = aiIsOllama ? runtimeSettings.OllamaModel : runtimeSettings.MistralModel; var showCloudAiPrivacyNotice = currentUser is not null && CloudAiPrivacyNoticePolicy.ShouldShow(runtimeSettings.AiProvider, Context.Session.GetString(CloudAiPrivacyNoticePolicy.SessionKey)); var userName = currentUser?.DisplayName ?? User.Identity?.Name ?? "Utilizador"; var userInitial = userName.Trim().FirstOrDefault().ToString().ToUpperInvariant(); var assetTypes = new[] { AccountType.BankAccount, AccountType.Cash, AccountType.Savings, AccountType.TermDeposit, AccountType.Investment, AccountType.OtherAsset }; var assetAccounts = currentUser?.ShowAssetBalancesWidget == true ? (await AccountService.ListAsync(true)).Where(account => assetTypes.Contains(account.AccountType)).OrderBy(account => account.Name).ToList() : []; }
<!DOCTYPE html><html lang="pt-PT"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>@ViewData["Title"] - DenariusAI</title><link rel="icon" href="~/favicon.svg" type="image/svg+xml" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/cookie-consent.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/cloud-ai-privacy-notice.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/page-headers.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/pagination.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/accounts.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/journal-entries.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/reconciliation.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/budget.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/reset-data.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/settings.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/application-settings.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/settings-controls.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/savings-certificates.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/information.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/assistant.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/audit.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/operation-progress.css" asp-append-version="true" /></head>
<body class="app-body"><div class="app-shell" inert="@(showCloudAiPrivacyNotice ? "inert" : null)"><header class="topbar"><div class="brand-area"><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">D</span><span>DenariusAI</span><small class="version-badge">v@(AppInfo.Version)</small></a><span class="brand-description">@AppInfo.Description</span></div><div class="topbar-actions"><partial name="_ReminderNotification" /><details class="user-menu"><summary class="top-with-tooltip"><span class="user-avatar @(currentUser?.ProfileImageBase64 is not null ? "has-photo" : null)" aria-hidden="true">@if(currentUser?.ProfileImageBase64 is not null && currentUser.ProfileImageContentType is not null){<img src="data:@currentUser.ProfileImageContentType;base64,@currentUser.ProfileImageBase64" alt="" />}else{@userInitial}</span><span class="user-identity"><strong>@userName</strong></span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5" /></svg><span class="top-tooltip user-tooltip" role="tooltip"><strong>@userName</strong><small>@(currentUser?.Email ?? User.Identity?.Name)</small><small>Abrir menu pessoal</small></span></summary><div class="user-dropdown"><div class="user-dropdown-heading"><span class="user-avatar @(currentUser?.ProfileImageBase64 is not null ? "has-photo" : null)">@if(currentUser?.ProfileImageBase64 is not null && currentUser.ProfileImageContentType is not null){<img src="data:@currentUser.ProfileImageContentType;base64,@currentUser.ProfileImageBase64" alt="Fotografia de @userName" />}else{@userInitial}</span><div><strong>@userName</strong></div></div><a asp-controller="Reminders" asp-action="Index"><span>⚠</span> Lembretes</a><a asp-controller="Account" asp-action="Profile" data-no-progress="true"><span>⚙</span> Preferências</a><a asp-controller="Information" asp-action="Help"><span>?</span> Ajuda</a><a asp-controller="Information" asp-action="WhatsNew"><span>✦</span> O que há de novo</a><form asp-controller="Account" asp-action="Logout" method="post"><button type="submit"><span>↪</span> Terminar sessão</button></form></div></details></div></header>
<aside class="sidebar" aria-label="Navegação principal"><nav><a class="nav-item @(isHome ? "active" : null)" asp-controller="Home" asp-action="Index"><span>⌂</span> Dashboard</a><p class="nav-heading">Movimentos</p><a class="nav-item @(isJournalEntries ? "active" : null)" asp-controller="JournalEntries" asp-action="Index"><span>↔</span> Execução</a><a class="nav-item @(isReconciliation ? "active" : null)" asp-controller="Reconciliation" asp-action="Index"><span>✓</span> Reconciliação</a><a class="nav-item @(isBudget ? "active" : null)" asp-controller="Budget" asp-action="Index"><span>▦</span> Orçamento</a><p class="nav-heading">Poupanças</p><a class="nav-item @(isSavingsCertificates ? "active" : null)" asp-controller="SavingsCertificates" asp-action="Index"><span>◆</span> Certificados de Aforro</a><a class="nav-item @(isStockPortfolio ? "active" : null)" asp-controller="StockPortfolio" asp-action="Index"><span>▲</span> Portfólio de ações</a><p class="nav-heading">Proteção</p><a class="nav-item @(isInsurance ? "active" : null)" asp-controller="Insurance" asp-action="Index"><span>⬡</span> Seguros</a><p class="nav-heading">Documentos</p><a class="nav-item @(isWarranties ? "active" : null)" asp-controller="Warranties" asp-action="Index"><span>▣</span> Garantias</a><a class="nav-item @(isCorrespondence ? "active" : null)" asp-controller="Correspondence" asp-action="Index"><span>✉</span> Correspondência</a><p class="nav-heading">Análise</p><a class="nav-item @(isAnalytics ? "active" : null)" asp-controller="Analytics" asp-action="Index"><span>⌁</span> Análise Financeira</a><p class="nav-heading">Inteligência Artificial</p><a class="nav-item @(isAssistant ? "active" : null)" asp-controller="Assistant" asp-action="Index"><span>✦</span> Assistente</a><p class="nav-heading">Tabelas</p><a class="nav-item @(isAccounts ? "active" : null)" asp-controller="Accounts" asp-action="Index"><span aria-hidden="true">$</span> Contas</a><a class="nav-item @(isGroups ? "active" : null)" asp-controller="FinancialGroups" asp-action="Index"><span aria-hidden="true"><svg class="nav-icon" viewBox="0 0 24 24"><path d="M3.5 7.5h6l2-2h9v13h-17z" /></svg></span> Grupos</a><a class="nav-item @(isCategories ? "active" : null)" asp-controller="Categories" asp-action="Index"><span aria-hidden="true">◇</span> Categorias</a>@if(isAdministrator){<p class="nav-heading">Administração</p><a class="nav-item @(isUsers ? "active" : null)" asp-controller="Users" asp-action="Index"><span>♙</span> Utilizadores</a><a class="nav-item @(isAudit ? "active" : null)" asp-controller="Audit" asp-action="Index"><span>◷</span> Auditoria</a><a class="nav-item @(isSettings ? "active" : null)" asp-controller="Settings" asp-action="Index"><span>⚙</span> Definições</a>}</nav></aside>
<main class="content">@RenderBody()</main>
<footer class="contextbar">
<span class="context-item context-copyright context-with-tooltip" tabindex="0"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M15 9.5a4 4 0 1 0 0 5"/></svg> @DateTime.Today.Year DenariusAI · <a href="https://github.com/ruialexrib" target="_blank" rel="noopener noreferrer">Rui Ribeiro</a> · Licença MIT<span class="context-tooltip context-tooltip-left" role="tooltip"><strong>Sobre o projeto</strong><span><small>Aplicação</small><b>DenariusAI</b></span><span><small>Autor</small><b>Rui Ribeiro</b></span><span><small>Licença</small><b>MIT · Open source</b></span><span><small>Repositório</small><b>ruialexrib/denarius-ai</b></span></span></span>
<span class="context-item context-with-tooltip" tabindex="0"><svg viewBox="0 0 24 24" aria-hidden="true"><ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v7c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 12v7c0 1.7 3.6 3 8 3s8-1.3 8-3v-7"/></svg> Base de dados: Online<span class="context-tooltip" role="tooltip"><strong>Base de dados</strong><span><small>Estado</small><b class="tooltip-online">● Online</b></span><span><small>Motor</small><b>SQL Server 2022</b></span><span><small>Base</small><b>DenariusAI</b></span><span><small>Persistência</small><b>Volume Docker</b></span></span></span>
<span class="context-item context-with-tooltip" tabindex="0"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 1.5 5.5L19 10l-5.5 1.5L12 17l-1.5-5.5L5 10l5.5-1.5zM19 16l.7 2.3L22 19l-2.3.7L19 22l-.7-2.3L16 19l2.3-.7z"/></svg> IA: @(LlmService.IsConfigured ? aiModel : "Não configurada")<span class="context-tooltip" role="tooltip"><strong>Modelo de inteligência artificial</strong><span><small>Fornecedor</small><b>@aiProviderName</b></span><span><small>Estado</small><b class="@(LlmService.IsConfigured ? "tooltip-online" : "tooltip-offline")">@(LlmService.IsConfigured ? "● Configurado" : "● Não configurado")</b></span><span><small>Modelo</small><b>@aiModel</b></span><span><small>Limite</small><b>@runtimeSettings.MistralMaxTokens tokens</b></span><span><small>Temperatura</small><b>@runtimeSettings.MistralTemperature.ToString("0.0")</b></span></span></span>
<span class="context-item context-with-tooltip" tabindex="0"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 13 13 20l-9-9V4h7z"/><circle cx="8.5" cy="8.5" r="1"/></svg> v@(AppInfo.Version)<span class="context-tooltip context-tooltip-right" role="tooltip"><strong>Versão da aplicação</strong><span><small>DenariusAI</small><b>v@(AppInfo.Version)</b></span><span><small>Ambiente</small><b>@HostEnvironment.EnvironmentName</b></span><span><small>Runtime</small><b>@RuntimeInformation.FrameworkDescription</b></span><span><small>Execução</small><b>@(Environment.GetEnvironmentVariable("DOTNET_RUNNING_IN_CONTAINER") == "true" ? "Docker" : "Host local")</b></span></span></span>
</footer></div>
@if (currentUser?.ShowAssetBalancesWidget == true)
{
    <aside class="asset-balances-widget" role="complementary" aria-label="Resumo patrimonial">
        <header><span class="asset-balances-icon" aria-hidden="true">€</span><div><small>Saldo disponível</small><strong>Resumo patrimonial</strong></div><button class="asset-widget-toggle" type="button" data-asset-widget-toggle aria-expanded="true" title="Minimizar resumo patrimonial" aria-label="Minimizar resumo patrimonial"><span aria-hidden="true">−</span></button><form asp-controller="Account" asp-action="SetAssetBalancesWidget" method="post"><input type="hidden" name="enabled" value="false" /><input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" /><button type="submit" title="Ocultar resumo patrimonial" aria-label="Ocultar resumo patrimonial">×</button></form></header>
        <div class="asset-balances-list">
            @foreach (var account in assetAccounts)
            {
                <div><span><i aria-hidden="true"></i>@account.Name</span><strong>@account.Balance.ToString("N2") <small>@account.Currency</small></strong></div>
            }
            @if (assetAccounts.Count == 0) { <p>Não existem contas patrimoniais ativas.</p> }
        </div>
        @if (assetAccounts.Count > 0)
        {
            <footer>@foreach (var total in assetAccounts.GroupBy(account => account.Currency).OrderBy(group => group.Key)) { <span><small>Total @total.Key</small><strong>@total.Sum(account => account.Balance).ToString("N2") @total.Key</strong></span> }</footer>
        }
    </aside>
    <script src="~/js/asset-balances-widget.js" asp-append-version="true"></script>
}
@if (TempData["SuccessMessage"] is string toastSuccess) { <aside class="app-toast success" data-app-toast role="status" aria-live="polite"><span class="toast-icon">✓</span><div><strong>Operação concluída</strong><p>@toastSuccess</p></div><button type="button" data-toast-close aria-label="Fechar">×</button></aside> }@if (TempData["ErrorMessage"] is string toastError) { <aside class="app-toast error" data-app-toast role="alert" aria-live="assertive"><span class="toast-icon">!</span><div><strong>Não foi possível concluir</strong><p>@toastError</p></div><button type="button" data-toast-close aria-label="Fechar">×</button></aside> }
@if(showCloudAiPrivacyNotice){<div class="cloud-ai-notice-backdrop"><section class="cloud-ai-notice" role="dialog" aria-modal="true" aria-labelledby="cloud-ai-notice-title" aria-describedby="cloud-ai-notice-description"><span class="cloud-ai-notice-icon" aria-hidden="true">!</span><div><p class="eyebrow">Privacidade e inteligência artificial</p><h2 id="cloud-ai-notice-title">A IA está configurada na cloud</h2><p id="cloud-ai-notice-description">O fornecedor <strong>@aiProviderName</strong> processa os pedidos de inteligência artificial fora deste dispositivo. Evite incluir dados pessoais, confidenciais ou financeiros que não sejam necessários e confirme sempre a informação antes de continuar.</p><form asp-controller="Account" asp-action="AcknowledgeCloudAiPrivacyNotice" method="post"><input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" /><button class="button" type="submit" autofocus>Tomei conhecimento</button></form></div></section></div>}
@if(currentUser?.CookieConsentAcceptedAt is null){<aside class="cookie-consent" role="dialog" aria-live="polite" aria-label="Consentimento de cookies"><div><strong>Cookies no DenariusAI</strong><p>Utilizamos cookies essenciais para manter a sessão segura e guardar as suas preferências. Ao continuar, concorda com a utilização destes cookies.</p></div><div class="cookie-consent-actions"><a asp-controller="Account" asp-action="Profile" data-no-progress="true">Preferências</a><form asp-controller="Account" asp-action="AcceptCookieConsent" method="post" data-no-progress="true"><input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" /><button class="button" type="submit">Concordo</button></form></div></aside>}<div id="operation-progress" class="operation-progress" hidden role="status" aria-live="polite"><div class="operation-progress-card"><span class="operation-spinner" aria-hidden="true"></span><div class="operation-progress-copy"><small>A processar</small><strong data-progress-text>A executar a operação…</strong><p>Esta operação pode demorar alguns instantes.</p></div></div></div>@await RenderSectionAsync("Scripts", required: false)<script src="~/js/operation-progress.js" asp-append-version="true"></script><script src="~/js/toast.js" asp-append-version="true"></script></body></html>
